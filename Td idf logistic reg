import pandas as pd
import numpy as np

from sklearn.model_selection import train_test_split
from sklearn.pipeline import Pipeline
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.multiclass import OneVsRestClassifier
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import classification_report


# -----------------------------
# 1. Load labeled training file
# -----------------------------

file_path = "meter_comment_training_data.xlsx"

df = pd.read_excel(file_path)

comment_col = "clean_comment"

label_cols = [
    "METER_CHANGE",
    "NCM",
    "ACCESS_ISSUE",
    "TAMPERING",
    "PROGRAMMING"
]

df = df.dropna(subset=[comment_col])

X = df[comment_col].astype(str)
y = df[label_cols].fillna(0).astype(int)


# -----------------------------
# 2. Split into train/test
# -----------------------------

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42
)


# -----------------------------
# 3. Build and train model
# -----------------------------

model = Pipeline([
    ("tfidf", TfidfVectorizer(
        ngram_range=(1, 3),
        min_df=2,
        max_df=0.90
    )),
    ("clf", OneVsRestClassifier(
        LogisticRegression(
            max_iter=1000,
            class_weight="balanced"
        )
    ))
])

model.fit(X_train, y_train)


# -----------------------------
# 4. Predict on test set
# -----------------------------

threshold = 0.50

y_prob = model.predict_proba(X_test)
y_pred = (y_prob >= threshold).astype(int)


# -----------------------------
# 5. Evaluate model
# -----------------------------

print(classification_report(
    y_test,
    y_pred,
    target_names=label_cols,
    zero_division=0
))

# -----------------------------
# 6. Save predictions for review
# -----------------------------

results = pd.DataFrame({
    "clean_comment": X_test.values
})

for i, col in enumerate(label_cols):
    results[f"actual_{col}"] = y_test[col].values
    results[f"pred_{col}"] = y_pred[:, i]
    results[f"score_{col}"] = y_prob[:, i].round(3)

def predicted_categories(row):
    cats = []
    for col in label_cols:
        if row[f"pred_{col}"] == 1:
            cats.append(f"{col}({row[f'score_{col}']})")
    return "|".join(cats) if cats else "OTHER"

results["predicted_categories"] = results.apply(predicted_categories, axis=1)

results.to_excel("model_test_results.xlsx", index=False)




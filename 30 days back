import pandas as pd
import pyarrow as pa
import pyarrow.parquet as pq
from datetime import datetime, timedelta

PARQUET_DIR = "work_orders_partitioned/"

# 1. Pull last 30 days from SQL
df_new = pd.read_sql(query, conn)
df_new["created_date"] = pd.to_datetime(df_new["created_date"])
df_new["year"]  = df_new["created_date"].dt.year
df_new["month"] = df_new["created_date"].dt.month

# 2. Write ONLY the affected partitions (overwrites just those month folders)
table = pa.Table.from_pandas(df_new)
pq.write_to_dataset(
    table,
    root_path=PARQUET_DIR,
    partition_cols=["year", "month"],
    existing_data_behavior="delete_matching"  # key: only replaces matching partitions
)

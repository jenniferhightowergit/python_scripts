<?xml version='1.0'?>
<workbook>
  <preferences>

    <!-- General categorical: navy, gold, khaki, blues, gray -->
    <color-palette name="Navy Gold" type="regular">
      <color>#1F3864</color>
      <color>#FFC000</color>
      <color>#B5A46E</color>
      <color>#4472C4</color>
      <color>#8FAADC</color>
      <color>#A5A5A5</color>
      <color>#2F5597</color>
      <color>#DAE3F3</color>
    </color-palette>

    <!-- Behavior buckets, in alphabetical order so "Assign Palette" lines up:
         Focused, Fragmented, Mixed, Revisiting, Sequential, Too few orders -->
    <color-palette name="Behavior Buckets" type="regular">
      <color>#1F3864</color>
      <color>#FFC000</color>
      <color>#A5A5A5</color>
      <color>#C55A11</color>
      <color>#4472C4</color>
      <color>#D9D9D9</color>
    </color-palette>

    <!-- Density bands, alphabetical: Highly dense, Moderately dense, Not dense -->
    <color-palette name="Density Bands" type="regular">
      <color>#1F3864</color>
      <color>#8FAADC</color>
      <color>#DAE3F3</color>
    </color-palette>

    <!-- Continuous measures: pale blue to navy -->
    <color-palette name="Navy Sequential" type="ordered-sequential">
      <color>#DAE3F3</color>
      <color>#8FAADC</color>
      <color>#4472C4</color>
      <color>#2F5597</color>
      <color>#1F3864</color>
    </color-palette>

    <!-- Above/below target: gold to navy -->
    <color-palette name="Gold Navy Diverging" type="ordered-diverging">
      <color>#BF9000</color>
      <color>#FFC000</color>
      <color>#F2F2F2</color>
      <color>#4472C4</color>
      <color>#1F3864</color>
    </color-palette>

  </preferences>
</workbook>

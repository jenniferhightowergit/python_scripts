CREATE OR REPLACE TABLE estimating_base AS
SELECT
    MR_MDVC_NUMBER,
    file_date,
    estimated_days,

    LAG(file_date) OVER (
        PARTITION BY MR_MDVC_NUMBER
        ORDER BY file_date
    ) AS prev_file_date,

    LAG(estimated_days) OVER (
        PARTITION BY MR_MDVC_NUMBER
        ORDER BY file_date
    ) AS prev_estimated_days

FROM data_final
WHERE estimating = 1;


CREATE OR REPLACE TABLE estimating_events AS
SELECT
    MR_MDVC_NUMBER,
    file_date AS event_date,
    estimated_days,
    threshold_hit
FROM estimating_base
CROSS JOIN (
    VALUES
        (1),
        (5),
        (10),
        (15),
        (30),
        (60),
        (90)
) AS t(threshold_hit)
WHERE estimated_days >= threshold_hit
  AND COALESCE(prev_estimated_days, 0) < threshold_hit;





CREATE OR REPLACE TABLE estimating_events_with_gap AS
SELECT
    *,
    LAG(event_date) OVER (
        PARTITION BY MR_MDVC_NUMBER, threshold_hit
        ORDER BY event_date
    ) AS previous_event_date,

    DATE_DIFF(
        'day',
        LAG(event_date) OVER (
            PARTITION BY MR_MDVC_NUMBER, threshold_hit
            ORDER BY event_date
        ),
        event_date
    ) AS days_between_events

FROM estimating_events;



CREATE OR REPLACE TABLE estimating_features AS
SELECT
    a.MR_MDVC_NUMBER,
    a.anchor_date,

    COUNT(*) FILTER (
        WHERE e.threshold_hit = 1
          AND e.event_date BETWEEN a.anchor_date - INTERVAL 30 DAY AND a.anchor_date
    ) AS hit_1_count_30d,

    COUNT(*) FILTER (
        WHERE e.threshold_hit = 1
          AND e.event_date BETWEEN a.anchor_date - INTERVAL 60 DAY AND a.anchor_date
    ) AS hit_1_count_60d,

    COUNT(*) FILTER (
        WHERE e.threshold_hit = 1
          AND e.event_date BETWEEN a.anchor_date - INTERVAL 90 DAY AND a.anchor_date
    ) AS hit_1_count_90d,

    COUNT(*) FILTER (
        WHERE e.threshold_hit = 5
          AND e.event_date BETWEEN a.anchor_date - INTERVAL 30 DAY AND a.anchor_date
    ) AS hit_5_count_30d,

    COUNT(*) FILTER (
        WHERE e.threshold_hit = 5
          AND e.event_date BETWEEN a.anchor_date - INTERVAL 60 DAY AND a.anchor_date
    ) AS hit_5_count_60d,

    COUNT(*) FILTER (
        WHERE e.threshold_hit = 5
          AND e.event_date BETWEEN a.anchor_date - INTERVAL 90 DAY AND a.anchor_date
    ) AS hit_5_count_90d,

    AVG(days_between_events) FILTER (
        WHERE e.threshold_hit = 5
          AND e.event_date BETWEEN a.anchor_date - INTERVAL 90 DAY AND a.anchor_date
    ) AS avg_days_between_hit_5_90d

FROM anchor_table a
LEFT JOIN estimating_events_with_gap e
    ON a.MR_MDVC_NUMBER = e.MR_MDVC_NUMBER
   AND e.event_date BETWEEN a.anchor_date - INTERVAL 90 DAY AND a.anchor_date

GROUP BY
    a.MR_MDVC_NUMBER,
    a.anchor_date;







from pathlib import Path
from datetime import datetime, timedelta
import pandas as pd

# --------------------------------------------------
# Paths
# --------------------------------------------------
source_folder = Path(r"\\your\shared\drive\folder")
parquet_path = Path(r"\\your\shared\drive\non_com.parquet")

# --------------------------------------------------
# Load existing parquet
# --------------------------------------------------
if parquet_path.exists():
    existing_df = pd.read_parquet(parquet_path)
else:
    existing_df = pd.DataFrame()

# --------------------------------------------------
# Make comparison columns datetime
# --------------------------------------------------
if not existing_df.empty:

    existing_df["file_date"] = pd.to_datetime(
        existing_df["file_date"],
        errors="coerce"
    )

    existing_df["modified_datetime"] = pd.to_datetime(
        existing_df["modified_datetime"],
        errors="coerce"
    )

# --------------------------------------------------
# Build set of existing keys
# Faster than dataframe filtering repeatedly
# --------------------------------------------------
existing_keys = set()

if not existing_df.empty:

    existing_keys = set(
        zip(
            existing_df["file_date"],
            existing_df["modified_datetime"]
        )
    )

# --------------------------------------------------
# Only check files modified in last 7 days
# --------------------------------------------------
cutoff = datetime.now() - timedelta(days=7)

files = [
    f for f in source_folder.glob("*.xlsx")
    if datetime.fromtimestamp(f.stat().st_mtime) >= cutoff
]

# --------------------------------------------------
# Function to get file_date
# Assumes YYYYMMDD at end of filename
# --------------------------------------------------
def get_file_date(file):

    date_text = file.stem[-8:]

    return pd.to_datetime(
        date_text,
        format="%Y%m%d",
        errors="coerce"
    )

# --------------------------------------------------
# Process files
# --------------------------------------------------
new_dfs = []

for file in files:

    source_file = file.name

    file_date = get_file_date(file)

    modified_datetime = pd.to_datetime(
        datetime.fromtimestamp(file.stat().st_mtime)
    )

    # Skip invalid file dates
    if pd.isna(file_date):

        print(f"Skipping invalid file date: {source_file}")
        continue

    # Build comparison key
    current_key = (file_date, modified_datetime)

    # Skip if already exists
    if current_key in existing_keys:

        print(f"Already loaded: {source_file}")
        continue

    print(f"Loading new file: {source_file}")

    df = pd.read_excel(file, engine="openpyxl")

    df["source_file"] = source_file
    df["file_date"] = file_date
    df["modified_datetime"] = modified_datetime

    new_dfs.append(df)

# --------------------------------------------------
# Append new data
# --------------------------------------------------
if new_dfs:

    new_data = pd.concat(new_dfs, ignore_index=True)

    final_df = pd.concat(
        [existing_df, new_data],
        ignore_index=True
    )

    final_df.to_parquet(
        parquet_path,
        engine="pyarrow",
        index=False
    )

    print(f"Added {len(new_data):,} rows.")

else:

    print("No new files found.")

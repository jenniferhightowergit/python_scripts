    return comment




def _normalize_text(text, normalizer):
    """Swap variants for canonical terms before spaCy sees the text."""
    text_lower = text.lower()
    for variant, canonical in normalizer.items():
        text_lower = text_lower.replace(variant, canonical)
    return text_lower





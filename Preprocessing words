def build_flat_normalization(replacement_dict):
    flat = {}

    for good_word, bad_words in replacement_dict.items():
        good_clean = good_word.lower().strip()
        protected_good = good_clean.replace(" ", "_")

        # include the good phrase itself
        flat[good_clean] = protected_good

        # include bad variants
        for bad_word in bad_words:
            bad_clean = bad_word.lower().strip()
            flat[bad_clean] = protected_good

    return flat



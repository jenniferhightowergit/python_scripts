import pandas as pd, matplotlib.pyplot as plt, matplotlib.dates as mdates

TECH, DAY = "U36O", "2026-04-21"

d = full_s4e_pop_mapping
d = d[(d.workedby == TECH) &
      (d.wr_workeddatetime.dt.date == pd.Timestamp(DAY).date())]
d = d.sort_values("wr_workeddatetime")

gap = d.wr_workeddatetime.diff().dt.total_seconds() / 60
d = d.assign(stint=(gap > 20).cumsum())          # 20-min gap = new stint

fig, ax = plt.subplots(figsize=(12, 4))
for s, g in d.groupby("stint"):
    start, end = g.wr_workeddatetime.min(), g.wr_workeddatetime.max()
    width = max((end - start).total_seconds() / 86400, 2/1440)
    ax.barh(s, width, left=mdates.date2num(start), height=0.6)
    ax.scatter(g.wr_workeddatetime, [s]*len(g), color="black", s=12, zorder=3)
    ax.text(mdates.date2num(start) + width/2, s, f"{len(g)}",
            ha="center", va="center", color="white", fontweight="bold")

ax.xaxis.set_major_formatter(mdates.DateFormatter("%-I:%M %p"))
ax.set_ylabel("Stint"); ax.set_title(f"{TECH} — {DAY}")
plt.tight_layout(); plt.show()

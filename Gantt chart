"""
Builds meter_events / meter_visits / visit_metrics from full_s4e_pop_mapping.

This is the flat population frame -- no cluster_id, no target_/nearby_ pairs --
so the clustering step has to happen here before any visit logic can run.
Once this cell finishes, workday_gantt.py works unchanged.

Order: filter to real work events -> cluster per tech-week -> derive visits.
"""

import duckdb
import numpy as np
import pandas as pd
from sklearn.cluster import DBSCAN

# conn = duckdb.connect()   # if you don't already have one in this notebook

EPS_MILES = 0.25
EARTH_MI = 3959.0
MIN_SAMPLES = 2

EXCLUDE_PT_TESTS = False   # flip to True to drop pt_flag = 1 rows


# ---------------------------------------------------------------------------
# 1. Real work events only
#
#    full_s4e_pop_mapping is the whole meter population. Rows with
#    removal_date 3001-01-01 are meters still in the field -- they carry NaT
#    for wr_workeddatetime and None for workedby, so they aren't work events
#    and would poison every metric downstream.
# ---------------------------------------------------------------------------
conn.register("full_s4e_pop_mapping", full_s4e_pop_mapping)

pt_filter = "and coalesce(pt_flag, 0) = 0" if EXCLUDE_PT_TESTS else ""

work_events = conn.execute(f"""
    select distinct
        workedby,
        cast(hist_meter_removal_date as date)                     as work_date,
        date_trunc('week', cast(hist_meter_removal_date as date)) as work_week,
        hist_meter                                                as meterno,
        wr_workeddatetime                                         as worked_datetime,
        hist_latitude                                             as latitude,
        hist_longitude                                            as longitude
    from full_s4e_pop_mapping
    where workedby          is not null
      and wr_workeddatetime is not null
      and hist_latitude     is not null
      and hist_longitude    is not null
      and cast(hist_meter_removal_date as date) < date '2900-01-01'
      {pt_filter}
""").df()

print(f"{len(work_events):,} work events "
      f"across {work_events['workedby'].nunique():,} techs")


# ---------------------------------------------------------------------------
# 2. Cluster per (tech, week)
# ---------------------------------------------------------------------------
labelled = []

for (tech, week), g in work_events.groupby(["workedby", "work_week"]):

    coords = np.radians(g[["latitude", "longitude"]].to_numpy())

    db = DBSCAN(
        eps=EPS_MILES / EARTH_MI,
        min_samples=MIN_SAMPLES,
        metric="haversine",
    ).fit(coords)

    g = g.copy()
    week_key = pd.Timestamp(week).strftime("%Y%m%d")

    g["cluster_id"] = [
        f"{tech}_{week_key}_{lbl}"
        if lbl >= 0
        else f"{tech}_{week_key}_solo_{meter}"
        for lbl, meter in zip(db.labels_, g["meterno"])
    ]
    g["is_solo"] = db.labels_ < 0

    labelled.append(g)

meter_events_df = pd.concat(labelled, ignore_index=True)
conn.register("meter_events_df", meter_events_df)

print(f"{meter_events_df['cluster_id'].nunique():,} clusters, "
      f"{100 * meter_events_df['is_solo'].mean():.1f}% solo points")


# ---------------------------------------------------------------------------
# 3. Visit logic
# ---------------------------------------------------------------------------
conn.execute("""
create or replace macro miles_between(lat1, lon1, lat2, lon2) as
    round(3959 * 2 * asin(sqrt(
        power(sin(radians(lat2 - lat1) / 2), 2)
        + cos(radians(lat1)) * cos(radians(lat2))
          * power(sin(radians(lon2 - lon1) / 2), 2)
    )), 2);
""")

conn.execute("""
create or replace macro minutes_between(t1, t2) as
    datediff('second', t1, t2) / 60.0;
""")

conn.execute("""
create or replace table meter_events as
select * from meter_events_df;
""")

conn.execute("""
create or replace view meter_visits as
with seq as (
    select
        *,
        lag(cluster_id)      over w as previous_cluster_id,
        lag(worked_datetime) over w as previous_worked_datetime
    from meter_events
    window w as (partition by workedby, work_date order by worked_datetime)
),
flagged as (
    select
        *,
        case
            when previous_cluster_id is null       then 1
            when cluster_id <> previous_cluster_id then 1
            else 0
        end as is_cluster_switch
    from seq
)
select
    *,
    sum(is_cluster_switch) over (
        partition by workedby, work_date
        order by worked_datetime
        rows between unbounded preceding and current row
    ) as visit_num
from flagged;
""")

conn.execute("""
create or replace view visit_metrics as
with visit_base as (
    select
        workedby,
        work_date,
        work_week,
        visit_num,
        cluster_id,

        min(worked_datetime) as visit_start_time,
        max(worked_datetime) as visit_end_time,

        arg_min(latitude,  worked_datetime) as start_lat,
        arg_min(longitude, worked_datetime) as start_lon,
        arg_max(latitude,  worked_datetime) as end_lat,
        arg_max(longitude, worked_datetime) as end_lon,

        count(distinct meterno) as meters_worked,
        count(*)                as meter_changes,

        minutes_between(min(worked_datetime), max(worked_datetime))
            as visit_minutes,

        avg(minutes_between(previous_worked_datetime, worked_datetime))
            filter (where is_cluster_switch = 0) as avg_minutes_between_meters,
        median(minutes_between(previous_worked_datetime, worked_datetime))
            filter (where is_cluster_switch = 0) as median_minutes_between_meters

    from meter_visits
    group by workedby, work_date, work_week, visit_num, cluster_id
)
select
    *,
    minutes_between(lag(visit_end_time) over w, visit_start_time)
        as travel_minutes_from_previous,
    miles_between(
        lag(end_lat) over w, lag(end_lon) over w, start_lat, start_lon
    ) as travel_miles_from_previous
from visit_base
window w as (partition by workedby, work_date order by visit_start_time);
""")


# ---------------------------------------------------------------------------
# 4. Confirm, and find a day worth charting
# ---------------------------------------------------------------------------
print(conn.execute("""
    select
        workedby,
        work_date,
        count(*)                   as visits,
        count(distinct cluster_id) as clusters,
        sum(meters_worked)         as meters
    from visit_metrics
    group by workedby, work_date
    having count(*) >= 4
    order by visits desc, meters desc
    limit 15
""").df())







"""
Gantt chart of one meter tech's workday.

Each bar is a visit -- a contiguous stint in one cluster. Rows are clusters,
so if a tech leaves a cluster and comes back, you get two bars on the same
row with a gap between them. That's the backtracking, visible.

Gaps between bars are travel. Dots on the bars are individual meter changes.

Requires: visit_metrics and meter_events from meter_tech_weekly.sql
"""

import matplotlib.pyplot as plt
import matplotlib.dates as mdates
from matplotlib.patches import Patch

# ---------------------------------------------------------------------------
# Pick your subject
# ---------------------------------------------------------------------------
TECH = "U36O"
DAY = "2026-04-21"

MIN_BAR_MINUTES = 2.0   # single-meter visits have zero duration; without a
                        # floor they render as invisible hairlines


def busiest_days(conn, limit=15):
    """Run this first to find a day worth looking at."""
    return conn.execute("""
        select
            workedby,
            work_date,
            count(*)                   as visits,
            count(distinct cluster_id) as clusters,
            sum(meters_worked)         as meters
        from visit_metrics
        group by workedby, work_date
        having count(*) >= 4
        order by visits desc, meters desc
        limit ?
    """, [limit]).df()


def plot_workday(conn, tech, day, min_bar_minutes=MIN_BAR_MINUTES):

    visits = conn.execute("""
        select
            cluster_id,
            visit_num,
            visit_start_time,
            visit_end_time,
            visit_minutes,
            meters_worked,
            travel_miles_from_previous,
            travel_minutes_from_previous
        from visit_metrics
        where workedby = ?
          and work_date = cast(? as date)
        order by visit_start_time
    """, [tech, day]).df()

    if visits.empty:
        print(f"No visits for {tech} on {day}")
        return None

    events = conn.execute("""
        select cluster_id, worked_datetime
        from meter_events
        where workedby = ?
          and work_date = cast(? as date)
        order by worked_datetime
    """, [tech, day]).df()

    # rows ordered by first appearance, so the chart reads top-to-bottom
    # in the order the tech encountered the clusters
    order = visits.drop_duplicates("cluster_id")["cluster_id"].tolist()
    row_of = {cid: i for i, cid in enumerate(order)}

    colors = plt.cm.tab20.colors
    color_of = {cid: colors[i % len(colors)] for i, cid in enumerate(order)}

    fig, ax = plt.subplots(figsize=(13, 1.1 * len(order) + 2.5))

    for _, v in visits.iterrows():
        start = mdates.date2num(v["visit_start_time"])
        minutes = max(float(v["visit_minutes"] or 0), min_bar_minutes)
        width = minutes / (24 * 60)
        row = row_of[v["cluster_id"]]

        ax.barh(
            row, width, left=start, height=0.55,
            color=color_of[v["cluster_id"]],
            edgecolor="black", linewidth=0.6, zorder=3,
        )

        ax.text(
            start + width / 2, row,
            f"{int(v['meters_worked'])}m",
            ha="center", va="center",
            fontsize=8, fontweight="bold",
            color="white", zorder=5,
        )

    # travel connectors between consecutive visits
    for i in range(1, len(visits)):
        prev = visits.iloc[i - 1]
        cur = visits.iloc[i]

        x0 = mdates.date2num(prev["visit_end_time"])
        x1 = mdates.date2num(cur["visit_start_time"])
        y0 = row_of[prev["cluster_id"]]
        y1 = row_of[cur["cluster_id"]]

        ax.annotate(
            "", xy=(x1, y1), xytext=(x0, y0),
            arrowprops=dict(
                arrowstyle="->", color="grey",
                linestyle="--", linewidth=1.1,
                connectionstyle="arc3,rad=0.12",
            ),
            zorder=2,
        )

        miles = cur["travel_miles_from_previous"]
        mins = cur["travel_minutes_from_previous"]
        if miles is not None and mins is not None:
            ax.text(
                (x0 + x1) / 2, (y0 + y1) / 2 - 0.32,
                f"{miles:.1f} mi / {mins:.0f} min",
                ha="center", fontsize=7.5, color="dimgrey", zorder=4,
            )

    # individual meter changes
    for _, e in events.iterrows():
        ax.scatter(
            mdates.date2num(e["worked_datetime"]),
            row_of.get(e["cluster_id"], 0),
            s=9, color="black", zorder=6,
        )

    ax.set_yticks(range(len(order)))
    # cluster ids are long; the trailing segment is the distinguishing part
    ax.set_yticklabels([c.split("_")[-1] for c in order], fontsize=9)
    ax.set_ylabel("Cluster")
    ax.invert_yaxis()

    ax.xaxis.set_major_formatter(mdates.DateFormatter("%-I:%M %p"))
    ax.xaxis.set_major_locator(mdates.HourLocator(interval=1))
    plt.setp(ax.get_xticklabels(), rotation=45, ha="right")

    total_meters = int(visits["meters_worked"].sum())
    total_miles = visits["travel_miles_from_previous"].sum()
    revisits = len(visits) - visits["cluster_id"].nunique()

    ax.set_title(
        f"{tech} — {day}\n"
        f"{len(visits)} visits across {visits['cluster_id'].nunique()} clusters"
        f"  ·  {total_meters} meters  ·  {total_miles:.1f} mi"
        f"  ·  {revisits} revisit(s)",
        fontsize=11, loc="left",
    )

    ax.grid(axis="x", alpha=0.3, zorder=0)
    ax.set_axisbelow(True)

    ax.legend(
        handles=[
            Patch(facecolor="grey", label="Time in cluster"),
            plt.Line2D([], [], color="grey", linestyle="--", label="Travel"),
            plt.Line2D([], [], color="black", marker="o", linestyle="",
                       markersize=4, label="Meter change"),
        ],
        loc="upper right", fontsize=8, framealpha=0.9,
    )

    plt.tight_layout()
    return fig


if __name__ == "__main__":
    print(busiest_days(conn))
    fig = plot_workday(conn, TECH, DAY)
    if fig:
        plt.show()

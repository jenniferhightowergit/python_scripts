from scipy.spatial import cKDTree
import numpy as np

# Build a tree from weather points
weather_coords = weather_df[['lat', 'long']].values
tree = cKDTree(weather_coords)

# Query: for each meter point, find the nearest weather point
meter_coords = meter_df[['lat', 'long']].values
distances, indices = tree.query(meter_coords, k=1)

# Join
meter_df['weather_idx'] = indices
meter_df['distance'] = distances
result = meter_df.join(weather_df, on='weather_idx', rsuffix='_weather')





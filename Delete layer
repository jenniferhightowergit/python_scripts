import time
import keyring
import pandas as pd
from sqlalchemy import create_engine, text

BATCH_SIZE = 10_000

conn_string = keyring.get_password('edw_sqlalchemy', 'connection_string')
edw_alchemy_engine = create_engine(conn_string)

# Simple, no-frills batch selection query.
# No CTE nesting, no ROWNUM subquery — just OFFSET/FETCH.
batch_query = text("""
    SELECT meterno
    FROM CENTRALSERVICES.MV_EDE_EXTRACT
    WHERE HARDWARE_MODEL NOT IN ('NORESOURCEKEY')
    ORDER BY meterno
    OFFSET :offset ROWS FETCH NEXT :batch_size ROWS ONLY
""")

offset = 0
batch_number = 0
all_batches = []

with edw_alchemy_engine.connect() as conn:
    while True:
        batch_number += 1
        df = pd.read_sql_query(
            batch_query,
            conn,
            params={"offset": offset, "batch_size": BATCH_SIZE}
        )

        if df.empty:
            print(f"\nDone. No more rows at offset {offset:,}.")
            break

        print(f"Batch {batch_number}: got {len(df):,} rows (offset {offset:,})")
        all_batches.append(df)
        offset += BATCH_SIZE

meter_list = pd.concat(all_batches, ignore_index=True)
print(f"\nTotal meters collected: {len(meter_list):,}")
meter_list.head()

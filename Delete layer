"""Reusable HTML email -> printable PDF utility for Jupyter and standalone Python.

Requires: playwright, Pillow, reportlab, Microsoft Edge (msedge channel).
The public create_report_pdf() always launches a separate Python process to avoid
Playwright's synchronous API conflicting with Jupyter's asyncio event loop.
"""

from __future__ import annotations

import argparse
import base64
import json
import math
import re
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Mapping


def create_report_pdf(
    html: str,
    images: Mapping[str, str | Path] | None = None,
    output: str | Path = "report.pdf",
    page_size: str = "letter",
    orientation: str = "portrait",
    multipage: bool = False,
    keep_debug: bool = False,
) -> str:
    """Convert a complete Outlook-style HTML report to a PDF.

    images maps CID names (without 'cid:') to local PNG/JPEG image paths.
    Returns an absolute PDF path. Runs rendering in a separate process.
    """
    if not isinstance(html, str) or not html.strip():
        raise ValueError("html must be a nonempty string")
    if page_size.lower() not in {"letter", "a4", "legal"}:
        raise ValueError("page_size must be 'letter', 'a4', or 'legal'")
    if orientation.lower() not in {"portrait", "landscape"}:
        raise ValueError("orientation must be 'portrait' or 'landscape'")

    output_path = Path(output).expanduser().resolve()
    output_path.parent.mkdir(parents=True, exist_ok=True)
    image_paths = {}
    for cid, path in (images or {}).items():
        clean_cid = str(cid).removeprefix("cid:")
        resolved = Path(path).expanduser().resolve()
        if not resolved.is_file():
            raise FileNotFoundError(f"Missing image for CID {clean_cid!r}: {resolved}")
        image_paths[clean_cid] = str(resolved)

    with tempfile.TemporaryDirectory(prefix="report_pdf_") as temp:
        work = Path(temp)
        html_path = work / "source.html"
        config_path = work / "config.json"
        html_path.write_text(html, encoding="utf-8")
        config_path.write_text(json.dumps({
            "html_path": str(html_path),
            "output": str(output_path),
            "images": image_paths,
            "page_size": page_size.lower(),
            "orientation": orientation.lower(),
            "multipage": bool(multipage),
            "debug_dir": str(output_path.parent) if keep_debug else None,
        }), encoding="utf-8")

        proc = subprocess.run(
            [sys.executable, str(Path(__file__).resolve()), "--worker", str(config_path)],
            capture_output=True, text=True, check=False,
        )
        if proc.returncode:
            raise RuntimeError(
                "PDF generation failed.\n" + (proc.stderr or proc.stdout or "No error details returned.")
            )
        if not output_path.is_file() or output_path.stat().st_size == 0:
            raise RuntimeError("PDF worker exited successfully but produced no PDF.")
        if proc.stdout.strip():
            print(proc.stdout.strip())
    return str(output_path)


def _embed_images(html: str, images: dict[str, str]) -> str:
    for cid, filename in images.items():
        path = Path(filename)
        mime = {".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".gif": "image/gif", ".webp": "image/webp"}.get(path.suffix.lower())
        if mime is None:
            raise ValueError(f"Unsupported image format for {cid}: {path.suffix}")
        uri = f"data:{mime};base64,{base64.b64encode(path.read_bytes()).decode('ascii')}"
        # Match this CID only, without modifying unrelated CID references.
        html = re.sub(re.escape("cid:" + cid) + r"(?=[\"'\s<>]|$)", lambda _: uri, html, flags=re.I)
    unresolved = re.findall(r"cid:[^\"'\s<>]+", html, flags=re.I)
    if unresolved:
        raise ValueError(f"Unresolved inline image CID references: {unresolved}")
    return html


def _run_worker(config_path: Path) -> None:
    from PIL import Image
    from playwright.sync_api import sync_playwright
    from reportlab.lib.pagesizes import A4, legal, letter, landscape
    from reportlab.lib.utils import ImageReader
    from reportlab.pdfgen import canvas

    cfg = json.loads(config_path.read_text(encoding="utf-8"))
    html = Path(cfg["html_path"]).read_text(encoding="utf-8")
    html = _embed_images(html, cfg["images"])
    css = """<style>
    html, body { background: white !important; }
    body { margin: 0 !important; padding: 12px !important; box-sizing: border-box; }
    img { max-width: 100%; height: auto; }
    table { border-collapse: collapse; }
    </style>"""
    if re.search(r"</head\s*>", html, re.I):
        html = re.sub(r"</head\s*>", lambda m: css + m.group(0), html, count=1, flags=re.I)
    else:
        html = css + html

    debug_dir = Path(cfg["debug_dir"]) if cfg["debug_dir"] else None
    if debug_dir:
        (debug_dir / "report_pdf_preview.html").write_text(html, encoding="utf-8")

    with tempfile.TemporaryDirectory(prefix="report_render_") as temp:
        image_path = Path(temp) / "render.png"
        with sync_playwright() as p:
            browser = p.chromium.launch(channel="msedge", headless=True)
            try:
                page = browser.new_page(viewport={"width": 1100, "height": 900}, device_scale_factor=2)
                page.emulate_media(media="screen")
                page.set_content(html, wait_until="load", timeout=60000)
                page.evaluate("""async () => {
                    await Promise.all(Array.from(document.images).map(img => {
                        if (img.complete) return Promise.resolve();
                        return new Promise(resolve => { img.onload = resolve; img.onerror = resolve; });
                    }));
                    if (document.fonts) await document.fonts.ready;
                }""")
                missing = page.evaluate("""() => Array.from(document.images)
                    .filter(img => !img.complete || img.naturalWidth === 0)
                    .map(img => img.getAttribute('src')?.slice(0, 120))""")
                if missing:
                    raise RuntimeError(f"Images failed to load: {missing}")
                page.screenshot(path=str(image_path), full_page=True, animations="disabled")
            finally:
                browser.close()

        if debug_dir:
            from shutil import copyfile
            copyfile(image_path, debug_dir / "report_pdf_render.png")

        sizes = {"letter": letter, "a4": A4, "legal": legal}
        paper = sizes[cfg["page_size"]]
        if cfg["orientation"] == "landscape":
            paper = landscape(paper)
        page_w, page_h = paper
        margin = 18
        usable_w, usable_h = page_w - 2 * margin, page_h - 2 * margin
        pdf = canvas.Canvas(cfg["output"], pagesize=paper)
        pdf.setTitle("Report")

        with Image.open(image_path) as img:
            img_w, img_h = img.size
            if cfg["multipage"]:
                # Render at readable page width and slice the tall image into pages.
                px_per_page = max(1, int(usable_h * img_w / usable_w))
                for top in range(0, img_h, px_per_page):
                    bottom = min(img_h, top + px_per_page)
                    tile = img.crop((0, top, img_w, bottom))
                    tile_h_pt = (bottom - top) * usable_w / img_w
                    pdf.drawImage(ImageReader(tile), margin, page_h - margin - tile_h_pt,
                                  width=usable_w, height=tile_h_pt, mask="auto")
                    pdf.showPage()
            else:
                factor = min(usable_w / img_w, usable_h / img_h)
                draw_w, draw_h = img_w * factor, img_h * factor
                pdf.drawImage(ImageReader(img), (page_w - draw_w) / 2,
                              page_h - margin - draw_h, width=draw_w,
                              height=draw_h, mask="auto")
                pdf.showPage()
                if draw_w < usable_w * 0.65:
                    print("WARNING: Tall report scaled to one page; text may be small.")
        pdf.save()
    print(f"PDF created: {cfg['output']}")


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--worker", type=Path, required=True)
    args = parser.parse_args()
    _run_worker(args.worker)

"""
Build Texas Census Tract Population Density Tier Table
---------------------------------------------------------
Pulls ACS 5-Year population estimates + TIGER/Line tract boundaries
for Texas, calculates population density per square mile, and buckets
every tract into urban / medium / rural tiers.

Requirements:
    pip install requests pandas geopandas

Usage:
    1. Set your Census API key below (or set it as an environment
       variable CENSUS_API_KEY instead of hardcoding it).
    2. Run: python build_tx_density_tiers.py
    3. Outputs:
       - tx_tract_density_tiers.csv      (no geometry, lightweight)
       - tx_tract_density_tiers.geojson  (full polygons, for mapping)
"""

import os
import json
import zipfile
import io
import requests
import pandas as pd
import geopandas as gpd

# ---------------------------------------------------------------------
# CONFIG
# ---------------------------------------------------------------------

# Recommended: set this as an environment variable instead of hardcoding
#   Windows (cmd):    set CENSUS_API_KEY=your_key_here
#   Windows (PowerShell): $env:CENSUS_API_KEY="your_key_here"
#   Mac/Linux:         export CENSUS_API_KEY=your_key_here
CENSUS_API_KEY = os.environ.get("CENSUS_API_KEY", "PASTE_YOUR_KEY_HERE")

ACS_YEAR = 2022  # most recent 5-year ACS release at time of writing
STATE_FIPS = "48"  # Texas

TIGER_URL = f"https://www2.census.gov/geo/tiger/TIGER2023/TRACT/tl_2023_{STATE_FIPS}_tract.zip"
ACS_URL = (
    f"https://api.census.gov/data/{ACS_YEAR}/acs/acs5"
    f"?get=NAME,B01003_001E&for=tract:*&in=state:{STATE_FIPS}&key={CENSUS_API_KEY}"
)

OUTPUT_DIR = "."  # change if you want output written elsewhere
SHAPEFILE_DIR = "tx_tracts_shapefile"

SQM_PER_SQMI = 2_589_988.11

# Density thresholds (people per square mile) used to bucket tracts.
# Adjust these if your own knowledge of the territories suggests
# different cutoffs.
RURAL_MAX = 500
MEDIUM_MAX = 3000


# ---------------------------------------------------------------------
# STEP 1: Pull population data from the Census ACS API
# ---------------------------------------------------------------------

def fetch_population():
    print("Fetching population data from Census API...")
    resp = requests.get(ACS_URL)
    resp.raise_for_status()

    # The Census API returns an HTML error page (not JSON) on bad key /
    # bad request, so catch that explicitly with a clear message.
    try:
        data = resp.json()
    except json.JSONDecodeError:
        raise RuntimeError(
            "Census API did not return valid JSON. This usually means "
            "the API key is invalid, unactivated, or malformed. "
            "Response preview:\n" + resp.text[:300]
        )

    df = pd.DataFrame(data[1:], columns=data[0])
    df["GEOID"] = df["state"] + df["county"] + df["tract"]
    df["population"] = pd.to_numeric(df["B01003_001E"])
    return df[["GEOID", "NAME", "population"]]


# ---------------------------------------------------------------------
# STEP 2: Download and unzip TIGER/Line tract boundary shapefile
# ---------------------------------------------------------------------

def fetch_tract_boundaries():
    print("Downloading TIGER/Line tract boundaries...")
    resp = requests.get(TIGER_URL)
    resp.raise_for_status()

    os.makedirs(SHAPEFILE_DIR, exist_ok=True)
    with zipfile.ZipFile(io.BytesIO(resp.content)) as z:
        z.extractall(SHAPEFILE_DIR)

    shp_path = os.path.join(SHAPEFILE_DIR, f"tl_2023_{STATE_FIPS}_tract.shp")
    tracts = gpd.read_file(shp_path)
    return tracts[["GEOID", "ALAND", "AWATER", "INTPTLAT", "INTPTLON", "geometry"]]


# ---------------------------------------------------------------------
# STEP 3: Merge, calculate density, classify tiers
# ---------------------------------------------------------------------

def classify_density(density):
    if density < RURAL_MAX:
        return "rural"
    elif density < MEDIUM_MAX:
        return "medium"
    else:
        return "urban"


def build_density_table():
    pop_df = fetch_population()
    tracts = fetch_tract_boundaries()

    merged = tracts.merge(pop_df, on="GEOID", how="inner")
    print(f"Merged {len(merged)} tracts (population rows: {len(pop_df)}, "
          f"boundary rows: {len(tracts)})")

    merged["land_sqmi"] = merged["ALAND"] / SQM_PER_SQMI
    merged["pop_density_sqmi"] = merged["population"] / merged["land_sqmi"]

    # Avoid inf/div-by-zero on essentially-zero-land tracts (e.g. pure water)
    merged.loc[merged["land_sqmi"] < 0.01, "pop_density_sqmi"] = 0

    valid = merged[merged["land_sqmi"] >= 0.01].copy()
    valid["density_tier"] = valid["pop_density_sqmi"].apply(classify_density)

    return valid


# ---------------------------------------------------------------------
# MAIN
# ---------------------------------------------------------------------

if __name__ == "__main__":
    if CENSUS_API_KEY == "PASTE_YOUR_KEY_HERE":
        raise SystemExit(
            "No Census API key set. Either set the CENSUS_API_KEY "
            "environment variable, or edit this script and paste your "
            "key into the CENSUS_API_KEY variable at the top."
        )

    table = build_density_table()

    print(table["density_tier"].value_counts())
    print(table.groupby("density_tier")["pop_density_sqmi"]
          .agg(["min", "median", "max", "count"]))

    csv_path = os.path.join(OUTPUT_DIR, "tx_tract_density_tiers.csv")
    geojson_path = os.path.join(OUTPUT_DIR, "tx_tract_density_tiers.geojson")

    table.drop(columns="geometry").to_csv(csv_path, index=False)
    table.to_file(geojson_path, driver="GeoJSON")

    print(f"\nSaved: {csv_path}")
    print(f"Saved: {geojson_path}")

WITH meter_history AS (
    SELECT
        TRIM(meterno) AS meterno,

        MAX(
            CASE
                WHEN end_dt < DATE '4000-12-31'
                THEN end_dt
            END
        ) AS latest_end_date,

        MAX(eff_dt) AS latest_effective_date,

        MAX(
            CASE
                WHEN end_dt = DATE '4000-12-31'
                THEN 1 ELSE 0
            END
        ) AS has_active_placeholder

    FROM test_sample
    GROUP BY TRIM(meterno)
)

SELECT
    h.*,

    CASE
        WHEN a.meterno IS NOT NULL
            THEN 'IN ACTIVE INVENTORY'

        WHEN h.has_active_placeholder = 1
            THEN 'CONFLICT - PLACEHOLDER BUT NOT ACTIVE'

        ELSE 'NOT IN ACTIVE INVENTORY'
    END AS meter_status

FROM meter_history h

LEFT JOIN (
    SELECT DISTINCT TRIM(meterno) AS meterno
    FROM alltown
) a
    ON h.meterno = a.meterno;

returns the same list of dictionaries from a database query.
"""
from __future__ import annotations

import json
from datetime import datetime
from html import escape
from pathlib import Path

OUTPUT_PATH = Path(__file__).with_name('nlp_model_performance_report.html')


def load_dummy_data() -> list[dict]:
    """Simulated data; one evaluation per model, joined to model/category metadata."""
    return [
        dict(model_id=1, name='Battery v1', category_id=1, category='Battery Change', active_flag=False, tpc=180, tnc=740, fpc=30, fnc=50),
        dict(model_id=2, name='Battery v2', category_id=1, category='Battery Change', active_flag=True, tpc=210, tnc=750, fpc=20, fnc=20),
        dict(model_id=3, name='LCD v1', category_id=2, category='Bad LCD', active_flag=False, tpc=140, tnc=790, fpc=40, fnc=30),
        dict(model_id=4, name='LCD v2', category_id=2, category='Bad LCD', active_flag=True, tpc=155, tnc=810, fpc=20, fnc=15),
        dict(model_id=5, name='Meter v1', category_id=3, category='Meter Change', active_flag=False, tpc=300, tnc=600, fpc=60, fnc=40),
        dict(model_id=6, name='Meter v2', category_id=3, category='Meter Change', active_flag=True, tpc=320, tnc=620, fpc=40, fnc=20),
    ]


def safe_ratio(numerator: int, denominator: int) -> float | None:
    return numerator / denominator if denominator else None


def calculate_metrics(records: list[dict]) -> list[dict]:
    output = []
    for item in records:
        row = dict(item)
        tp, tn, fp, fn = (int(row[key]) for key in ('tpc', 'tnc', 'fpc', 'fnc'))
        if min(tp, tn, fp, fn) < 0:
            raise ValueError(f"Negative count for model {row['model_id']}")
        row['actp'] = tp + fn
        row['actn'] = tn + fp
        row['precision'] = safe_ratio(tp, tp + fp)
        row['recall'] = safe_ratio(tp, tp + fn)
        row['accuracy'] = safe_ratio(tp + tn, tp + tn + fp + fn)
        row['f1'] = safe_ratio(2 * tp, 2 * tp + fp + fn)
        output.append(row)
    return output



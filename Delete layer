combined = conn.execute("""

select
  -- THE TARGET: the meter this tech actually pulled
  a.hist_meter        as target_meter,
  a.esi_loc           as target_esi_loc,
  a.workedby,
  cast(a.hist_meter_removal_date as date) as work_date,
  a.hist_latitude     as target_lat,
  a.hist_longitude    as target_lon,

  -- THE NEIGHBOR: another S4e sitting nearby that day
  b.hist_meter        as nearby_meter,
  b.esi_loc           as nearby_esi_loc,
  b.workedby          as nearby_workedby,
  cast(b.hist_meter_removal_date as date) as nearby_removal_date,
  b.hist_latitude     as nearby_lat,
  b.hist_longitude    as nearby_lon,

  case
    when b.hist_meter = a.hist_meter then 'TARGET ITSELF'
    when cast(b.hist_meter_removal_date as date) = cast(a.hist_meter_removal_date as date)
         and b.workedby = a.workedby then 'CAPTURED SAME DAY'
    when cast(b.hist_meter_removal_date as date) = cast(a.hist_meter_removal_date as date)
         then 'SAME DAY OTHER TECH'
    when b.hist_meter_removal_date = date '3001-01-01' then 'STILL NOT REMOVED'
    when cast(b.hist_meter_removal_date as date) > cast(a.hist_meter_removal_date as date)
         then 'REMOVED LATER'
    else 'ALREADY GONE'
  end as outcome,

  round(3959 * 2 * asin(sqrt(
      power(sin(radians(b.hist_latitude - a.hist_latitude)/2), 2)
      + cos(radians(a.hist_latitude)) * cos(radians(b.hist_latitude))
      * power(sin(radians(b.hist_longitude - a.hist_longitude)/2), 2)
  )) * 5280, 0) as distance_feet

from s4e_pop_mapping a
join s4e_pop_mapping b
  on  b.hist_latitude  between a.hist_latitude  - 0.0015 and a.hist_latitude  + 0.0015
  and b.hist_longitude between a.hist_longitude - 0.0018 and a.hist_longitude + 0.0018

where a.hist_meter_removal_date <> date '3001-01-01'
  and a.workedby is not null
  and b.installation_date < cast(a.hist_meter_removal_date as date)

  and a.workedby = 'U5T5'
  and cast(a.hist_meter_removal_date as date) = date '2026-05-07'

order by a.hist_meter, distance_feet
""").df()

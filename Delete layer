import pandas as pd

meter_list = (
    assets['meterno']
    .dropna()
    .astype(str)
    .str.strip()
    .drop_duplicates()
    .tolist()
)

batch_size = 900
results = []

for i in range(0, len(meter_list), batch_size):

    batch = meter_list[i:i + batch_size]

    params = {
        f"m{j}": meter
        for j, meter in enumerate(batch)
    }

    placeholders = ", ".join(
        f":m{j}" for j in range(len(batch))
    )

    query = f"""
        SELECT DISTINCT
            SUBSTR(WR.WORKLOCATION_ESIID, 8, 10) ESI_LOC,
            CIS.METER_NUM,
            WR.F1_SVC_TASK_ID WR_ID,
            CAST(TRUNC(WR.CRE_DTTM) AS DATE) CREATE_DATE,
            CAST(TRUNC(WR.CI_WORKDATETIME) AS DATE) WORKEDDATE,
            WR.CRE_DTTM,
            WR.SUBTYP WR_SUBTYPE,
            WR.BO_STATUS_CD WR_STATUS

        FROM RPTUSER.CM_WORKREQUESTTASK_VW WR

        JOIN CADPROD.CISPERSEL_VW CIS
            ON SUBSTR(WR.WORKLOCATION_ESIID, 8, 10) = CIS.PREMISE

        WHERE WR.CRE_DTTM >= DATE '2025-01-01'
        AND WR.BO_STATUS_CD = 'COMPLETED'
        AND CIS.METER_NUM IN ({placeholders})
    """

    df = pd.read_sql(
        query,
        sql_connection,
        params=params
    )

    results.append(df)

work_orders = pd.concat(
    results,
    ignore_index=True
).drop_duplicates()

# Header
c.setFillColor(NAVY)
c.rect(
    margin, top - header_h,
    usable_w, header_h,
    fill=1, stroke=0
)

x = margin

for col, w in zip(cols, widths):

    c.setFillColor(colors.white)

    label = str(col).replace("_", " ")

    if label == "Grand Total":
        label = "GRAND TOTAL"

    # Look up the descriptive DGroup name
    group_name = (
        group_names.get(col, "")
        if group_names else ""
    )

    align = "right" if col in numeric else "left"

    if group_name:

        # DGroup acronym - first line
        draw_text(
            label,
            x,
            top - 18,
            w,
            align=align,
            bold=True,
            max_font=min(font, 8)
        )

        # Descriptive name - second line
        draw_text(
            str(group_name),
            x,
            top - 34,
            w,
            align=align,
            bold=False,
            max_font=6
        )

    else:

        # Normal headers without a descriptive name
        draw_text(
            label,
            x,
            top - header_h / 2 - 3,
            w,
            align=align,
            bold=True,
            max_font=min(font, 8)
        )

    x += w



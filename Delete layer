def is_first_workday_of_week(check_date=None):

    if check_date is None:
        check_date = date.today()

    us_holidays = holidays.US(years=check_date.year)

    # Start with Monday of the current week
    monday = check_date - timedelta(days=check_date.weekday())

    # Find the first non-holiday weekday
    first_workday = monday

    while (
        first_workday.weekday() >= 5
        or first_workday in us_holidays
    ):
        first_workday += timedelta(days=1)

    return check_date == first_workday





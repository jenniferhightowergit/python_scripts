WITH params AS (
    SELECT 
        69.0 AS mi_per_deg_lat,
        69.0 * cos(radians(AVG(latitude))) AS mi_per_deg_lon
    FROM alltown
),
gridded AS (
    SELECT
        a.meterno,
        a.hardware_model,
        a.latitude,
        a.longitude,
        FLOOR(a.latitude / (1.0/p.mi_per_deg_lat)) * (1.0/p.mi_per_deg_lat) AS grid_lat,
        FLOOR(a.longitude / (1.0/p.mi_per_deg_lon)) * (1.0/p.mi_per_deg_lon) AS grid_lon
    FROM alltown a, params p
)
SELECT
    grid_lat, grid_lon,
    COUNT(*) AS meter_count,
    COUNT(*) FILTER (WHERE hardware_model LIKE '%Enhanced%') AS enhanced_count
FROM gridded
GROUP BY grid_lat, grid_lon

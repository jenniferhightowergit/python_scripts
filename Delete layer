
import numpy as np
import pandas as pd
import geopandas as gpd
import matplotlib.pyplot as plt
import shapely

from shapely.geometry import box
from scipy.spatial import cKDTree
from pathlib import Path
from itertools import combinations

# ============================================================
# 1. CONFIGURATION
# ============================================================

# Input DataFrame:
# df_valid must already contain your cleaned meter data.

LAT_COL = "latitude_clean"
LON_COL = "longitude_clean"
AREA_COL = "op_area"

# Distance around each meter (meters)
BUFFER_DISTANCE = 3000

# Geographic grid resolution (meters)
CELL_SIZE = 1000

# Number of nearby meters used to assign an op area
K_NEIGHBORS = 5

OUTPUT_FILE = "op_area_boundaries_3km.geojson"

# ============================================================
# 2. CLEAN AND VALIDATE METER DATA
# ============================================================

df = df_valid.dropna(
    subset=[LAT_COL, LON_COL, AREA_COL]
).copy()

df = df[
    df[LAT_COL].between(25, 37)
    & df[LON_COL].between(-107, -93)
].copy()

if df.empty:
    raise ValueError("No valid meter coordinates found.")

print(f"Valid meters: {len(df):,}")
print(f"Operational areas: {df[AREA_COL].nunique()}")

# ============================================================
# 3. CREATE GEOGRAPHIC POINTS
# ============================================================

meters = gpd.GeoDataFrame(
    df,
    geometry=gpd.points_from_xy(
        df[LON_COL],
        df[LAT_COL]
    ),
    crs="EPSG:4326"
)

# Project to meters for distance calculations
meters = meters.to_crs("EPSG:5070")

# ============================================================
# 4. CREATE 3 KM BUFFERED METER FOOTPRINT
# ============================================================

print("Creating 3 km meter buffers...")

meter_buffers = meters.geometry.buffer(
    BUFFER_DISTANCE
)

# Merge overlapping buffers into a single geometry
footprint_geom = shapely.union_all(
    meter_buffers.values
)

footprint = gpd.GeoDataFrame(
    geometry=[footprint_geom],
    crs=meters.crs
)

print("Buffered meter footprint created.")

# ============================================================
# 5. CREATE GRID OVER METER EXTENT
# ============================================================

xmin, ymin, xmax, ymax = meters.total_bounds

x_coords = np.arange(
    xmin - BUFFER_DISTANCE,
    xmax + BUFFER_DISTANCE,
    CELL_SIZE
)

y_coords = np.arange(
    ymin - BUFFER_DISTANCE,
    ymax + BUFFER_DISTANCE,
    CELL_SIZE
)

cells = [
    box(x, y, x + CELL_SIZE, y + CELL_SIZE)
    for x in x_coords
    for y in y_coords
]

grid = gpd.GeoDataFrame(
    geometry=cells,
    crs=meters.crs
)

print(f"Initial grid cells: {len(grid):,}")

# ============================================================
# 6. CLIP GRID TO BUFFERED FOOTPRINT
# ============================================================

grid = gpd.clip(
    grid,
    footprint
).reset_index(drop=True)

print(f"Grid cells inside footprint: {len(grid):,}")

# ============================================================
# 7. ASSIGN EACH GRID CELL TO AN OP AREA
# ============================================================

print("Assigning operational areas...")

meter_xy = np.column_stack([
    meters.geometry.x,
    meters.geometry.y
])

centroids = grid.geometry.centroid

grid_xy = np.column_stack([
    centroids.x,
    centroids.y
])

tree = cKDTree(meter_xy)

k = min(
    K_NEIGHBORS,
    len(meters)
)

distances, indices = tree.query(
    grid_xy,
    k=k
)

if k == 1:
    indices = indices.reshape(-1, 1)

labels = meters[AREA_COL].astype(str).to_numpy()

def assign_area(neighbor_indices):

    nearby_areas = labels[neighbor_indices]

    unique, counts = np.unique(
        nearby_areas,
        return_counts=True
    )

    return unique[np.argmax(counts)]

grid[AREA_COL] = [
    assign_area(idx)
    for idx in indices
]

# ============================================================
# 8. DISSOLVE INTO OPERATIONAL AREA POLYGONS
# ============================================================

print("Creating operational area polygons...")

boundaries = (
    grid
    .dissolve(by=AREA_COL)
    .reset_index()
)

boundaries["geometry"] = (
    boundaries.geometry.make_valid()
)

boundaries = boundaries[
    ~boundaries.geometry.is_empty
].copy()

print(f"Operational areas created: {len(boundaries)}")

# ============================================================
# 9. VALIDATE OVERLAPPING POLYGONS
# ============================================================

print("Checking for overlaps...")

overlap_count = 0

for i, j in combinations(range(len(boundaries)), 2):

    geom1 = boundaries.geometry.iloc[i]
    geom2 = boundaries.geometry.iloc[j]

    if geom1.intersection(geom2).area > 1:
        overlap_count += 1

print(f"Overlapping area pairs: {overlap_count}")

# ============================================================
# 10. EXPORT GEOJSON FOR TABLEAU
# ============================================================

boundaries_export = boundaries.to_crs("EPSG:4326")

boundaries_export.to_file(
    OUTPUT_FILE,
    driver="GeoJSON"
)

print(f"GeoJSON saved to: {Path(OUTPUT_FILE).resolve()}")

# ============================================================
# 11. PLOT BOUNDARIES WITH METER LOCATIONS
# ============================================================

fig, ax = plt.subplots(
    figsize=(18, 12)
)

boundaries.plot(
    ax=ax,
    column=AREA_COL,
    cmap="tab20",
    edgecolor="black",
    linewidth=0.5,
    alpha=0.65,
    legend=True
)

meters.plot(
    ax=ax,
    color="black",
    markersize=0.2,
    alpha=0.12
)

ax.set_title(
    "Operational Area Boundaries - 3 km Meter Buffers",
    fontsize=16
)

ax.set_axis_off()

plt.tight_layout()
plt.show()

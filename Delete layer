-- ----------------------------------------------------------------------------
-- 2. Neighbor pairs -- keep combined's grain, just narrow it
-- ----------------------------------------------------------------------------
create or replace view neighbor_pairs as
select
    workedby,
    work_date,
    date_trunc('week', cast(work_date as date)) as work_week,
    cluster_id,
    target_meter,
    nearby_meter,
    nearby_workedby,
    nearby_removal_date,
    nearby_Ticket_Type,
    outcome,
    distance_feet
from combined
where nearby_meter is not null
  and nearby_meter <> target_meter;


-- ----------------------------------------------------------------------------
-- 3. Visits -- contiguous runs in one cluster, for travel and revisits
-- ----------------------------------------------------------------------------
create or replace view work_visits as
with seq as (
    select
        *,
        lag(cluster_id)      over w as prev_cluster_id,
        lag(worked_datetime) over w as prev_worked_datetime
    from work_events
    window w as (partition by workedby, work_date order by worked_datetime)
),
flagged as (
    select *,
        case when prev_cluster_id is null
                  or cluster_id <> prev_cluster_id then 1 else 0
        end as is_switch
    from seq
)
select *,
    sum(is_switch) over (
        partition by workedby, work_date
        order by worked_datetime
        rows between unbounded preceding and current row
    ) as visit_num
from flagged;

create or replace view visit_metrics as
with base as (
    select
        workedby, work_date, work_week, visit_num, cluster_id,
        min(worked_datetime)                as visit_start,
        max(worked_datetime)                as visit_end,
        arg_min(latitude,  worked_datetime) as start_lat,
        arg_min(longitude, worked_datetime) as start_lon,
        arg_max(latitude,  worked_datetime) as end_lat,
        arg_max(longitude, worked_datetime) as end_lon,
        count(distinct meterno)             as meters_worked,
        minutes_between(min(worked_datetime), max(worked_datetime))
                                            as visit_minutes
    from work_visits
    group by workedby, work_date, work_week, visit_num, cluster_id
)
select *,
    minutes_between(lag(visit_end) over w, visit_start) as travel_minutes,
    miles_between(lag(end_lat) over w, lag(end_lon) over w,
                  start_lat, start_lon)                 as travel_miles
from base
window w as (partition by workedby, work_date order by visit_start);


-- ----------------------------------------------------------------------------
-- 4. Density bands (your thresholds, grouped on cluster only)
-- ----------------------------------------------------------------------------
create or replace view cluster_density as
select
    cluster_id,
    count(distinct meterno) as total_cnt,
    case when count(distinct meterno) > 500 then 'URBAN'
         when count(distinct meterno) > 50  then 'MID-CITY'
         else 'RURAL' end   as density_band
from work_events
where cluster_id is not null
group by cluster_id;


-- ----------------------------------------------------------------------------
-- 5. Per tech, per week
-- ----------------------------------------------------------------------------
create or replace view tech_week as
with meters as (
    select
        workedby, work_week,
        count(distinct meterno)                              as meters_changed,
        count(distinct meterno) filter (where is_s4e)        as s4e_changes,
        count(distinct meterno) filter (where not is_s4e)    as non_s4e_changes,
        count(distinct cluster_id)                           as clusters_visited,
        count(distinct work_date)                            as days_worked
    from work_events
    group by workedby, work_week
),
daily_hours as (
    select workedby, work_week,
        avg(day_minutes) / 60.0 as avg_hours_per_day
    from (
        select workedby, work_week, work_date,
            minutes_between(min(worked_datetime), max(worked_datetime))
                as day_minutes
        from work_events
        group by workedby, work_week, work_date
    ) d
    group by workedby, work_week
),
visits as (
    select
        workedby, work_week,
        count(*)                                as cluster_visits,
        count(*) - count(distinct cluster_id)   as cluster_revisits,
        sum(travel_miles)                       as travel_miles,
        sum(travel_minutes)                     as travel_minutes,
        sum(visit_minutes)                      as cluster_minutes
    from visit_metrics
    group by workedby, work_week
),
missed as (
    -- meters near this tech that a DIFFERENT tech changed later
    select
        workedby, work_week,
        count(distinct nearby_meter) as meters_others_changed
    from neighbor_pairs
    where nearby_workedby is not null
      and nearby_workedby <> workedby
      and cast(nearby_removal_date as date) > cast(work_date as date)
      and distance_feet <= 2640                      -- NEAR_FEET: 0.5 mi
    group by workedby, work_week
),
band as (
    select workedby, work_week,
        arg_max(d.density_band, w.meters) as density_band
    from (
        select workedby, work_week, cluster_id,
               count(distinct meterno) as meters
        from work_events group by 1, 2, 3
    ) w
    join cluster_density d using (cluster_id)
    group by workedby, work_week
)
select
    m.workedby,
    m.work_week,
    m.days_worked,
    b.density_band,

    m.meters_changed,
    m.s4e_changes,
    m.non_s4e_changes,
    m.clusters_visited,
    v.cluster_visits,
    v.cluster_revisits,
    coalesce(x.meters_others_changed, 0)        as meters_others_changed,

    v.travel_miles,
    v.travel_minutes,
    v.cluster_minutes,
    h.avg_hours_per_day,

    round(m.meters_changed * 1.0
          / nullif(m.clusters_visited, 0), 2)   as meters_per_cluster,
    round(v.cluster_minutes
          / nullif(m.meters_changed, 0), 2)     as minutes_per_meter,
    round(v.cluster_visits * 1.0
          / nullif(m.clusters_visited, 0), 3)   as revisit_rate,
    round(v.travel_miles
          / nullif(m.meters_changed, 0), 3)     as miles_per_meter

from meters m
left join visits      v using (workedby, work_week)
left join daily_hours h using (workedby, work_week)
left join missed      x using (workedby, work_week)
left join band        b using (workedby, work_week);


-- ----------------------------------------------------------------------------
-- 6. Behavior patterns (cutoffs from your own distribution)
-- ----------------------------------------------------------------------------
create or replace view pattern_thresholds as
select
    quantile_cont(meters_per_cluster, 0.50) as med_mpc,
    quantile_cont(meters_per_cluster, 0.25) as p25_mpc,
    quantile_cont(miles_per_meter,    0.75) as p75_mpm
from tech_week
where meters_changed > 0;

create or replace view tech_week_labelled as
select t.*,
    case
        when t.cluster_revisits >= 2 and t.revisit_rate >= 1.25
            then 'REVISITING'
        when t.clusters_visited <= 2 and t.meters_per_cluster >= p.med_mpc
            then 'FOCUSED'
        when t.miles_per_meter >= p.p75_mpm
             and t.meters_per_cluster <= p.p25_mpc
            then 'FRAGMENTED'
        when t.clusters_visited >= 3 and t.revisit_rate < 1.25
            then 'SEQUENTIAL'
        else 'OTHER'
    end as behavior_pattern
from tech_week t
cross join pattern_thresholds p;


-- ----------------------------------------------------------------------------
-- 7. Per tech -- the summary tiles
-- ----------------------------------------------------------------------------
create or replace view tech_summary as
select
    workedby,
    count(*)                                as weeks_active,
    round(avg(meters_changed), 1)           as avg_meters_per_week,
    round(avg(s4e_changes), 1)              as avg_s4e_per_week,
    round(avg(non_s4e_changes), 1)          as avg_non_s4e_per_week,
    round(avg(clusters_visited), 1)         as avg_clusters_per_week,
    round(avg(meters_per_cluster), 1)       as avg_meters_per_cluster,
    round(avg(meters_others_changed), 1)    as avg_meters_others_changed,
    round(avg(cluster_revisits), 1)         as avg_revisits_per_week,
    round(avg(travel_miles), 1)             as avg_miles_per_week,
    round(avg(travel_minutes), 1)           as avg_travel_minutes_per_week,
    round(avg(minutes_per_meter), 1)        as avg_minutes_per_meter,
    round(avg(avg_hours_per_day), 1)        as avg_hours_per_day,
    mode(behavior_pattern)                  as typical_pattern,
    mode(density_band)                      as typical_density_band
from tech_week_labelled
group by workedby;


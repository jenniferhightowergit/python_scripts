from pathlib import Path
import duckdb

# Existing parquet dataset
input_path = Path(
    r"\\your\estimating.parquet"
)

# New cleaned dataset
output_path = Path(
    r"\\your\estimating_cleaned.parquet"
)

duckdb.sql(f"""
COPY (
    SELECT *
    FROM read_parquet(
        '{input_path.as_posix()}/**/*.parquet',
        union_by_name = true
    )
    WHERE file_date < DATE '2026-06-02'
)
TO '{output_path.as_posix()}'
(
    FORMAT PARQUET,
    PARTITION_BY (file_date)
);
""")

print("Done!")
print(f"Cleaned data written to:\n{output_path}")

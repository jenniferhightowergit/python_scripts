"""
SecConfig refresh  ->  summary_df.csv  (feeds the "Sent to AMS Design: 20 Day Aging" Tableau report)

What it does
  1. Reads the existing summary_df.csv (that file's header is the schema: column names and order).
  2. Scans AMS DESIGN IMPORT + AMS DESIGN ARCHIVE for files named exactly "NON COMM m_d_yyyy.xlsx".
  3. Loads only files that are new (file_date not in the csv yet) or newer than what's in the csv.
  4. Forces every column to one data type so Tableau never sees mixed types.
  5. Keeps one file per file_date (newest file_modified_time wins) and a rolling 1-year window.
  6. Backs up the old csv, then writes the new one in a single step (temp file + swap).
"""

import os
import re
import shutil
from datetime import datetime, timedelta
from pathlib import Path

import pandas as pd

# ---------------------------------------------------------------- CONFIG
SOURCE_FOLDERS = [
    Path(r"\\eucprdnas01\u_support\AMS DESIGN IMPORT"),
    Path(r"\\eucprdnas01\u_support\AMS DESIGN IMPORT\AMS DESIGN ARCHIVE"),
]
SUMMARY_CSV = Path(r"PUT\THE\PATH\TO\summary_df.csv")   # <-- from Tableau: Data > Edit Connection
BACKUP_FOLDER = SUMMARY_CSV.parent / "backups"
RETENTION_DAYS = 365

FILE_PATTERN = re.compile(r"^NON COMM (\d{1,2})_(\d{1,2})_(\d{4})\.xlsx$", re.IGNORECASE)

DATE_COLS = ["LAST_GOOD_READ_DATE", "file_date"]
DATETIME_COLS = ["file_modified_time"]
INT_COLS = ["NUMBER_OF_DAYS"]
FLOAT_COLS = ["LATITUDE", "LONGITUDE"]
# Every other column is text, except the per-row count columns (Total_Row..., Distinct_C...,
# TDistinct_Count_Meters). They aren't in the source files; each row is one meter, so they're 1.

DATE_FMT = "%Y-%m-%d"
DATETIME_FMT = "%Y-%m-%d %H:%M:%S"
# ------------------------------------------------------------------------


def to_date(series: pd.Series) -> pd.Series:
    """Excel dates, Excel serial numbers, and text dates in any common format -> datetime (NaT if hopeless)."""
    s = series.copy()
    out = pd.Series(pd.NaT, index=s.index, dtype="datetime64[ns]")

    # 1) real datetimes
    is_dt = s.apply(lambda v: isinstance(v, (datetime, pd.Timestamp)))
    out[is_dt] = pd.to_datetime(s[is_dt], errors="coerce")

    # 2) Excel serial numbers (e.g. 46324) -- numbers or numeric text
    num = pd.to_numeric(s[~is_dt], errors="coerce")
    is_serial = num.between(20000, 80000)
    idx = num[is_serial].index
    out[idx] = pd.to_datetime(num[is_serial], unit="D", origin="1899-12-30")

    # 3) text: try known formats one at a time, then a last-chance generic parse
    rest = s[out.isna() & s.notna()].astype(str).str.strip()
    rest = rest[rest != ""]
    for fmt in ("%Y-%m-%d", "%Y-%m-%d %H:%M:%S", "%m/%d/%Y", "%m/%d/%Y %I:%M:%S %p",
                "%m/%d/%Y %H:%M", "%m/%d/%Y %H:%M:%S", "%d-%b-%y", "%d-%b-%Y", "%m/%d/%y"):
        if rest.empty:
            break
        parsed = pd.to_datetime(rest, format=fmt, errors="coerce")
        hit = parsed.notna()
        out[rest[hit].index] = parsed[hit]
        rest = rest[~hit]
    if not rest.empty:
        parsed = pd.to_datetime(rest, errors="coerce")
        out[rest.index] = parsed
    return out


def enforce_types(df: pd.DataFrame, columns: list) -> pd.DataFrame:
    """Put df in the csv's column order with one fixed type per column."""
    df = df.reindex(columns=columns)
    for col in columns:
        if col in DATE_COLS or col in DATETIME_COLS:
            df[col] = to_date(df[col])
        elif col in INT_COLS:
            df[col] = pd.to_numeric(df[col], errors="coerce").round().astype("Int64")
        elif col in FLOAT_COLS:
            df[col] = pd.to_numeric(df[col], errors="coerce").astype("float64")
        elif is_count_col(col):
            df[col] = pd.to_numeric(df[col], errors="coerce").fillna(1).astype("Int64")
        else:
            df[col] = df[col].astype("string").str.strip().replace({"": pd.NA, "nan": pd.NA, "None": pd.NA})
    return df


def is_count_col(col: str) -> bool:
    c = col.upper()
    return c.startswith("TOTAL_") or c.startswith("DISTINCT_") or c.startswith("TDISTINCT_")


def find_source_files() -> list:
    found = {}
    for folder in SOURCE_FOLDERS:
        if not folder.exists():
            print(f"  ! folder not found, skipping: {folder}")
            continue
        for f in folder.iterdir():
            m = FILE_PATTERN.match(f.name)
            if not m:
                continue
            month, day, year = map(int, m.groups())
            try:
                fdate = pd.Timestamp(year=year, month=month, day=day)
            except ValueError:
                print(f"  ! bad date in file name, skipping: {f.name}")
                continue
            mtime = pd.Timestamp(datetime.fromtimestamp(f.stat().st_mtime)).floor("s")
            # same file_date in both folders -> keep the newer copy
            if fdate not in found or mtime > found[fdate][1]:
                found[fdate] = (f, mtime)
    return [(fdate, f, mtime) for fdate, (f, mtime) in sorted(found.items())]


def norm(name) -> str:
    """'NUMBER OF DAYS', 'Number_Of_Days ' -> 'NUMBEROFDAYS' so header spelling doesn't matter."""
    return re.sub(r"[^A-Z0-9]", "", str(name).upper())


REQUIRED = [norm(c) for c in ("MR_MDVC_NUMBER", "LAST_GOOD_READ_DATE", "NUMBER_OF_DAYS")]


def find_raw_data(path: Path):
    """Look at EVERY tab and return the one whose header row has the raw-data columns.
    Tab names (DATA, Sheet1, Sheet4...) don't matter; pivot tabs don't have these headers so they're skipped."""
    sheets = pd.read_excel(path, sheet_name=None, header=None, dtype=object, engine="openpyxl")
    for tab, grid in sheets.items():
        for r in range(min(10, len(grid))):          # header is usually row 1, allow a few junk rows above
            headers = [norm(v) for v in grid.iloc[r]]
            if all(req in headers for req in REQUIRED):
                df = grid.iloc[r + 1:].copy()
                df.columns = headers
                return tab, df
    return None, None


def read_source_file(path: Path, columns: list) -> pd.DataFrame:
    tab, raw = find_raw_data(path)
    if raw is None:
        print(f"  ! {path.name}: no tab with MR_MDVC_NUMBER / LAST_GOOD_READ_DATE / NUMBER_OF_DAYS -- SKIPPED")
        return None
    picked = pd.DataFrame(index=raw.index)
    for col in columns:
        if norm(col) in raw.columns:
            picked[col] = raw[norm(col)]
    # drop blank rows (Excel tables often have trailing empties)
    picked = picked[raw[norm("MR_MDVC_NUMBER")].notna()]
    print(f"  + {path.name} [tab '{tab}']: {len(picked):,} rows")
    return picked


def drop_incomplete(df: pd.DataFrame, label: str) -> pd.DataFrame:
    """Rows missing a last good read date or number of days don't go in the report."""
    bad = df["LAST_GOOD_READ_DATE"].isna() | df["NUMBER_OF_DAYS"].isna()
    if bad.any():
        print(f"  - {label}: dropped {bad.sum():,} rows missing LAST_GOOD_READ_DATE or NUMBER_OF_DAYS")
    return df[~bad]


def main():
    today = pd.Timestamp.today().normalize()
    cutoff = today - timedelta(days=RETENTION_DAYS)

    # ---- existing data
    existing = pd.read_csv(SUMMARY_CSV, dtype=str, keep_default_na=False)
    columns = list(existing.columns)
    existing = enforce_types(existing, columns)
    # cleans out the blank rows from the bad run too; those dates then get re-read from their files
    existing = drop_incomplete(existing, "existing csv")
    print(f"Existing csv: {len(existing):,} rows, "
          f"file_date {existing['file_date'].min():%m/%d/%Y} -> {existing['file_date'].max():%m/%d/%Y}")

    have = existing.groupby("file_date")["file_modified_time"].max().to_dict()

    # ---- new / updated files
    new_parts = []
    for fdate, path, mtime in find_source_files():
        if fdate < cutoff:
            continue
        old_mtime = have.get(fdate)
        if old_mtime is not None and pd.notna(old_mtime) and old_mtime >= mtime:
            continue
        df = read_source_file(path, columns)
        if df is None or df.empty:
            continue
        df["file_date"] = fdate
        df["file_modified_time"] = mtime
        new_parts.append(df)

    if not new_parts:
        print("No new files. csv left as is.")
        return

    new = enforce_types(pd.concat(new_parts, ignore_index=True), columns)
    new = drop_incomplete(new, "new files")
    combined = pd.concat([existing, new], ignore_index=True)

    # ---- one version per file_date (newest file wins), rolling window
    latest = combined.groupby("file_date")["file_modified_time"].transform("max")
    combined = combined[combined["file_modified_time"] == latest]
    combined = combined[combined["file_date"] >= cutoff]
    combined = combined.sort_values(["file_date", "LAST_GOOD_READ_DATE"]).reset_index(drop=True)

    # ---- guardrail report
    bad_lgrd = combined["LAST_GOOD_READ_DATE"].isna().sum()
    bad_days = combined["NUMBER_OF_DAYS"].isna().sum()
    if bad_lgrd or bad_days:
        print(f"  ! rows with unreadable LAST_GOOD_READ_DATE: {bad_lgrd}, NUMBER_OF_DAYS: {bad_days}")

    # ---- write: dates as text in ONE format so Tableau reads them the same every time
    out = combined.copy()
    for col in DATE_COLS:
        out[col] = out[col].dt.strftime(DATE_FMT)
    for col in DATETIME_COLS:
        out[col] = out[col].dt.strftime(DATETIME_FMT)

    BACKUP_FOLDER.mkdir(exist_ok=True)
    backup = BACKUP_FOLDER / f"summary_df_{datetime.now():%Y%m%d_%H%M%S}.csv"
    shutil.copy2(SUMMARY_CSV, backup)

    tmp = SUMMARY_CSV.with_suffix(".tmp")
    out.to_csv(tmp, index=False)
    os.replace(tmp, SUMMARY_CSV)

    print(f"Wrote {len(out):,} rows, file_date {combined['file_date'].min():%m/%d/%Y} -> "
          f"{combined['file_date'].max():%m/%d/%Y}")
    print(f"Backup: {backup}")
    print("\nCheck vs the email pivot (latest file_date):")
    last = combined[combined["file_date"] == combined["file_date"].max()]
    print(last.groupby("NUMBER_OF_DAYS").size().sort_index(ascending=False).to_string())
    print(f"Total: {len(last)}")


if __name__ == "__main__":
    main()

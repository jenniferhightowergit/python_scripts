-- ============================================================================
-- Base datasets + weekly summary, built off `combined`
--
-- `combined` is target x neighbor grain: one work event fans out to one row
-- per nearby S4e meter. Two derived tables split that back apart:
--
--   work_events    -> one row per actual meter change   (target grain)
--   neighbor_pairs -> one row per target/neighbor pair  (combined grain)
--
-- Everything about how a tech spent their day comes from work_events.
-- Only the "someone else changed it later" metric comes from neighbor_pairs.
-- ============================================================================


-- ----------------------------------------------------------------------------
-- 0. Helpers
-- ----------------------------------------------------------------------------
create or replace macro miles_between(lat1, lon1, lat2, lon2) as
    round(3959 * 2 * asin(sqrt(
        power(sin(radians(lat2 - lat1) / 2), 2)
        + cos(radians(lat1)) * cos(radians(lat2))
          * power(sin(radians(lon2 - lon1) / 2), 2)
    )), 2);

create or replace macro minutes_between(t1, t2) as
    datediff('second', t1, t2) / 60.0;


-- ----------------------------------------------------------------------------
-- 1. Work events -- the de-fanned target grain
--
--    NOTE ON radius_filter: your filter is `distance_feet <= 7920`. A target
--    with no S4e neighbor within 1.5 mi gets NULL from the left join, and
--    NULL <= 7920 is false, so that target is dropped entirely. Isolated
--    meters disappear from the dataset -- which is exactly the population
--    that would read as "fragmented". Build work_events from `combined`, not
--    from radius_filter, so nothing is lost.
-- ----------------------------------------------------------------------------
create or replace table work_events as
select distinct
    workedby,
    work_date,
    date_trunc('week', cast(work_date as date)) as work_week,
    target_meter                                as meterno,
    target_worked_datetime                      as worked_datetime,
    target_lat                                  as latitude,
    target_lon                                  as longitude,
    target_Hardware_Model                       as hardware_model,
    target_Ticket_Type                          as ticket_type,
    cluster_id,
    lower(target_Hardware_Model) like '%s4e%'   as is_s4e
from combined
where target_worked_datetime is not null
  and workedby               is not null
  and target_meter           is not null;


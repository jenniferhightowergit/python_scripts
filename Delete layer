# Grand Total row
total_annual_pct = (
    100 * ytd_removed / annual_goal
    if annual_goal else 0
)

def total_cell(value, align="right"):
    return (
        f'<td style="padding:13px 10px;'
        f'background:#dceaf7;'
        f'border-bottom:2px solid #9ab8d6;'
        f'text-align:{align};'
        f'color:#17385f;'
        f'font-weight:700;'
        f'font-size:12px;">'
        f'{value}</td>'
    )

grand_total_html = "<tr>"

grand_total_html += total_cell("GRAND TOTAL", align="left")
grand_total_html += total_cell(number(total_population))
grand_total_html += total_cell(number(total_removed))
grand_total_html += total_cell(number(total_remaining))
grand_total_html += total_cell(f"{pct_complete:.1f}%")
grand_total_html += total_cell(number(annual_goal))
grand_total_html += total_cell(number(ytd_removed))
grand_total_html += total_cell(number(monthly_removed))
grand_total_html += total_cell(f"{total_annual_pct:.1f}%")
grand_total_html += total_cell(number(actual_pace, 1))
grand_total_html += total_cell(number(needed_pace, 1))

grand_total_html += "</tr>"





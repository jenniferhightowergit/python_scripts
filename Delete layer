def main() -> None:
    records = calculate_metrics(load_dummy_data())
    OUTPUT_PATH.write_text(render_html(records), encoding='utf-8')
    print(f"Created: {OUTPUT_PATH.resolve()}")
    print(f"Models: {len(records)} (simulated)")



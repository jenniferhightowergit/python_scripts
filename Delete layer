
def outlook_progress_bar(value, color="#3975B8"):
    value = float(value)
    filled = max(0, min(value, 100))
    empty = 100 - filled

    if value >= 100:
        color = "#23856D"

    return f"""
    <table role="presentation"
           width="100%"
           cellpadding="0"
           cellspacing="0"
           style="border-collapse:collapse;">
        <tr>
            <td width="{filled:.1f}%"
                bgcolor="{color}"
                style="height:9px; font-size:1px;">
                &nbsp;
            </td>
            <td width="{empty:.1f}%"
                bgcolor="#E5EAF0"
                style="height:9px; font-size:1px;">
                &nbsp;
            </td>
        </tr>
    </table>
    <div style="font-size:11px; margin-top:4px;">
        {value:.1f}%
    </div>
    """






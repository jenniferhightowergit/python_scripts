WITH scd AS (
  SELECT substr(to_char(trim(mtr.CLIENT_CO_LOCATION_ID)),8,10) esi_loc,
         trim(mtr.CLIENT_MDVC_NUMBER) meter,
         trunc(mtr.EFFECTIVE_DATE) eff_dt
  FROM wacsmdms.vw_scd_meter mtr
),
flagged AS (
  SELECT esi_loc, meter, eff_dt,
         CASE WHEN nvl(LAG(meter) OVER (PARTITION BY esi_loc ORDER BY eff_dt),'~') = meter
              THEN 0 ELSE 1 END is_new
  FROM scd
),
grp AS (
  SELECT esi_loc, meter, eff_dt,
         SUM(is_new) OVER (PARTITION BY esi_loc ORDER BY eff_dt) g
  FROM flagged
)
SELECT esi_loc, meter, MIN(eff_dt) install_date,
       LEAD(MIN(eff_dt)) OVER (PARTITION BY esi_loc ORDER BY MIN(eff_dt)) removal_date
FROM grp GROUP BY esi_loc, meter, g ORDER BY 3;

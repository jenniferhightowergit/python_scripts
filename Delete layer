project_progress AS (
    SELECT
        60607 AS total_s4e,  -- TEMPORARY: replace with KPI source
        COALESCE(SUM(Removed_YTD), 0) AS total_removed
    FROM year_totals
),

dynamic_goals AS (
    SELECT
        y.report_year,

        CASE
            WHEN y.report_year = year(current_date)
                THEN p.annual_goal

            WHEN y.report_year > year(current_date)
                THEN CEIL(
                    GREATEST(
                        pp.total_s4e
                        - pp.total_removed
                        - GREATEST(
                            p.annual_goal - COALESCE(c.Removed_YTD, 0),
                            0
                        ),
                        0
                    ) * 1.0
                    / NULLIF(
                        p.project_end_year - year(current_date),
                        0
                    )
                )

            ELSE p.annual_goal
        END AS Adjusted_Annual_Goal

    FROM years y
    CROSS JOIN params p
    CROSS JOIN project_progress pp
    LEFT JOIN year_totals c
        ON c.REMOVAL_YEAR = year(current_date)
),



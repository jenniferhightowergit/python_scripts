

-- ======================================================================
-- 11. DISTRICT DAY SCORECARD -- changed vs missed, per district per day
--
--    Overlap is handled: the coverage of every stop in the district that
--    day is unioned, then meters are counted once. Two techs working the
--    same block produce one opportunity, not two.
--
--    "Available" = S4e meters within vicinity_mi of at least one stop
--    that district made that day, and still installed as of that date.
--    A meter changed that day IS available (the tech stood on it), so
--    changed + missed = available, with no leftovers.
-- ======================================================================
create or replace table district_day_reach as
select distinct
    s.dgroup,
    s.work_date,
    u.meterno,
    u.removed_date
from work_sequence s
cross join opp_params p
join s4e_universe u
  on floor(u.latitude  / p.grid_deg)::bigint
     between floor(s.latitude  / p.grid_deg)::bigint - 1
         and floor(s.latitude  / p.grid_deg)::bigint + 1
 and floor(u.longitude / p.grid_deg)::bigint
     between floor(s.longitude / p.grid_deg)::bigint - 1
         and floor(s.longitude / p.grid_deg)::bigint + 1
 and miles_between(s.latitude, s.longitude, u.latitude, u.longitude) <= p.vicinity_mi
 and (u.removed_date is null or u.removed_date >= s.work_date);


create or replace table district_day as
with crew as (
    select
        dgroup,
        work_date,
        count(distinct workedby)                                  as techs,
        count(*)                                                  as work_orders,
        count(distinct meterno) filter (where is_s4e)             as s4e_changes_logged
    from work_sequence
    group by dgroup, work_date
),
reach as (
    select
        dgroup,
        work_date,
        count(*)                                                  as s4e_available,
        count(*) filter (where removed_date = work_date)          as s4e_changed,
        count(*) filter (where removed_date is null
                            or removed_date <> work_date)         as s4e_missed
    from district_day_reach
    group by dgroup, work_date
)
select
    c.dgroup,
    c.work_date,
    date_trunc('week', c.work_date)                               as work_week,
    c.techs,
    c.work_orders,
    coalesce(r.s4e_available, 0)                                  as s4e_available,
    coalesce(r.s4e_changed, 0)                                    as s4e_changed,
    coalesce(r.s4e_missed, 0)                                     as s4e_missed,
    round(100.0 * r.s4e_changed / nullif(r.s4e_available, 0), 2)  as pct_captured,
    round(r.s4e_available / nullif(c.techs, 0), 1)                as available_per_tech,
    c.s4e_changes_logged                                          as s4e_changes_logged
from crew c
left join reach r
       on r.dgroup = c.dgroup and r.work_date = c.work_date
order by c.dgroup, c.work_date;



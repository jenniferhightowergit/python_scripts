def build_5yr_plan(con):
    """Was ProjectRanger5YearPlan.py. Intermediates are TEMP tables, not pandas."""
    with step("5-year plan"):
        starting = pd.read_excel(STARTING_LIST_XLSX)
        log.info("Adjusted starting list: %s rows", f"{len(starting):,}")
        con.register("Adjusted_Totals_2025", starting)

        # Same names the original SQL used, so pasted queries keep working
        con.execute("CREATE OR REPLACE TEMP VIEW df_all_mc AS SELECT * FROM meter_effectivedate_change")
        con.execute("CREATE OR REPLACE TEMP VIEW stock2   AS SELECT * FROM stock_inventory")
        con.execute("CREATE OR REPLACE TEMP VIEW assets   AS SELECT * FROM fw_hardware")

        con.execute("""
        CREATE OR REPLACE TEMP TABLE mc_max AS
        SELECT meterno, max(meter_removal_date) AS meter_removal_date
        FROM df_all_mc
        WHERE status = 'INACTIVE'
        GROUP BY meterno
        """)

        con.execute("""
        CREATE OR REPLACE TEMP TABLE base AS
        SELECT
            sl.METERNO,
            mr.meter_removal_date,
            CASE WHEN date_trunc('month', mr.meter_removal_date) = date_trunc('month', current_date)
                 THEN 1 ELSE 0 END AS curr_mo_flag,
            CASE WHEN mr.meter_removal_date <= current_date THEN year(mr.meter_removal_date)  END AS REMOVAL_YEAR,
            CASE WHEN mr.meter_removal_date <= current_date THEN month(mr.meter_removal_date) END AS REMOVAL_MONTH,
            CASE WHEN mr.meter_removal_date <= current_date THEN 1 ELSE 0 END AS isRemoved
        FROM Adjusted_Totals_2025 sl
        LEFT JOIN mc_max mr ON trim(sl.meterno) = mr.meterno
        """)

        overall = con.execute("""
        WITH _all AS (
            SELECT count(DISTINCT meterno) AS Total_S4Es,
                   count(DISTINCT CASE WHEN isremoved = 1 THEN meterno END) AS Total_Removed
            FROM base
        )
        SELECT Total_S4Es, Total_Removed,
               Total_S4Es - Total_Removed AS Total_Remaining,
               Total_Removed / Total_S4Es AS Pct_Complete
        FROM _all
        """).df()
        row = overall.iloc[0]
        log.info("S4Es %s | removed %s | remaining %s | %.1f%% complete",
                 f"{row.Total_S4Es:,}", f"{row.Total_Removed:,}",
                 f"{row.Total_Remaining:,}", row.Pct_Complete * 100)

        # ---------------------------------------------------------------
        # TODO: paste ProjectRanger5YearPlan.py lines ~155-553 here
        #   - any `x = conn.execute(...).df()` that only feeds another query
        #     -> change to con.execute("CREATE OR REPLACE TEMP TABLE x AS ...")
        #   - keep .df() for things you format into the email (report1, etc.)
        # ---------------------------------------------------------------

        stock = con.execute("""
        WITH s4es AS (
            SELECT count(DISTINCT a.meterno) AS NEEDED_AMOUNT, class, form, volt
            FROM base a
            JOIN stock2 rf ON trim(rf.meterno) = trim(a.meterno)
            WHERE isRemoved = 0 AND lower(MFGTYPE) LIKE '%s4e%'
            GROUP BY class, form, volt
        ),
        s4xs AS (
            SELECT count(rf.STOCKNO) AS STOCK_AMOUNT, rf.CLASS, rf.FORM, rf.VOLT
            FROM stock2 rf
            WHERE trim(rf.status) IN ('ST') AND lower(MFGTYPE) LIKE '%s4x%'
            GROUP BY rf.CLASS, rf.FORM, rf.VOLT
        ),
        combined AS (
            SELECT DISTINCT rf.STOCKNO,
                   coalesce(alt.NEEDED_AMOUNT, 0) AS NEEDED_AMOUNT,
                   coalesce(altx.STOCK_AMOUNT, 0) AS STOCK_AMOUNT,
                   rf.CLASS, rf.FORM, rf.VOLT
            FROM stock2 rf
            LEFT JOIN s4es alt ON coalesce(alt.class,'') = coalesce(rf.class,'')
                              AND coalesce(alt.form,'')  = coalesce(rf.form,'')
                              AND coalesce(alt.volt,'')  = coalesce(rf.volt,'')
            LEFT JOIN s4xs altx ON coalesce(altx.class,'') = coalesce(rf.class,'')
                               AND coalesce(altx.form,'')  = coalesce(rf.form,'')
                               AND coalesce(altx.volt,'')  = coalesce(rf.volt,'')
        ),
        test AS (
            SELECT CLASS, FORM, VOLT,
                   max(NEEDED_AMOUNT) AS NEEDED_AMOUNT,
                   sum(STOCK_AMOUNT)  AS STOCK_AMOUNT,
                   string_agg(DISTINCT CAST(stockno AS varchar), ', ') AS STOCKNO
            FROM combined
            GROUP BY CLASS, FORM, VOLT
        )
        SELECT * FROM test
        WHERE NEEDED_AMOUNT + STOCK_AMOUNT <> 0
        ORDER BY stockno
        """).df()

        # TODO: paste the rest (stock_clean, HTML build, send_report) here
        return overall, stock



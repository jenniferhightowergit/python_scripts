import logging

from database import init_tables
from settings import get_settings

DEFAULT_N = 100

# Reads up to n work orders that are NOT in training_orders and have cleaned text.
# One row per (wr_id, fa_id): the most recently updated order, with every field needed
# for both training_orders and training_cleaned_text.
NEW_ORDERS_SQL = '''
select
    wr_id,
    fa_id,
    wr_status_upd_dttm,
    comments,
    instructions,
    cleaned_comments,
    cleaned_instructions
from (
    select
        o.wr_id,
        o.fa_id,
        o.wr_status_upd_dttm,
        coalesce(o.comments, '')              as comments,
        coalesce(o.instructions, '')          as instructions,
        coalesce(ct.cleaned_comments, '')     as cleaned_comments,
        coalesce(ct.cleaned_instructions, '') as cleaned_instructions,
        row_number() over (
            partition by o.wr_id, o.fa_id
            order by o.wr_status_upd_dttm desc, o.order_id desc
        ) as rn
    from orders o
    join cleaned_text ct
      on ct.order_id = o.order_id
    where o.wr_id is not null
      and o.fa_id is not null
      and not exists (
          select 1 from training_orders t
          where t.wr_id = o.wr_id
            and t.fa_id = o.fa_id
      )
) as candidates
where rn = 1
order by wr_status_upd_dttm
{limit}
'''

ORDER_COLS = ['wr_id', 'fa_id', 'wr_status_upd_dttm', 'comments', 'instructions']
TEXT_COLS = ['training_order_id', 'cleaned_comments', 'cleaned_instructions']


def run(n: int | None = DEFAULT_N) -> int:
    '''
    Append new work orders and their cleaned text to the training tables.

    1. Read up to n orders (with cleaned text) that are not already in training_orders
    2. Insert them into training_orders
    3. Insert their cleaned text into training_cleaned_text, keyed on the new training_order_id
    '''
    logging.info('started: append_training_orders pipeline')
    tables = init_tables(get_settings())

    limit = f'limit {int(n)}' if n else ''
    df_orders = tables.select(NEW_ORDERS_SQL.format(limit=limit))

    if df_orders.empty:
        logging.info('no new orders to append to "training_orders"')
        logging.info('finished: append_training_orders pipeline')
        return 0

    tables.training_orders.insert(df_orders[ORDER_COLS])
    logging.info(f'inserted: {len(df_orders):,} records to "training_orders"')

    # training_order_id is assigned on insert, so look it up to key the text rows
    df_ids = tables.select('select training_order_id, wr_id, fa_id from training_orders')
    df_text = df_orders.merge(df_ids, on=['wr_id', 'fa_id'])[TEXT_COLS]

    tables.training_cleaned_text.insert(df_text)
    logging.info(f'inserted: {len(df_text):,} records to "training_cleaned_text"')

    logging.info('finished: append_training_orders pipeline')
    return len(df_orders)

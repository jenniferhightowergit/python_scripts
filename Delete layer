def draw_group_header(text, x, y, width, font_size=5.5):
    """Draw a centered, wrapped group name inside one column."""
    from reportlab.lib.utils import simpleSplit

    text = str(text).strip()

    lines = simpleSplit(
        text,
        "Helvetica",
        font_size,
        max(width - 6, 5)
    )

    # Maximum three lines
    lines = lines[:3]

    c.setFont("Helvetica", font_size)

    for i, line in enumerate(lines):
        c.drawCentredString(
            x + width / 2,
            y - i * font_size * 1.2,
            line
        )



"""Generate a four-page landscape-legal AMS hardware report from four pandas pivots."""
from datetime import datetime
from pathlib import Path
from xml.sax.saxutils import escape

import pandas as pd
from reportlab.lib import colors
from reportlab.lib.pagesizes import legal, landscape
from reportlab.pdfbase.pdfmetrics import stringWidth
from reportlab.pdfgen import canvas

NAVY = colors.HexColor('#173B56')
PALE = colors.HexColor('#F0F5F8')
LINE = colors.HexColor('#9DB9CC')
TEXT = colors.HexColor('#263746')
PAGE_W, PAGE_H = landscape(legal)


def create_hardware_pdf(fsr, meter_tech, fsr_ir, meter_tech_ir,
                        output_path='Hardware_Distribution_Report.pdf',
                        report_date=None):
    """Build one landscape legal page per pivot, with dynamic headers and totals.

    Raises ValueError if a table cannot fit legibly on one page.
    """
    report_date = report_date or datetime.now().strftime('%B %d, %Y')
    tables = [
        ('01 | FSR/SSR Distribution', fsr),
        ('02 | Meter Tech Distribution', meter_tech),
        ('03 | FSR/SSR - Instrument Rated', fsr_ir),
        ('04 | Meter Tech - Instrument Rated', meter_tech_ir),
    ]
    # All pivots should reconcile to the same meter population.
    totals = [int(df['Grand Total'].sum()) for _, df in tables]
    if len(set(totals)) != 1:
        raise ValueError(f'Pivot totals disagree: {dict(zip([t for t, _ in tables], totals))}')

    path = Path(output_path).resolve()
    c = canvas.Canvas(str(path), pagesize=(PAGE_W, PAGE_H))
    c.setTitle('AMS Hardware Distribution Report')

    margin = 25
    usable_w = PAGE_W - 2 * margin
    for page_num, (title, df) in enumerate(tables, start=1):
        ir = 'INSTR_RATED' in df.columns
        data = df.reset_index(drop=True).copy()
        if data.empty:
            raise ValueError(f'No data for {title}')
        cols = list(data.columns)
        numeric = [col for col in cols if pd.api.types.is_numeric_dtype(data[col])]
        if 'Grand Total' not in numeric:
            raise ValueError(f'Missing numeric Grand Total column in {title}')

        # Data rows plus one total row. No fixed category/model assumptions.
        records = []
        for _, row in data.iterrows():
            records.append([f'{int(row[col]):,}' if col in numeric else
                            ('' if pd.isna(row[col]) else str(row[col])) for col in cols])
        grand = ['Grand Total' if col == cols[0] else
                 f'{int(data[col].sum()):,}' if col in numeric else '' for col in cols]
        records.append(grand)

        c.setFillColor(NAVY)
        c.rect(0, PAGE_H - 60, PAGE_W, 60, fill=1, stroke=0)
        c.setFillColor(colors.white)
        c.setFont('Helvetica-Bold', 17)
        c.drawString(margin, PAGE_H - 29, 'AMS Hardware Distribution Report')
        c.setFont('Helvetica', 9)
        c.drawString(margin, PAGE_H - 46, f'{report_date}  |  Total Meters: {totals[0]:,}')
        c.setFillColor(NAVY)
        c.setFont('Helvetica-Bold', 13)
        c.drawString(margin, PAGE_H - 84, title)

        top = PAGE_H - 99
        bottom = 35
        header_h = 32
        available_h = top - bottom - header_h
        row_h = min(25 if len(cols) < 10 else 22, available_h / len(records))
        if row_h < 10:
            raise ValueError(f'{title}: {len(records)} rows cannot fit legibly on one page')

        # Fit all columns into the printable width, reserving space for model names.
        fixed = [0, 1] if ir else [0]
        first_w = 155 if len(cols) < 10 else 117
        second_w = 48 if ir else 0
        total_w = 76
        fixed_widths = {0: first_w, cols.index('Grand Total'): total_w}
        if ir:
            fixed_widths[1] = second_w
        remaining = usable_w - sum(fixed_widths.values())
        flexible = len(cols) - len(fixed_widths)
        if flexible <= 0 or remaining <= 0:
            raise ValueError(f'{title}: invalid column layout')
        widths = [fixed_widths.get(i, remaining / flexible) for i in range(len(cols))]
        font = min(9 if len(cols) < 10 else 7.1, (remaining / flexible) / 6.2)
        if font < 5.5:
            raise ValueError(f'{title}: too many columns to fit legibly on legal landscape')

        def draw_text(txt, x, y, width, align='left', bold=False, max_font=None):
            size = max_font or font
            face = 'Helvetica-Bold' if bold else 'Helvetica'
            txt = str(txt)
            # Fit long labels on at most two lines in the model column.
            if align == 'left' and stringWidth(txt, face, size) > width - 8:
                words = txt.split()
                lines = []
                current = ''
                for word in words:
                    candidate = (current + ' ' + word).strip()
                    if current and stringWidth(candidate, face, size) > width - 8:
                        lines.append(current)
                        current = word
                    else:
                        current = candidate
                if current:
                    lines.append(current)
                if len(lines) > 2:
                    while stringWidth(lines[1] + '...', face, size) > width - 8:
                        lines[1] = lines[1][:-1]
                    lines = [lines[0], lines[1] + '...']
                for j, line in enumerate(lines[:2]):
                    c.setFont(face, size)
                    c.drawString(x + 4, y + (len(lines[:2]) - 1 - j) * size * .62, line)
                return
            while size > 5 and stringWidth(txt, face, size) > width - 8:
                size -= .25
            c.setFont(face, size)
            if align == 'right':
                c.drawRightString(x + width - 4, y, txt)
            else:
                c.drawString(x + 4, y, txt)

        # Header
        c.setFillColor(NAVY)
        c.rect(margin, top - header_h, usable_w, header_h, fill=1, stroke=0)
        x = margin
        for col, w in zip(cols, widths):
            c.setFillColor(colors.white)
            label = str(col).replace('_', ' ')
            if label == 'Grand Total':
                label = 'GRAND TOTAL'
            draw_text(label, x, top - header_h / 2 - 3, w,
                      align='right' if col in numeric else 'left', bold=True,
                      max_font=min(font, 8))
            x += w

        y = top - header_h
        group_num = -1
        prev_model = None
        for i, values in enumerate(records):
            is_total = i == len(records) - 1
            model = values[0]
            new_group = ir and model != prev_model
            if new_group:
                group_num += 1
            shade = (group_num % 2 == 0) if ir else (i % 2 == 1)
            bg = colors.HexColor('#DCEAF2') if is_total else PALE if shade else colors.white
            c.setFillColor(bg)
            c.rect(margin, y - row_h, usable_w, row_h, fill=1, stroke=0)
            if (new_group and i > 0) or is_total:
                c.setStrokeColor(NAVY if is_total else LINE)
                c.setLineWidth(1.2 if is_total else .8)
                c.line(margin, y, margin + usable_w, y)
            x = margin
            for col, val, w in zip(cols, values, widths):
                c.setFillColor(TEXT)
                draw_text(val, x, y - row_h / 2 - font * .33, w,
                          align='right' if col in numeric else 'left',
                          bold=is_total or (new_group and col == cols[0]))
                x += w
            prev_model = model
            y -= row_h

        c.setStrokeColor(LINE)
        c.setLineWidth(.5)
        c.line(margin, 25, PAGE_W - margin, 25)
        c.setFont('Helvetica', 8)
        c.setFillColor(TEXT)
        c.drawString(margin, 13, 'AMS Operations | Hardware Counts by DGROUP')
        c.drawRightString(PAGE_W - margin, 13, f'Page {page_num} of {len(tables)}')
        c.showPage()
    c.save()
    return str(path)



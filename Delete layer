select
  case
    when hour(worked_datetime) < 12 then 'Morning'
    when hour(worked_datetime) < 17 then 'Afternoon'
    else 'Evening'
  end as time_block,
  count(*) as meters_removed,
  count(distinct cluster_id) as clusters,
  round(count(*) * 1.0 / count(distinct cluster_id), 1) as meters_per_cluster
from cluster_legs
where outcome in ('PERIODIC TEST', 'CAPTURED SAME DAY')
group by 1 order by 1

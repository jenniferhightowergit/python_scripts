"""
Daily Excel -> Parquet incremental pipeline.

Flow:
1. Scan share drive for .xlsx files modified in the last N days.
2. Parse the "file date" each spreadsheet represents (from filename or a column).
3. Compare each file's mtime against what's already recorded in the parquet
   for that file date.
4. Drop old rows for any file date that has a newer version incoming.
5. Append the new/updated data and write back.

Customize the CONFIG block and the two `extract_*` functions for your
actual filenames/schema, then the rest should work as-is.
"""

import re
import logging
from datetime import datetime, timedelta
from pathlib import Path

import pandas as pd

# --------------------------------------------------------------------------
# CONFIG - edit these
# --------------------------------------------------------------------------
SHARE_DRIVE_PATH = Path(r"\\network\share\path\to\daily_files")  # UNC path
PARQUET_PATH = Path(r"C:\local\path\to\output\data.parquet")     # or local mirror
DAYS_LOOKBACK = 10

# Column in your data that identifies the "file date" this row belongs to
FILE_DATE_COL = "file_date"

# Internal bookkeeping columns we add - won't collide with real columns
SOURCE_MTIME_COL = "_source_mtime"
SOURCE_FILE_COL = "_source_file"

# If the file date is embedded in the filename, e.g. "meter_data_20250715.xlsx"
FILENAME_DATE_REGEX = re.compile(r"(\d{8})")
FILENAME_DATE_FORMAT = "%Y%m%d"

logging.basicConfig(level=logging.INFO, format="%(asctime)s | %(levelname)s | %(message)s")
log = logging.getLogger(__name__)


# --------------------------------------------------------------------------
# Step 1: find recently modified excel files
# --------------------------------------------------------------------------
def get_recent_excel_files(folder: Path, days: int) -> list[Path]:
    cutoff = datetime.now() - timedelta(days=days)
    files = []
    for f in folder.glob("*.xlsx"):
        try:
            mtime = datetime.fromtimestamp(f.stat().st_mtime)
        except OSError as e:
            log.warning(f"Could not stat {f}: {e}")
            continue
        if mtime >= cutoff:
            files.append(f)
    log.info(f"Found {len(files)} excel files modified in last {days} days")
    return files


# --------------------------------------------------------------------------
# Step 2 (helper): figure out the file date + mtime for each file
# --------------------------------------------------------------------------
def extract_file_date_from_name(path: Path):
    """Fallback: pull date from filename. Adjust regex/format above as needed."""
    m = FILENAME_DATE_REGEX.search(path.stem)
    if not m:
        return None
    try:
        return datetime.strptime(m.group(1), FILENAME_DATE_FORMAT).date()
    except ValueError:
        return None


def read_excel_files(files: list[Path]) -> pd.DataFrame:
    """Read all files, tagging each row with its source file + file mtime.
    If FILE_DATE_COL isn't already in the spreadsheet, derive it from filename.
    """
    frames = []
    for f in files:
        try:
            df = pd.read_excel(f)
        except Exception as e:
            log.warning(f"Failed to read {f}: {e}")
            continue

        mtime = datetime.fromtimestamp(f.stat().st_mtime)

        if FILE_DATE_COL not in df.columns:
            file_date = extract_file_date_from_name(f)
            if file_date is None:
                log.warning(f"Could not determine file date for {f}, skipping")
                continue
            df[FILE_DATE_COL] = file_date

        df[SOURCE_MTIME_COL] = mtime
        df[SOURCE_FILE_COL] = f.name
        frames.append(df)

    if not frames:
        return pd.DataFrame()
    return pd.concat(frames, ignore_index=True)


# --------------------------------------------------------------------------
# Step 3/4: merge new data in, dropping stale rows for any file_date
#           that has a newer version now available
# --------------------------------------------------------------------------
def load_existing_parquet(path: Path) -> pd.DataFrame:
    if path.exists():
        df = pd.read_parquet(path)
        log.info(f"Loaded existing parquet: {len(df)} rows")
        return df
    log.info("No existing parquet found, starting fresh")
    return pd.DataFrame()


def merge_and_dedupe(existing_df: pd.DataFrame, new_df: pd.DataFrame) -> pd.DataFrame:
    if new_df.empty:
        log.info("No new data to merge")
        return existing_df

    if existing_df.empty:
        log.info(f"No existing data — using {len(new_df)} new rows as-is")
        return new_df

    # Latest incoming mtime per file_date (in case multiple new files hit the
    # same file_date in this batch, e.g. same day re-saved twice)
    incoming_latest = (
        new_df.groupby(FILE_DATE_COL)[SOURCE_MTIME_COL].max().to_dict()
    )

    updated_file_dates = set(incoming_latest.keys())

    # For file_dates we're about to replace, check whether the incoming
    # version is actually newer than what's already stored. If existing
    # data is newer (unlikely, but possible w/ clock skew or re-runs),
    # don't overwrite it.
    existing_latest = (
        existing_df.groupby(FILE_DATE_COL)[SOURCE_MTIME_COL].max().to_dict()
        if SOURCE_MTIME_COL in existing_df.columns
        else {}
    )

    file_dates_to_replace = set()
    for fd in updated_file_dates:
        old_mtime = existing_latest.get(fd)
        new_mtime = incoming_latest[fd]
        if old_mtime is None or new_mtime > old_mtime:
            file_dates_to_replace.add(fd)
        else:
            log.info(
                f"Skipping file_date {fd}: existing data ({old_mtime}) is same "
                f"age or newer than incoming ({new_mtime})"
            )

    if not file_dates_to_replace:
        log.info("No file_dates were actually newer — nothing replaced")
        return existing_df

    # Drop old rows for file_dates being replaced
    kept_existing = existing_df[~existing_df[FILE_DATE_COL].isin(file_dates_to_replace)]
    dropped_count = len(existing_df) - len(kept_existing)
    log.info(f"Dropping {dropped_count} stale rows for file_dates: {sorted(file_dates_to_replace)}")

    # Only keep the new rows for file_dates we're actually replacing
    # (in case new_df also contains file_dates we decided to skip above)
    new_rows_to_add = new_df[new_df[FILE_DATE_COL].isin(file_dates_to_replace)]

    result = pd.concat([kept_existing, new_rows_to_add], ignore_index=True)
    log.info(f"Added {len(new_rows_to_add)} new rows. Total: {len(result)} rows")
    return result


# --------------------------------------------------------------------------
# Step 5: write back out
# --------------------------------------------------------------------------
def write_parquet(df: pd.DataFrame, path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp_path = path.with_suffix(".tmp.parquet")
    df.to_parquet(tmp_path, index=False)
    tmp_path.replace(path)  # atomic-ish swap so a crash mid-write doesn't corrupt the real file
    log.info(f"Wrote {len(df)} rows to {path}")


# --------------------------------------------------------------------------
# Main
# --------------------------------------------------------------------------
def main():
    recent_files = get_recent_excel_files(SHARE_DRIVE_PATH, DAYS_LOOKBACK)
    if not recent_files:
        log.info("Nothing to do — no recently modified files.")
        return

    new_df = read_excel_files(recent_files)
    existing_df = load_existing_parquet(PARQUET_PATH)
    merged_df = merge_and_dedupe(existing_df, new_df)
    write_parquet(merged_df, PARQUET_PATH)


if __name__ == "__main__":
    main()

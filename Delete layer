"""
Sends (or drafts) the FP / NCM report as an HTML table via your local Outlook
desktop app — no SMTP login required, since it drives the Outlook client
you're already signed into (same pattern as Emir's future_date_meters.py).
"""

import pandas as pd
import win32com.client as win32

# ── CONFIG ────────────────────────────────────────────────────────────────
RECIPIENTS = ["Edmundo.Rodriguez@oncor.com"]   # update as needed
CC         = []                                 # e.g. ["someone@oncor.com"]
SUBJECT    = "FP / NCM Report"
SEND_DIRECTLY = False   # False = leaves it as a draft for you to review/send
                         # True  = sends immediately
# ─────────────────────────────────────────────────────────────────────────


def build_html_table(df: pd.DataFrame) -> str:
    """Convert a dataframe into a simple HTML table for the email body."""
    table_html = df.to_html(index=False, border=0)

    style = """
    <style>
        table { border-collapse: collapse; font-family: Calibri, Arial, sans-serif; font-size: 11pt; }
        th { background-color: #1F4E78; color: white; padding: 6px 10px; text-align: left; }
        td { padding: 6px 10px; border-bottom: 1px solid #ddd; }
        tr:nth-child(even) { background-color: #f2f2f2; }
    </style>
    """

    body = f"""
    <div style='font-family:"Calibri",sans-serif; font-size:11.0pt;'>
        {style}
        Hi,<br><br>
        Here's the latest FP / NCM count:<br><br>
        {table_html}
        <br>
        Let me know if you have any questions.
    </div>
    """
    return body


def send_email(df: pd.DataFrame):
    html_body = build_html_table(df)

    outlook = win32.Dispatch("outlook.application")
    mail = outlook.CreateItem(0)  # 0 = olMailItem
    mail.To = ";".join(RECIPIENTS)
    if CC:
        mail.CC = ";".join(CC)
    mail.Subject = SUBJECT
    mail.HTMLBody = html_body

    if SEND_DIRECTLY:
        mail.Send()
        print("Email sent.")
    else:
        mail.Save()  # saves to Drafts for you to review first
        print("Draft saved in Outlook.")


if __name__ == "__main__":
    # Replace with your actual FP dataframe (e.g. FP.head(20) from your notebook)
    FP = pd.DataFrame({
        "FP": [4226.0],
        "Mc_After_8_5_2026": [0.0]
    })

    send_email(FP)

import pandas as pd
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
from matplotlib.ticker import FuncFormatter


def create_burndown_chart(monthly_removals, total_s4e=76459, output_path='project_ranger_burndown.png'):
    """Create a professional PNG suitable for embedding in the Outlook HTML report.

    monthly_removals: DataFrame with REMOVAL_YEAR, REMOVAL_MONTH, Remaining_S4E.
    The original 76,459 is shown as a separate program baseline, not a Dec 2025 month-end.
    """
    df = monthly_removals.copy()
    df['date'] = pd.to_datetime(dict(year=df['REMOVAL_YEAR'].astype(int), month=df['REMOVAL_MONTH'].astype(int), day=1)) + pd.offsets.MonthEnd(0)
    df = df.sort_values('date').reset_index(drop=True)
    df['Remaining_S4E'] = pd.to_numeric(df['Remaining_S4E'])
    plot_df = df.loc[df['date'] >= pd.Timestamp('2025-12-31')].copy()
    if plot_df.empty:
        raise ValueError('No month-end observations from December 2025 onward.')

    navy, blue, muted = '#174675', '#2873AF', '#62758A'
    fig, ax = plt.subplots(figsize=(11.5, 4.6), dpi=170)
    fig.patch.set_facecolor('white')
    ax.set_facecolor('white')
    x = list(range(len(plot_df)))
    y = plot_df['Remaining_S4E'].to_numpy()
    bottom = max(0, min(y) - 3500)
    ax.fill_between(x, y, bottom, color='#DCECF8', alpha=0.65)
    ax.plot(x, y, color=blue, linewidth=2.8, solid_capstyle='round', zorder=3)
    ax.scatter(x, y, s=22, color='white', edgecolor=blue, linewidth=1.6, zorder=4)
    ax.scatter([x[-1]], [y[-1]], s=88, color=navy, edgecolor='white', linewidth=2, zorder=5)
    ax.annotate(f'{y[0]:,.0f}', (x[0], y[0]), xytext=(5, 13), textcoords='offset points', color=navy, fontsize=10, weight='bold')
    ax.annotate(f'{y[-1]:,.0f}', (x[-1], y[-1]), xytext=(-7, 14), textcoords='offset points', ha='right', color=navy, fontsize=12, weight='bold')
    ax.set_xticks(x)
    ax.set_xticklabels([d.strftime("%b '%y") for d in plot_df['date']], fontsize=8.5, color=muted)
    ax.tick_params(axis='x', length=0, pad=12)
    ax.tick_params(axis='y', length=0, colors=muted, labelsize=9)
    ax.yaxis.set_major_formatter(FuncFormatter(lambda v, _: f'{v/1000:,.0f}k'))
    ax.grid(axis='y', color='#E7EDF3', linewidth=0.9)
    ax.set_axisbelow(True)
    ax.set_ylim(bottom, max(y) + 3200)
    ax.set_xlim(-0.35, len(x) - 0.65)
    for spine in ax.spines.values():
        spine.set_visible(False)
    fig.text(0.085, 0.95, 'S4E INVENTORY BURNDOWN', fontsize=16, color=navy, weight='bold', va='top')
    fig.text(0.085, 0.885, f'Month-end remaining inventory  |  Original program baseline: {total_s4e:,} meters', fontsize=9.5, color=muted, va='top')
    fig.text(0.085, 0.035, 'Source: Project Ranger monthly removals  â¢  Current month reflects reporting-to-date', fontsize=8, color=muted)
    fig.subplots_adjust(left=0.085, right=0.97, bottom=0.19, top=0.79)
    fig.savefig(output_path, dpi=170, facecolor='white')
    plt.close(fig)
    return output_path


def image_as_data_uri(path):
    """For browser HTML previews; Outlook email should use CID attachments instead."""
    with open(path, 'rb') as f:
        return 'data:image/png;base64,' + base64.b64encode(f.read()).decode('ascii')



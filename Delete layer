SELECT
    class,
    form,
    volt,
    COUNT(DISTINCT stockno) AS stock_number_count,
    STRING_AGG(
        DISTINCT CAST(stockno AS VARCHAR),
        ', '
    ) AS stock_numbers,
    SUM(NEEDED_AMOUNT) AS inflated_needed,
    MAX(NEEDED_AMOUNT) AS actual_needed
FROM combined
GROUP BY class, form, volt
HAVING COUNT(DISTINCT stockno) > 1
ORDER BY inflated_needed - actual_needed DESC;

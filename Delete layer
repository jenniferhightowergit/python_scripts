############## ALL TOWN HARDWARE DATA  — optimized
# Two modes:
#   MODE = "full"         -> full refresh, but much faster fetch + no duplicate columns (recommended)
#   MODE = "incremental"  -> pulls only METERNO keys, adds new meters / removes gone meters
#                            (does NOT pick up changed flags on meters that already exist)
import os
import time

import keyring
import pandas as pd
import pyarrow as pa
import pyarrow.compute as pc
import pyarrow.parquet as pq
from sqlalchemy import create_engine, text

MODE = "full"
PARQUET_PATH = r"C:\Users\UMUE\Documents\JensFakeDW\Staging\parquet\ALLTown.parquet"
FETCH_SIZE = 50_000      # rows per network round trip (driver default is ~100 -> thousands of trips)
LOWERCASE_COLS = True    # pd.read_sql via SQLAlchemy lowercased Oracle names in your old file; keep them matching

# Computed columns first, then A.* ONCE.
# The old query listed SERIAL_NBR, MFG_CD, REGTYPE, ... AND A.*, so every one of those
# columns came over the network twice and was then thrown away with columns.duplicated().
FULL_SQL = """
SELECT TRIM(A.SERIAL_NBR) || TRIM(A.MFG_CD) AS METERNO,
       TRUNC(A.MTR_INSTL_D)                AS METER_INSTALL_DATE,
       A.*
FROM RPTUSER.CM_ALL_TOWN A
"""

KEYS_SQL = """
SELECT TRIM(A.SERIAL_NBR) || TRIM(A.MFG_CD) AS METERNO,
       TRIM(A.SERIAL_NBR)                  AS SERIAL_NBR
FROM RPTUSER.CM_ALL_TOWN A
"""

conn_string = keyring.get_password('ods_sqlalchemy', 'connection_string')
engine = create_engine(conn_string, arraysize=FETCH_SIZE)


def log(msg, t0):
    print(f"{msg}: {time.perf_counter() - t0:,.1f}s")


def _clean_names(table: pa.Table) -> pa.Table:
    names = [n.lower() if LOWERCASE_COLS else n for n in table.column_names]
    table = table.rename_columns(names)
    # guard in case A.* ever contains a column with the same name as a computed one
    seen, keep = set(), []
    for i, n in enumerate(names):
        if n not in seen:
            seen.add(n)
            keep.append(i)
    return table.select(keep)


def fetch_arrow(sql, params=None) -> pa.Table:
    """Fetch straight into Arrow (python-oracledb 3.0+), else fall back to pandas."""
    raw = engine.raw_connection()
    try:
        conn = getattr(raw, "driver_connection", None)
        if conn is not None and hasattr(conn, "fetch_df_all"):
            odf = conn.fetch_df_all(statement=sql, parameters=params, arraysize=FETCH_SIZE)
            tbl = pa.Table.from_arrays(odf.column_arrays(), names=odf.column_names())
            return _clean_names(tbl)
    finally:
        raw.close()

    with engine.connect() as c:
        df = pd.read_sql(text(sql), c, params=params)
    return _clean_names(pa.Table.from_pandas(df, preserve_index=False))


def write_atomic(table: pa.Table, path: str):
    tmp = path + ".tmp"
    pq.write_table(table, tmp, compression="snappy")
    os.replace(tmp, path)  # anything reading the file never sees a half-written one


def full_refresh():
    t0 = time.perf_counter()
    tbl = fetch_arrow(FULL_SQL)
    log(f"Fetched {tbl.num_rows:,} rows", t0)
    write_atomic(tbl, PARQUET_PATH)
    log("Wrote parquet", t0)


def apply_key_diff(existing: pa.Table, ora_keys: pa.Table, fetch_rows) -> pa.Table | None:
    """Return the updated table, or None if nothing changed.
    fetch_rows(list_of_serials) -> pa.Table of full rows for those serials."""
    ora_set = set(ora_keys.column("meterno").to_pylist())
    pq_set = set(existing.column("meterno").to_pylist())
    new_meters = ora_set - pq_set
    gone_meters = pq_set - ora_set
    print(f"New: {len(new_meters):,}  Removed: {len(gone_meters):,}")
    if not new_meters and not gone_meters:
        return None

    kept = existing
    if gone_meters:
        mask = pc.is_in(existing.column("meterno"), value_set=pa.array(list(gone_meters)))
        kept = existing.filter(pc.invert(mask))

    if not new_meters:
        return kept

    is_new = pc.is_in(ora_keys.column("meterno"), value_set=pa.array(list(new_meters)))
    serials = sorted(set(ora_keys.filter(is_new).column("serial_nbr").to_pylist()))
    added = fetch_rows(serials)
    # a serial can map to more than one MFG_CD, so keep only the exact new METERNOs
    added = added.filter(pc.is_in(added.column("meterno"), value_set=pa.array(list(new_meters))))
    added = added.select(kept.column_names).cast(kept.schema)
    return pa.concat_tables([kept, added])


def fetch_rows_by_serial(serials, chunk=1000):  # Oracle caps IN lists at 1000
    parts = []
    for i in range(0, len(serials), chunk):
        batch = serials[i:i + chunk]
        binds = ", ".join(f":s{j}" for j in range(len(batch)))
        sql = FULL_SQL + f" WHERE TRIM(A.SERIAL_NBR) IN ({binds})"
        parts.append(fetch_arrow(sql, {f"s{j}": v for j, v in enumerate(batch)}))
    return pa.concat_tables(parts, promote_options="default")


def incremental_sync():
    t0 = time.perf_counter()
    if not os.path.exists(PARQUET_PATH):
        return full_refresh()
    existing = pq.read_table(PARQUET_PATH)
    ora_keys = fetch_arrow(KEYS_SQL)
    log(f"Fetched {ora_keys.num_rows:,} keys", t0)
    updated = apply_key_diff(existing, ora_keys, fetch_rows_by_serial)
    if updated is None:
        log("No changes, parquet left as is", t0)
        return
    write_atomic(updated, PARQUET_PATH)
    log(f"Wrote parquet ({updated.num_rows:,} rows)", t0)


if __name__ == "__main__":
    full_refresh() if MODE == "full" else incremental_sync()

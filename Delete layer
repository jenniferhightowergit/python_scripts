"""
Sample pattern: narrow geo-join first, widen with extra columns after.

The core idea:
  1. Build the smallest possible "candidates" table -- just the columns
     needed for the grid-bucket + haversine distance calc (meterno,
     esi_loc, removal date, lat, lon, grid cells). NOT hardware model,
     NOT workedby, NOT anything else yet.
  2. Join that narrow table to population, apply the grid-bucket filter
     AND a real radius/distance cutoff. This keeps row counts small at
     the one step that's actually expensive (the many-to-many geo join).
  3. Only AFTER that filtered result exists, join back to asset /
     work_orders to attach the extra descriptive columns you want in
     the final output. Joining wide tables happens last, on a small
     row count, instead of first, on a huge one.

Replace table/column names with your actual schema as needed.
"""

import duckdb

con = duckdb.connect()
con.register("prev_meter_history", prev_meter_history)
con.register("location_df", location_df)
con.register("population", population)
con.register("asset", asset)
con.register("work_orders", work_orders)

WALK_RADIUS_MILES = 1.0   # <-- set to whatever your actual radius of interest is
GRID_SIZE = 0.02          # must be >= WALK_RADIUS_MILES in degrees-equivalent;
                           # 0.02 deg ~= 1.4 miles, safely covers a 1-mile radius

query = f"""
WITH params AS (
    SELECT {WALK_RADIUS_MILES} AS walk_radius_miles,
           {GRID_SIZE} AS grid_size
),

-- ---------------------------------------------------------------
-- STEP 1: narrow "hist" table -- geo columns only, nothing wide yet
-- ---------------------------------------------------------------
hist_narrow AS (
    SELECT DISTINCT
        hist.meterno,
        hist.esi_loc,
        CAST(hist.meter_removal_date AS DATE) AS meter_removal_date,
        loc.latitude,
        loc.longitude,
        FLOOR(loc.latitude  / (SELECT grid_size FROM params)) AS lat_grid,
        FLOOR(loc.longitude / (SELECT grid_size FROM params)) AS lon_grid
    FROM prev_meter_history hist
    JOIN location_df loc
        ON loc.esi_loc = hist.esi_loc
    WHERE hist.CURRENT_METER_FLAG = 'CURRENT_METER'
      AND loc.latitude IS NOT NULL
      AND loc.longitude IS NOT NULL
),

-- ---------------------------------------------------------------
-- STEP 2: narrow "population" (candidate B meters) table
-- ---------------------------------------------------------------
pop_narrow AS (
    SELECT DISTINCT
        pop.meterno,
        CAST(pop.meter_removal_date AS DATE) AS meter_removal_date,
        pop.latitude,
        pop.longitude,
        FLOOR(pop.latitude  / (SELECT grid_size FROM params)) AS lat_grid,
        FLOOR(pop.longitude / (SELECT grid_size FROM params)) AS lon_grid
    FROM population pop
    WHERE pop.latitude IS NOT NULL
      AND pop.longitude IS NOT NULL
),

-- expand hist_narrow to its own grid cell + 8 neighbors, so points near
-- a cell boundary still find true neighbors in the adjacent cell
hist_expanded AS (
    SELECT
        h.*,
        h.lat_grid + offset_lat AS search_lat_grid,
        h.lon_grid + offset_lon AS search_lon_grid
    FROM hist_narrow h
    CROSS JOIN (
        SELECT unnest([-1,-1,-1, 0,0,0, 1,1,1]) AS offset_lat,
               unnest([-1, 0, 1,-1,0,1,-1,0,1]) AS offset_lon
    ) offsets
),

-- ---------------------------------------------------------------
-- STEP 3: cheap equality join on grid cells, THEN real distance
--         filter -- this is the step that was exploding before
-- ---------------------------------------------------------------
matched_narrow AS (
    SELECT * FROM (
        SELECT
            h.meterno       AS meter_a,
            h.esi_loc       AS location_a,
            h.meter_removal_date AS removal_date_a,
            h.latitude      AS latitude_a,
            h.longitude     AS longitude_a,
            p.meterno       AS meter_b,
            p.meter_removal_date AS removal_date_b,
            p.latitude      AS latitude_b,
            p.longitude     AS longitude_b,
            3959 * 2 * ASIN(SQRT(
                POWER(SIN(RADIANS(p.latitude - h.latitude) / 2), 2)
                + COS(RADIANS(h.latitude)) * COS(RADIANS(p.latitude))
                * POWER(SIN(RADIANS(p.longitude - h.longitude) / 2), 2)
            )) AS distance_miles
        FROM hist_expanded h
        JOIN pop_narrow p
            ON p.lat_grid = h.search_lat_grid
           AND p.lon_grid = h.search_lon_grid
           AND (p.meter_removal_date >= h.meter_removal_date OR p.meter_removal_date IS NULL)
           AND p.meterno <> h.meterno
    )
    -- THE MISSING PIECE: actual radius cutoff, applied right here,
    -- before this ever gets wide or gets deduplicated/sorted
    WHERE distance_miles <= (SELECT walk_radius_miles FROM params)
),

-- de-duplicate now, on a NARROW set of key columns only (not 15+ wide
-- columns) -- much cheaper than DISTINCT on the full wide row later
matched_dedup AS (
    SELECT DISTINCT meter_a, location_a, removal_date_a, latitude_a, longitude_a,
                     meter_b, removal_date_b, latitude_b, longitude_b, distance_miles
    FROM matched_narrow
)

-- ---------------------------------------------------------------
-- STEP 4: NOW widen -- join back to asset / work_orders, only on
--         the small, already-filtered result set
-- ---------------------------------------------------------------
SELECT
    m.*,
    hw.revisionid AS hardware_model,
    wo.workedby,
    wo.wr_workeddate
FROM matched_dedup m
LEFT JOIN asset hw
    ON hw.meterno = m.meter_a
LEFT JOIN work_orders wo
    ON TRIM(wo.esi_loc) = m.location_a
   AND CAST(wo.meter_removal_date AS DATE) = m.removal_date_a
   AND wo.workedby <> 'XAIUSER'
ORDER BY m.meter_a, m.distance_miles
"""

result_df = con.execute(query).df()
print(f"{len(result_df):,} rows")

BASE_DIR = Path(__file__).resolve().parent
DATA_DIR = BASE_DIR / "data"
LOG_DIR = BASE_DIR / "logs"
DB_PATH = DATA_DIR / "ranger.duckdb"
STARTING_LIST_XLSX = BASE_DIR / "Adjusted_Starting_List.xlsx"

KEYRING_ODS = "ods_sqlalchemy"
KEYRING_EDW = "edw_sqlalchemy"
KEYRING_USER = "connection_string"

ORACLE_ARRAYSIZE = 50_000   # rows per network round trip (driver default is 100)
EXPORT_PARQUET = False      # True = also write each source table to data/*.parquet

DATA_DIR.mkdir(exist_ok=True)
LOG_DIR.mkdir(exist_ok=True)

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s  %(levelname)-7s %(threadName)-12s %(message)s",
    handlers=[

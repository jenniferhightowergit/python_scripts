        text-align:center;
        white-space:nowrap;
        font-size:11px;
    ">{escape(str(h))}</th>
    """
    for h in headers
)

body_rows = []

previous_model = None

for (model, rated), row in hardware_pivot.iterrows():

    is_total = model == "Grand Total"

    background = (
        "#DCE8F2" if is_total
        else "#F2F6FA" if rated == "Y"
        else "#FFFFFF"
    )

    weight = "bold" if is_total else "normal"

    # Show hardware model only once for consecutive rows
    model_display = (
        model if model != previous_model or is_total else ""
    )
    previous_model = model

    cells = [
        f"""
        <td style="
            padding:7px 9px;
            border:1px solid #dce3e9;
            text-align:left;
            font-weight:{weight};
            white-space:nowrap;
        ">{escape(str(model_display))}</td>
        """,
        f"""
        <td style="
            padding:7px;
            border:1px solid #dce3e9;
            text-align:center;
            font-weight:{weight};
        ">{escape(str(rated))}</td>
        """
    ]

    for value in row:
        cells.append(
            f"""
            <td style="
                padding:7px;
                border:1px solid #dce3e9;
                text-align:right;
                font-weight:{weight};
                white-space:nowrap;
            ">{int(value):,}</td>
            """
        )

    body_rows.append(
        f'<tr style="background-color:{background};">'
        + "".join(cells)
        + "</tr>"
    )


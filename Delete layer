import win32com.client as win32
import pythoncom

def send_report(html_email, pdf_path):
    pythoncom.CoInitialize()

    mail = None
    outlook = None

    try:
        outlook = win32.Dispatch("Outlook.Application")
        mail = outlook.CreateItem(0)

        mail.To = "jennifer.hightower@oncor.com"
        mail.Subject = "[Report] Hardware Counts by DGROUP"

        mail.HTMLBody = html_email

        # Attach the generated landscape PDF
        mail.Attachments.Add(str(pdf_path))

        mail.Send()

        print("Hardware report email submitted to Outlook.")

    finally:
        mail = None
        outlook = None
        pythoncom.CoUninitialize()


send_report(html_email, pdf_path)



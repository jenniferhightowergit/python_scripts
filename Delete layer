import numpy as np
import pandas as pd
from sklearn.linear_model import LinearRegression


def forecast_depletion(df, hardware_col, year_col, removed_col, inventory_col,
                        max_horizon_years=50):

    results = []

    for hardware, group in df.groupby(hardware_col):

        group = group.sort_values(year_col).copy()

        # Starting inventory
        inventory = group[inventory_col].iloc[0]

        # Historical cumulative removals
        group["cumulative_removed"] = group[removed_col].cumsum()

        # Remaining inventory today
        remaining = inventory - group["cumulative_removed"].iloc[-1]

        # Create simple year index
        group["year_index"] = np.arange(len(group))

        X = group[["year_index"]]

        # Fit on log(removed) instead of raw removed. Your removal counts
        # decline by a roughly constant PERCENTAGE each year (198k -> 138k
        # -> 103k -> 77k -> 64k -> 52k -> 33k, each ~65-90% of the prior
        # year), not a constant fixed amount. A plain linear fit on the raw
        # numbers assumes the same fixed-dollar drop continues forever,
        # which overshoots past zero almost immediately on a steep
        # declining series. Fitting log(y) = mx + b instead captures the
        # percentage decline correctly; predictions convert back with exp().
        y_log = np.log(group[removed_col].clip(lower=1))  # avoid log(0)

        model = LinearRegression()
        model.fit(X, y_log)

        year = int(group[year_col].max())
        year_index = len(group)
        years_elapsed = 0

        while remaining > 0 and years_elapsed < max_horizon_years:

            year += 1
            years_elapsed += 1

            predicted_log = model.predict(
                pd.DataFrame({"year_index": [year_index]})
            )[0]
            predicted_removals = np.exp(predicted_log)

            # An exponential decay curve never actually hits 0 or goes
            # negative, so it can shrink forever without ever finishing
            # the job. Treat "less than 1 meter/year" as effectively done
            # to keep the loop from running to max_horizon_years on a
            # long tail of near-zero removals.
            if predicted_removals < 1:
                results.append({
                    "hardware_type": hardware,
                    "year": year,
                    "projected_removals": 0,
                    "projected_remaining_inventory": round(remaining),
                    "note": "Trend flattened to 0/year before inventory "
                            "was exhausted — depletion stalls here at "
                            "current trend.",
                })
                break

            # Can't remove more meters than exist
            actual_projected_removal = min(predicted_removals, remaining)

            remaining -= actual_projected_removal

            results.append({
                "hardware_type": hardware,
                "year": year,
                "projected_removals": round(actual_projected_removal),
                "projected_remaining_inventory": round(remaining),
                "note": "",
            })

            year_index += 1

        else:
            # while loop exited because remaining hit 0 - nothing extra
            # needed, but if it exited because max_horizon_years was hit
            # while remaining is still > 0, flag that too.
            if remaining > 0:
                results.append({
                    "hardware_type": hardware,
                    "year": year,
                    "projected_removals": 0,
                    "projected_remaining_inventory": round(remaining),
                    "note": f"Did not reach zero within {max_horizon_years} "
                            f"year horizon at current trend.",
                })

    return pd.DataFrame(results)


import geopandas as gpd
import matplotlib.pyplot as plt
import numpy as np
import shapely

from shapely.geometry import MultiPoint
from shapely.ops import unary_union

# ============================================================
# 1. SETTINGS
# ============================================================

AREA_COL = "op_area"

# Buffer distance around meters, in meters
BUFFER_DISTANCE = 3000

OUTPUT_FILE = "op_area_buffered_boundaries.geojson"

# ============================================================
# 2. PREPARE METER LOCATIONS
# ============================================================

# Uses the meters GeoDataFrame from our previous script
meters = meters.to_crs("EPSG:5070").copy()

meters = meters.dropna(
    subset=[AREA_COL]
)

# Remove duplicate coordinates for Voronoi generation.
# If multiple op areas share a coordinate, choose the
# most common label, with alphabetical tie-breaking.
meters["x"] = meters.geometry.x
meters["y"] = meters.geometry.y

point_labels = (
    meters.groupby(["x", "y", AREA_COL])
    .size()
    .reset_index(name="n")
    .sort_values(
        ["x", "y", "n", AREA_COL],
        ascending=[True, True, False, True]
    )
    .drop_duplicates(["x", "y"])
)

unique_meters = gpd.GeoDataFrame(
    point_labels,
    geometry=gpd.points_from_xy(
        point_labels["x"],
        point_labels["y"]
    ),
    crs=meters.crs
).reset_index(drop=True)

print(f"Unique meter locations: {len(unique_meters):,}")

# ============================================================
# 3. BUILD BUFFERED METER FOOTPRINT
# ============================================================

# Buffer every meter
meter_buffers = meters.geometry.buffer(
    BUFFER_DISTANCE
)

# Merge overlapping buffers
footprint_geom = shapely.union_all(
    meter_buffers.values
)

footprint = gpd.GeoDataFrame(
    geometry=[footprint_geom],
    crs=meters.crs
)

print("Buffered meter footprint created.")

# ============================================================
# 4. CREATE VORONOI PARTITION
# ============================================================

# Create Voronoi cells from meter locations
points = MultiPoint(
    list(unique_meters.geometry)
)

# Voronoi diagram; ordered=True associates cells with
# the original point order (Shapely 2.1+/GEOS 3.12+)
voronoi = shapely.voronoi_polygons(
    points,
    extend_to=footprint_geom.envelope,
    ordered=True
)

cells = list(voronoi.geoms)

voronoi_gdf = gpd.GeoDataFrame(
    {
        AREA_COL: unique_meters[AREA_COL].values
    },
    geometry=cells,
    crs=meters.crs
)

# ============================================================
# 5. CLIP VORONOI CELLS TO BUFFERED FOOTPRINT
# ============================================================

clipped = gpd.clip(
    voronoi_gdf,
    footprint
)

# Merge all cells belonging to the same op area
boundaries = (
    clipped
    .dissolve(by=AREA_COL)
    .reset_index()
)

# Repair geometries
boundaries["geometry"] = (
    boundaries.geometry.make_valid()
)

print(f"Operational areas: {len(boundaries)}")

# ============================================================
# 6. EXPORT TO GEOJSON
# ============================================================

boundaries_export = boundaries.to_crs("EPSG:4326")

boundaries_export.to_file(
    OUTPUT_FILE,
    driver="GeoJSON"
)

print(f"Saved: {OUTPUT_FILE}")

# ============================================================
# 7. PLOT THE RESULT
# ============================================================

fig, ax = plt.subplots(figsize=(16, 12))

boundaries.plot(
    ax=ax,
    column=AREA_COL,
    cmap="tab20",
    edgecolor="black",
    linewidth=0.5,
    alpha=0.65,
    legend=True
)

meters.plot(
    ax=ax,
    color="black",
    markersize=0.2,
    alpha=0.12
)

ax.set_title(
    "Operational Areas - Buffered Meter Footprints",
    fontsize=16
)

ax.set_axis_off()

plt.tight_layout()
plt.show()

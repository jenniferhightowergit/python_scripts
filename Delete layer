def train_comment_classifier(
    df,
    comment_col,
    instructions_col,
    label_cols,
    threshold=0.70,
    test_size=0.20,
    random_state=42
):
    import pandas as pd

    from sklearn.model_selection import train_test_split
    from sklearn.pipeline import Pipeline
    from sklearn.feature_extraction.text import TfidfVectorizer
    from sklearn.multiclass import OneVsRestClassifier
    from sklearn.linear_model import LogisticRegression
    from sklearn.metrics import classification_report

    df = df.copy()

    df["model_text"] = (
        df[comment_col].fillna("").astype(str)
        + " "
        + df[instructions_col].fillna("").astype(str)
    )

    df = df.dropna(subset=["model_text"])

    X = df["model_text"]
    y = df[label_cols].fillna(0).astype(int)

    X_train, X_test, y_train, y_test = train_test_split(
        X,
        y,
        test_size=test_size,
        random_state=random_state
    )

    model = Pipeline([
        ("tfidf", TfidfVectorizer(
            ngram_range=(1, 3),
            min_df=2,
            max_df=0.90
        )),
        ("clf", OneVsRestClassifier(
            LogisticRegression(
                max_iter=1000,
                class_weight="balanced"
            )
        ))
    ])

    model.fit(X_train, y_train)

    y_prob = model.predict_proba(X_test)
    y_pred = (y_prob >= threshold).astype(int)

    if len(label_cols) == 1:
        report = classification_report(
            y_test.values.ravel(),
            y_pred.ravel(),
            target_names=[f"NOT_{label_cols[0]}", label_cols[0]]
        )
    else:
        report = classification_report(
            y_test,
            y_pred,
            target_names=label_cols
        )

    print(report)

    results = pd.DataFrame({
        "model_text": X_test.values
    })

    for i, col in enumerate(label_cols):
        results[f"actual_{col}"] = y_test[col].values
        results[f"pred_{col}"] = y_pred[:, i]
        results[f"score_{col}"] = y_prob[:, i].round(3)

    return model, results

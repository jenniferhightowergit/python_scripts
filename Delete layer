import pandas as pd
import numpy as np
from sklearn.cluster import DBSCAN

pts = conn.execute("""
    select distinct workedby, work_date, meterno, latitude, longitude
    from for_mapping
""").df()

EPS_MILES = 0.25          # points within ~1/4 mile chain together
EARTH_MI  = 3959.0

labeled = []
for (tech, day), g in pts.groupby(['workedby', 'work_date']):
    coords = np.radians(g[['latitude', 'longitude']].to_numpy())
    db = DBSCAN(
        eps=EPS_MILES / EARTH_MI,
        min_samples=2,
        metric='haversine'
    ).fit(coords)
    g = g.copy()
    g['cluster_id'] = [
        f"{tech}_{day}_{lbl}" if lbl >= 0 else f"{tech}_{day}_solo{i}"
        for i, lbl in enumerate(db.labels_)
    ]
    labeled.append(g)

clusters = pd.concat(labeled)
conn.register('meter_clusters', clusters)


select cluster_id, count(*) as meters,
  round(max(latitude) - min(latitude), 4) as lat_spread
from meter_clusters
where workedby = 'U5T5' and work_date = '2026-05-07'
group by 1 order by 2 desc


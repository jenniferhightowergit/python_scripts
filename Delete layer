def main():
    t0 = time.perf_counter()
    log.info("=== Project Ranger refresh starting (db: %s) ===", DB_PATH)
    con = duckdb.connect(str(DB_PATH))
    try:
        pull_sources(con)
        build_meter_effectivedate_change(con)
        build_5yr_plan(con)
        build_status_report_by_dgroup(con)
    finally:
        con.close()
    log.info("=== Finished in %.1f min ===", (time.perf_counter() - t0) / 60)


if __name__ == "__main__":
    try:
        main()
    except Exception:
        log.exception("RUN FAILED")
        sys.exit(1)

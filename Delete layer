import duckdb

source_path = (
    r"\\server\share\folder"
    r"\estimating.parquet"
    r"\**\*.parquet"
)

output_path = (
    r"\\server\share\folder"
    r"\estimating_partitioned.parquet"
)

conn = duckdb.connect()

conn.execute("""
COPY
(
    SELECT
        * REPLACE (
            CAST(file_date AS DATE) AS file_date
        )
    FROM read_parquet(
        ?,
        union_by_name = true
    )
)
TO ?
(
    FORMAT PARQUET,
    PARTITION_BY (file_date),
    COMPRESSION ZSTD,
    OVERWRITE_OR_IGNORE false
)
""", [source_path, output_path])

conn.close()

print("Done.")

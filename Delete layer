def write_orders(df):

    orders_df = df[
        [
            "WR_ID",
            "FA_ID",
            "WR_STATUS_UPD_DTTM",
            "COMMENTS",
            "INSTRUCTIONS"
        ]
    ].copy()

    orders_df = orders_df.drop_duplicates(
        subset=["WR_ID", "FA_ID"]
    )

    with db.connect() as conn:
        conn.register("orders_df", orders_df)

        try:
            conn.execute("""
                INSERT INTO orders (
                    wr_id,
                    fa_id,
                    wr_status_upd_dttm,
                    comments,
                    instructions
                )

                SELECT
                    WR_ID,
                    FA_ID,
                    WR_STATUS_UPD_DTTM,
                    COMMENTS,
                    INSTRUCTIONS

                FROM orders_df src

                WHERE NOT EXISTS (
                    SELECT 1
                    FROM orders tgt
                    WHERE tgt.wr_id = src.WR_ID
                      AND tgt.fa_id = src.FA_ID
                );
            """)

        finally:
            conn.unregister("orders_df")


def write_preprocessed_orders(df):

    cleaned_df = df[
        [
            "WR_ID",
            "FA_ID",
            "cleaned_comments",
            "cleaned_instructions"
        ]
    ].copy()

    cleaned_df = cleaned_df.drop_duplicates(
        subset=["WR_ID", "FA_ID"]
    )

    with db.connect() as conn:
        conn.register("cleaned_df", cleaned_df)

        try:
            conn.execute("""
                INSERT INTO cleaned_text (
                    order_id,
                    cleaned_comments,
                    cleaned_instructions
                )

                SELECT
                    o.order_id,
                    c.cleaned_comments,
                    c.cleaned_instructions

                FROM cleaned_df c

                INNER JOIN orders o
                    ON o.wr_id = c.WR_ID
                   AND o.fa_id = c.FA_ID

                WHERE NOT EXISTS (
                    SELECT 1
                    FROM cleaned_text ct
                    WHERE ct.order_id = o.order_id
                );
            """)

        finally:
            conn.unregister("cleaned_df")

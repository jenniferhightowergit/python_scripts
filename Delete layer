plt.rcParams["font.family"] = ["Arial", "DejaVu Sans"]


def create_burndown_chart(monthly_removals, total_s4e=76459,
                          output_path="project_ranger_burndown.png"):
    """Chart body only. Title, subtitle and source line live in the
    email HTML so they match the other sections."""
    df = monthly_removals.copy()
    df["date"] = pd.to_datetime(dict(
        year=df["REMOVAL_YEAR"].astype(int),
        month=df["REMOVAL_MONTH"].astype(int),
        day=1,
    )) + pd.offsets.MonthEnd(0)
    df = df.sort_values("date").reset_index(drop=True)
    df["Remaining_S4E"] = pd.to_numeric(df["Remaining_S4E"])
    plot_df = df.loc[df["date"] >= pd.Timestamp("2025-12-31")].copy()
    if plot_df.empty:
        raise ValueError("No month-end observations from December 2025 onward.")

    navy, blue, muted = "#173B59", "#287E9A", "#526477"

    # 900 px wide in the email -> 9.0 x 3.4 in keeps a 900 x 340 look
    fig, ax = plt.subplots(figsize=(9.0, 3.4), dpi=200)
    fig.patch.set_facecolor("white")
    ax.set_facecolor("white")

    x = list(range(len(plot_df)))
    y = plot_df["Remaining_S4E"].to_numpy()
    bottom = max(0, min(y) - 3500)

    ax.fill_between(x, y, bottom, color="#E8EFF5", alpha=1.0)
    ax.plot(x, y, color=blue, linewidth=2.4, solid_capstyle="round", zorder=3)
    ax.scatter(x, y, s=18, color="white", edgecolor=blue, linewidth=1.4, zorder=4)
    ax.scatter([x[-1]], [y[-1]], s=70, color=navy, edgecolor="white", linewidth=2, zorder=5)

    ax.annotate(f"{y[0]:,.0f}", (x[0], y[0]), xytext=(4, 10),
                textcoords="offset points", color=navy, fontsize=9, weight="bold")
    ax.annotate(f"{y[-1]:,.0f}", (x[-1], y[-1]), xytext=(-6, 12),
                textcoords="offset points", ha="right", color=navy,
                fontsize=10, weight="bold")

    ax.set_xticks(x)
    ax.set_xticklabels([d.strftime("%b '%y") for d in plot_df["date"]],
                       fontsize=8, color=muted)
    ax.tick_params(axis="x", length=0, pad=8)
    ax.tick_params(axis="y", length=0, colors=muted, labelsize=8)
    ax.yaxis.set_major_formatter(FuncFormatter(lambda v, _: f"{v/1000:,.0f}k"))
    ax.grid(axis="y", color="#E7EDF3", linewidth=0.8)
    ax.set_axisbelow(True)
    ax.set_ylim(bottom, max(y) + 3200)
    ax.set_xlim(-0.35, len(x) - 0.65)
    for spine in ax.spines.values():
        spine.set_visible(False)

    fig.subplots_adjust(left=0.055, right=0.985, bottom=0.12, top=0.97)
    fig.savefig(output_path, dpi=200, facecolor="white")
    plt.close(fig)
    return output_path


def image_as_data_uri(path):
    """For browser HTML previews; Outlook email should use CID attachments instead."""
    with open(path, "rb") as f:
        return "data:image/png;base64," + base64.b64encode(f.read()).decode("ascii")


chart_path = create_burndown_chart(

ROUND(
    3958.7613 * 2 * ASIN(
        SQRT(
            LEAST(1,
                POWER(
                    SIN((A.LATITUDE - A.PREV_LATITUDE)
                        * ACOS(-1) / 360), 2
                )
                +
                COS(A.PREV_LATITUDE * ACOS(-1) / 180)
                * COS(A.LATITUDE * ACOS(-1) / 180)
                *
                POWER(
                    SIN((A.LONGITUDE - A.PREV_LONGITUDE)
                        * ACOS(-1) / 360), 2
                )
            )
        )
    ),
    2
) AS DISTANCE_MILES

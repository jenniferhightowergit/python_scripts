AND (
    6371000 * 2 * ASIN(
        SQRT(
            POWER(
                SIN(
                    RADIANS(c.latitude - e.lat) / 2
                ),
                2
            )
            +
            COS(RADIANS(e.lat))
            * COS(RADIANS(c.latitude))
            * POWER(
                SIN(
                    RADIANS(c.longitude - e.lon) / 2
                ),
                2
            )
        )
    )
) <= 60.96

import duckdb

conn = duckdb.connect()

df_dgroup_removals = conn.execute("""
    SELECT
        METER_TECH_DGROUP,

        COUNT(DISTINCT CASE
            WHEN isRemoved = 1
             AND REMOVAL_YEAR = YEAR(CURRENT_DATE)
            THEN meterno
        END) AS YTD_Removed,

        COUNT(DISTINCT CASE
            WHEN isRemoved = 1
             AND REMOVAL_YEAR = YEAR(CURRENT_DATE)
             AND REMOVAL_MONTH = MONTH(CURRENT_DATE)
            THEN meterno
        END) AS Removed_This_Month,

        COUNT(DISTINCT CASE
            WHEN isRemoved = 1
            THEN meterno
        END) AS Total_Removed

    FROM base

    GROUP BY METER_TECH_DGROUP

""").df()




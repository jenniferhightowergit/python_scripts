import folium

# Create interactive map centered on Wichita Falls, TX
m = folium.Map(
    location=[33.91, -98.49],
    zoom_start=12,
    tiles="CartoDB positron"
)

# Add example S4E meter location
folium.CircleMarker(
    location=[33.91, -98.49],
    radius=5,
    color="red",
    fill=True,
    popup="S4E Meter"
).add_to(m)

# Save as interactive HTML
m.save("s4e_folium_map.html")

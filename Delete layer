
    body = ""
    is_ir_table = "INSTR_RATED" in df.columns
    previous_model = None

    for i, row in display.iterrows():

        current_model = row["HARDWARE_MODEL"]

        # Detect the beginning of a new hardware model
        new_group = (
            is_ir_table
            and current_model != previous_model
        )

        # Light alternating background colors
        bg = "#FFFFFF" if i % 2 == 0 else "#F0F5F8"

        # Highlight the beginning of each hardware group
        if new_group:
            bg = "#E8F1F7"

        # Add a blue separator between hardware models
        top_border = (
            "2px solid #9DB9CC"
            if new_group and i > 0
            else "none"
        )

        body += f'<tr style="background-color:{bg};">'

        for col in display.columns:

            align = (
                "right" if col in number_cols else "left"
            )

            padding = (
                "12px 12px" if new_group
                else "8px 12px"
            )

            font_weight = (
                "bold"
                if new_group and col == "HARDWARE_MODEL"
                else "normal"
            )

            body += (
                f'<td style="padding:{padding};'
                f'border-top:{top_border};'
                f'border-bottom:1px solid #DFE6EC;'
                f'text-align:{align};'
                f'font-weight:{font_weight};'
                f'font-size:12px;">'
                f'{escape(str(row[col]))}</td>'
            )

        body += "</tr>"

        previous_model = current_model

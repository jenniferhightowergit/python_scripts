def add_training_data(db, category_id):
    """
    Add newly categorized orders to the training dataset
    for the specified category.
    """

    training_data = db.selectdf(f"""
        SELECT
            ct.order_id,
            ct.cleaned_comments,
            oc.category_id
        FROM cleaned_text ct

        JOIN order_category oc
            ON ct.order_id = oc.order_id

        LEFT JOIN training_data td
            ON ct.order_id = td.order_id
            AND oc.category_id = td.category_id

        WHERE oc.category_id = {category_id}
          AND td.order_id IS NULL
    """)

    return training_data

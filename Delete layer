, daily_metrics as (

    select
        workedby,
        work_date,

        -- workload
        count(distinct cluster_id) as clusters_worked,
        sum(meters_worked) as meters_worked,

        -- distance
        sum(travel_miles_from_previous_cluster)
            as total_travel_miles,

        avg(travel_miles_from_previous_cluster)
            as avg_miles_between_clusters,

        -- meter work time
        sum(cluster_duration_minutes)
            as total_cluster_work_minutes,

        avg(cluster_duration_minutes)
            as avg_minutes_per_cluster,

        -- pace within clusters
        avg(avg_minutes_between_changes)
            as avg_minutes_between_changes,

        median(median_minutes_between_changes)
            as median_minutes_between_changes,

        -- time between clusters
        sum(minutes_since_previous_cluster)
            as total_minutes_between_clusters,

        avg(minutes_since_previous_cluster)
            as avg_minutes_between_clusters

    from cluster_metrics

    group by
        workedby,
        work_date
)

select *
from daily_metrics

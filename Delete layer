import os
import win32com.client as win32
import pythoncom


def send_report(email_html, chart_path):

    pythoncom.CoInitialize()

    mail = None
    outlook = None

    try:
        outlook = win32.Dispatch("Outlook.Application")
        mail = outlook.CreateItem(0)

        mail.To = "jennifer.hightower@oncor.com"
        # mail.CC = "Edmundo.Rodriguez@oncor.com"

        mail.Subject = (
            "[Report] [Project Ranger] - "
            "Project Ranger Status Update"
        )

        mail.HTMLBody = email_html

        # Attach chart as an inline Outlook image
        attachment = mail.Attachments.Add(
            os.path.abspath(chart_path)
        )

        attachment.PropertyAccessor.SetProperty(
            "http://schemas.microsoft.com/mapi/proptag/0x3712001F",
            "project_ranger_burndown"
        )

        attachment.PropertyAccessor.SetProperty(
            "http://schemas.microsoft.com/mapi/proptag/0x7FFE000B",
            True
        )

        mail.Save()
        mail.Send()

        print("Project Ranger report sent successfully")

    finally:
        mail = None
        outlook = None
        pythoncom.CoUninitialize()


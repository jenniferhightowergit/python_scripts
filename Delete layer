EVENT_SQL = ','.join(map(str, EVENTS))

DAY_DIR = OUT_DIR / 'daily'
METERS_FILE = OUT_DIR / 'meters.parquet'
NAMES_FILE = OUT_DIR / 'event_names.parquet'


def log(msg):
    print(f'{time.strftime("%H:%M:%S")}  {msg}', flush=True)


def query_with_retry(sql, db, label):
    for attempt in range(1, MAX_RETRIES + 1):
        try:
            return run_query(sql, db)
        except Exception as e:  # dropped connection, timeout, etc.
            log(f'{label}: attempt {attempt} failed: {e}')
            if attempt == MAX_RETRIES:
                raise
            time.sleep(30 * attempt)


# ---------------------------------------------------------------- step 1: small reference tables
def pull_reference():
    meters = query_with_retry(f"""
        SELECT METERNO, METERPGMCD, FIRMWAREVERSION
        FROM AMSDESIGN.EDE_VW
        WHERE HW_MODEL = '{HW_MODEL}'
          AND FIRMWAREVERSION IS NOT NULL
    """, 'edw', 'meter population')
    meters = meters.drop_duplicates('METERNO')

    if LIMIT_TO_ALL_TOWN:
        town = query_with_retry(
            'SELECT DISTINCT SERIAL_NBR FROM RPTUSER.CM_ALL_TOWN_VW', 'ods', 'all town')
        town_ids = set(town['SERIAL_NBR'].astype(str).str.strip() + 'LG')
        meters = meters[meters['METERNO'].isin(town_ids)]

    meters.to_parquet(METERS_FILE, index=False)
    log(f'meter population: {len(meters):,} meters')

    names = query_with_retry(f"""
        SELECT EVENTTYPEID, NAME
        FROM CENTRALSERVICES.VW_EVENTTYPES
        WHERE EVENTTYPEID IN ({EVENT_SQL})
    """, 'edw', 'event names')
    names['EVENTTYPEID'] = names['EVENTTYPEID'].astype('int64')
    # keep every requested event, even ones with no name row
    names = pd.DataFrame({'EVENTTYPEID': EVENTS}).merge(names, how='left')
    names['NAME'] = names['NAME'].fillna('(no name in VW_EVENTTYPES)')
    names.to_parquet(NAMES_FILE, index=False)


# ---------------------------------------------------------------- step 2: one small query per day
def pull_day(d):
    out = DAY_DIR / f'{d:%Y-%m-%d}.parquet'
    if out.exists():
        return
    t0 = time.time()
    # Oracle does the counting: we get back meter x event counts, not raw event rows
    df = query_with_retry(f"""
        SELECT ede.METERNO, ve.EVENTTYPEID, COUNT(*) AS EVENT_COUNT
        FROM CENTRALSERVICES.VW_EVENTLOG ve
        JOIN AMSDESIGN.EDE_VW ede ON ede.ENDPOINTID = ve.ENDPOINTID
        WHERE ede.HW_MODEL = '{HW_MODEL}'
          AND ve.EVENTTYPEID IN ({EVENT_SQL})
          AND ve.EVENTDATE >= DATE '{d:%Y-%m-%d}'
          AND ve.EVENTDATE <  DATE '{d + timedelta(days=1):%Y-%m-%d}'
        GROUP BY ede.METERNO, ve.EVENTTYPEID
    """, 'edw', str(d))
    df['EVENTTYPEID'] = df['EVENTTYPEID'].astype('int64')
    df['EVENT_COUNT'] = df['EVENT_COUNT'].astype('int64')
    df['EVENT_DATE'] = pd.Timestamp(d)
    tmp = out.with_suffix('.tmp')      # write then rename, so a crash never leaves a half file
    df.to_parquet(tmp, index=False)
    tmp.replace(out)
    log(f'{d}: {len(df):,} meter/event rows in {time.time() - t0:,.0f}s')


# ---------------------------------------------------------------- step 3: summarize locally with DuckDB
def summarize(days):
    con = duckdb.connect()
    con.execute(f"CREATE VIEW meters AS SELECT * FROM read_parquet('{METERS_FILE.as_posix()}')")
    con.execute(f"CREATE VIEW names  AS SELECT * FROM read_parquet('{NAMES_FILE.as_posix()}')")
    con.execute(f"""
        CREATE VIEW ev AS
        SELECT e.METERNO, e.EVENTTYPEID, e.EVENT_COUNT, CAST(e.EVENT_DATE AS DATE) AS EVENT_DATE,
               m.METERPGMCD, m.FIRMWAREVERSION
        FROM read_parquet('{DAY_DIR.as_posix()}/*.parquet', union_by_name = true) e
        JOIN meters m USING (METERNO)
        WHERE CAST(e.EVENT_DATE AS DATE) BETWEEN DATE '{days[0]}' AND DATE '{days[-1]}'
    """)
    n_meters = con.execute('SELECT COUNT(*) FROM meters').fetchone()[0]

    summary = con.execute(f"""
        SELECT n.EVENTTYPEID, n.NAME,
               COALESCE(SUM(ev.EVENT_COUNT), 0)                        AS TOTAL_EVENTS,
               COUNT(DISTINCT ev.METERNO)                              AS METERS_REPORTING,
               ROUND(100.0 * COUNT(DISTINCT ev.METERNO) / {n_meters}, 2) AS PCT_METERS_REPORTING,
               COUNT(DISTINCT ev.EVENT_DATE)                           AS DAYS_SEEN,
               MAX(ev.EVENT_DATE)                                      AS LAST_SEEN,
               CASE WHEN COUNT(ev.METERNO) = 0 THEN 'NOT SEEN' END     AS FLAG
        FROM names n
        LEFT JOIN ev USING (EVENTTYPEID)
        GROUP BY n.EVENTTYPEID, n.NAME
        ORDER BY TOTAL_EVENTS, n.EVENTTYPEID
    """).df()

    def pct_by(col):
        # % of meters in each program code / firmware that reported each event
        long = con.execute(f"""
            WITH pop  AS (SELECT {col}, COUNT(*) AS n FROM meters GROUP BY 1),
                 hits AS (SELECT {col}, EVENTTYPEID, COUNT(DISTINCT METERNO) AS m FROM ev GROUP BY 1, 2)
            SELECT nm.EVENTTYPEID, p.{col} || ' (' || p.n || ' meters)' AS GRP,
                   ROUND(100.0 * COALESCE(h.m, 0) / p.n, 2) AS PCT
            FROM names nm
            CROSS JOIN pop p
            LEFT JOIN hits h ON h.EVENTTYPEID = nm.EVENTTYPEID AND h.{col} = p.{col}
        """).df()
        wide = long.pivot(index='EVENTTYPEID', columns='GRP', values='PCT').reset_index()
        return summary[['EVENTTYPEID', 'NAME']].merge(wide, how='left')

    daily = con.execute('SELECT EVENTTYPEID, EVENT_DATE, SUM(EVENT_COUNT) AS N FROM ev GROUP BY 1, 2').df()
    daily = (daily.pivot(index='EVENTTYPEID', columns='EVENT_DATE', values='N')
                  .reindex(index=EVENTS, columns=pd.to_datetime(days)).fillna(0).astype('int64'))
    daily.columns = [c.strftime('%m-%d') for c in daily.columns]
    daily = summary[['EVENTTYPEID', 'NAME']].merge(daily.reset_index(names='EVENTTYPEID'))

    info = pd.DataFrame({'item': ['window start', 'window end', 'hardware', 'limited to ALL TOWN',
                                  'meters in population', 'event types requested', 'run at'],
                         'value': [str(days[0]), str(days[-1]), HW_MODEL, LIMIT_TO_ALL_TOWN,
                                   n_meters, len(EVENTS), time.strftime('%Y-%m-%d %H:%M')]})

    xlsx = OUT_DIR / f'S4e_event_counts_{days[0]:%Y%m%d}_{days[-1]:%Y%m%d}.xlsx'
    with pd.ExcelWriter(xlsx, engine='openpyxl') as xw:
        for name, frame in [('Summary', summary), ('By program code', pct_by('METERPGMCD')),
                            ('By firmware', pct_by('FIRMWAREVERSION')), ('Daily counts', daily),
                            ('Run info', info)]:
            frame.to_excel(xw, sheet_name=name, index=False)
            ws = xw.sheets[name]
            ws.freeze_panes = 'C2' if name != 'Run info' else 'A2'
            for col in ws.columns:
                width = max(len(str(c.value or '')) for c in col[:200]) + 2
                ws.column_dimensions[col[0].column_letter].width = min(width, 45)
    log(f'wrote {xlsx}')
    log(f'{(summary.FLAG == "NOT SEEN").sum()} of {len(EVENTS)} event types never fired')


def main():
    DAY_DIR.mkdir(parents=True, exist_ok=True)
    today = date.today()
    days = [today - timedelta(days=i) for i in range(DAYS_BACK, 0, -1)]  # whole days, excludes today
    pull_reference()
    failed = []
    for d in days:
        try:
            pull_day(d)
        except Exception as e:
            log(f'{d}: giving up for now ({e})')
            failed.append(d)
    if failed:
        log(f'{len(failed)} day(s) failed; rerun the script to fill them in: {failed}')
        return
    summarize(days)


if __name__ == '__main__':
    main()

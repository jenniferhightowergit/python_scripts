        logging.StreamHandler(sys.stdout),
    ],
)
log = logging.getLogger("ranger")


# ----------------------------------------------------------------------------
# Helpers
# ----------------------------------------------------------------------------
@contextmanager
def step(name):
    t0 = time.perf_counter()
    log.info("START %s", name)
    yield
    log.info("DONE  %s  (%.1f min)", name, (time.perf_counter() - t0) / 60)


def make_engine(keyring_service):
    conn_string = keyring.get_password(keyring_service, KEYRING_USER)
    if not conn_string:
        raise RuntimeError(
            f"No keyring entry for '{keyring_service}'. The Windows account running "
            f"this task needs its own Credential Manager entry."
        )
    return create_engine(conn_string, arraysize=ORACLE_ARRAYSIZE)


def fetch(engine, sql, name):
    with step(f"pull {name}"):
        with engine.connect() as c:
            df = pd.read_sql(text(sql), c)
    log.info("%s: %s rows", name, f"{len(df):,}")
    return df


def clean(df):
    """Drop duplicate column names, normalize dtypes (fixed: result is now assigned)."""
    df = df.loc[:, ~df.columns.duplicated()].convert_dtypes()
    for col in df.columns:
        if df[col].dtype == "object":
            df[col] = df[col].astype("string")
    return df


def save(con, name, df):
    """Write a dataframe to a persistent table in ranger.duckdb."""
    con.register("_incoming", clean(df))
    con.execute(f"CREATE OR REPLACE TABLE {name} AS SELECT * FROM _incoming")
    con.unregister("_incoming")
    if EXPORT_PARQUET:
        con.execute(f"COPY {name} TO '{DATA_DIR / (name + '.parquet')}' (FORMAT parquet)")



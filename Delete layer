from pandas.api.types import CategoricalDtype
import joblib

def clean_categoricals(df, category_cols, schema=None, fit=False):
    """
    fit=True: derive schema from this df and return it (use only in training).
    fit=False: apply an existing schema (use in scoring).
    """
    schema = schema or {}
    for col in category_cols:
        df[col] = (
            df[col].astype("string")
            .str.replace("\x00", "", regex=False)
            .str.strip()
            .fillna("UNKNOWN")
        )
        if fit:
            df[col] = df[col].astype("category")
            schema[col] = df[col].cat.categories.tolist()
        else:
            df[col] = df[col].astype(CategoricalDtype(categories=schema[col]))
    return df, schema


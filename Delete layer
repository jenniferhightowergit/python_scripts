<section class="panel">
  <h2>Category Overview</h2>

  <div class="cards">
    <div class="card">
      <div class="label">Total categories</div>
      <div class="value" id="categoryCount">-</div>
    </div>

    <div class="card">
      <div class="label">Active model</div>
      <div class="value" id="currentModel">-</div>
    </div>

    <div class="card">
      <div class="label">Predictions (90 days)</div>
      <div class="value" id="predictionCount">-</div>
    </div>

    <div class="card">
      <div class="label">Avg. predictions/day</div>
      <div class="value" id="dailyAverage">-</div>
    </div>
  </div>
</section>



const activitySelect = document.getElementById("category");
const activityChart = document.getElementById("activityChart")



function drawActivityChart() {
    const category = activitySelect.value;

    const predictions = activityData.map(d =>
        category === "all"
            ? Object.values(d.predictions).reduce((a, b) => a + b, 0)
            : (d.predictions[category] || 0)
    );


const maxValue = Math.max(
    1,
    ...activityData.map(d => d.total_orders),
    ...predictions
) * 1.1


const predictionLabel = category === "all"
    ? "All category predictions"
    : `${category} predictions`;


function updateCategoryOverview() {
    const category = activitySelect.value;

    const categories = [...new Set(models.map(m => m.category))];

    const selectedModels = models.filter(m =>
        category === "all" || m.category === category
    );

    const activeModels = selectedModels.filter(m => m.active_flag);

    const totalPredictions = activityData.reduce((total, day) => {
        if (category === "all") {
            return total + Object.values(day.predictions)
                .reduce((a, b) => a + b, 0);
        }

        return total + (day.predictions[category] || 0);
    }, 0);

    const modelName = category === "all"
        ? `${activeModels.length} active models`
        : activeModels.map(m => m.name).join(", ") || "None";

    document.getElementById("categoryCount").textContent =
        categories.length;

    document.getElementById("currentModel").textContent =
        modelName;

    document.getElementById("predictionCount").textContent =
        totalPredictions.toLocaleString();

    document.getElementById("dailyAverage").textContent =
        (totalPredictions / activityData.length).toFixed(1);
}


activitySelect.addEventListener("change", () => {
    drawActivityChart();
    updateCategoryOverview();
});

drawActivityChart();
updateCategoryOverview();








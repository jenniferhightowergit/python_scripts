
import pandas as pd

def convert_coordinate(value):
    if pd.isna(value):
        return None

    value = str(value).strip()
    parts = value.split()

    # Already decimal degrees
    if len(parts) == 1:
        return float(parts[0])

    # Degrees and decimal minutes
    if len(parts) == 2:
        degrees = float(parts[0])
        minutes = float(parts[1])

        if not 0 <= minutes < 60:
            return None

        sign = -1 if degrees < 0 else 1

        return sign * (
            abs(degrees) + minutes / 60
        )

    return None


df_meters["longitude_clean"] = (
    df_meters["longitude"].apply(convert_coordinate)
)

df_meters["latitude_clean"] = (
    df_meters["latitude"].apply(convert_coordinate)
)

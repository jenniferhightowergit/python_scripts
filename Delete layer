import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

from sklearn.base import clone
from sklearn.model_selection import KFold, cross_val_predict
from sklearn.metrics import (
    classification_report,
    confusion_matrix,
    ConfusionMatrixDisplay,
    precision_recall_fscore_support,
    roc_auc_score,
    average_precision_score,
    precision_recall_curve,
    roc_curve
)


class CommentClassifierValidator:

    def __init__(self):
        print("Setting up classifier validator...")
        print("Classifier validator ready.")

    def validate(
        self,
        model,
        df,
        comment_col,
        instructions_col,
        label_cols,
        threshold=0.70,
        cv=5,
        random_state=42,
        show_plots=True
    ):
        df = df.copy()

        df["model_text"] = (
            df[comment_col].fillna("").astype(str)
            + " "
            + df[instructions_col].fillna("").astype(str)
        )

        X = df["model_text"]
        y = df[label_cols].fillna(0).astype(int)

        kfold = KFold(
            n_splits=cv,
            shuffle=True,
            random_state=random_state
        )

        # Cross-validated probabilities
        y_prob = cross_val_predict(
            clone(model),
            X,
            y,
            cv=kfold,
            method="predict_proba"
        )

        if len(label_cols) == 1:
            y_prob = y_prob[:, 1].reshape(-1, 1)

        y_pred = (y_prob >= threshold).astype(int)

        # 1. Classification report
        report = classification_report(
            y,
            y_pred,
            target_names=label_cols,
            output_dict=True
        )

        report_df = pd.DataFrame(report).transpose()

        print("\nCLASSIFICATION REPORT")
        print(pd.DataFrame(report).transpose())

        # 2. Confusion matrices
        confusion_results = {}

        for i, category in enumerate(label_cols):
            cm = confusion_matrix(y.iloc[:, i], y_pred[:, i])
            confusion_results[category] = cm

            print("\n" + "=" * 60)
            print(category)
            print(cm)

            if cm.shape == (2, 2):
                tn, fp, fn, tp = cm.ravel()
                print(f"True Negative: {tn}")
                print(f"False Positive: {fp}")
                print(f"False Negative: {fn}")
                print(f"True Positive: {tp}")

            if show_plots:
                disp = ConfusionMatrixDisplay(
                    confusion_matrix=cm,
                    display_labels=["No", "Yes"]
                )
                disp.plot()
                plt.title(category)
                plt.show()

        # 3. Cross-validation summary metrics
        cv_rows = []

        for i, category in enumerate(label_cols):
            precision, recall, f1, support = precision_recall_fscore_support(
                y.iloc[:, i],
                y_pred[:, i],
                average="binary",
                zero_division=0
            )

            cv_rows.append({
                "category": category,
                "precision": precision,
                "recall": recall,
                "f1": f1,
                "support": support
            })

        cv_summary = pd.DataFrame(cv_rows)

        # 4. ROC AUC
        auc_rows = []

        for i, category in enumerate(label_cols):
            if y.iloc[:, i].nunique() > 1:
                roc_auc = roc_auc_score(y.iloc[:, i], y_prob[:, i])
                pr_auc = average_precision_score(y.iloc[:, i], y_prob[:, i])
            else:
                roc_auc = np.nan
                pr_auc = np.nan

            auc_rows.append({
                "category": category,
                "roc_auc": roc_auc,
                "average_precision_pr_auc": pr_auc
            })

        auc_df = pd.DataFrame(auc_rows)

        # 5. ROC and Precision-Recall curves
        if show_plots:
            for i, category in enumerate(label_cols):
                if y.iloc[:, i].nunique() > 1:
                    fpr, tpr, _ = roc_curve(y.iloc[:, i], y_prob[:, i])
                    precision, recall, _ = precision_recall_curve(
                        y.iloc[:, i],
                        y_prob[:, i]
                    )

                    plt.figure()
                    plt.plot(fpr, tpr)
                    plt.title(f"ROC Curve - {category}")
                    plt.xlabel("False Positive Rate")
                    plt.ylabel("True Positive Rate")
                    plt.show()

                    plt.figure()
                    plt.plot(recall, precision)
                    plt.title(f"Precision-Recall Curve - {category}")
                    plt.xlabel("Recall")
                    plt.ylabel("Precision")
                    plt.show()

        # 6. Threshold analysis
        threshold_rows = []

        for i, category in enumerate(label_cols):
            for t in np.arange(0.10, 1.00, 0.10):
                temp_pred = (y_prob[:, i] >= t).astype(int)

                precision, recall, f1, support = precision_recall_fscore_support(
                    y.iloc[:, i],
                    temp_pred,
                    average="binary",
                    zero_division=0
                )

                threshold_rows.append({
                    "category": category,
                    "threshold": round(t, 2),
                    "precision": precision,
                    "recall": recall,
                    "f1": f1,
                    "support": support
                })

        threshold_df = pd.DataFrame(threshold_rows)

        # 7. Feature importance / top words
        feature_importance = self.get_feature_importance(
            model=model,
            label_cols=label_cols
        )

        # 8. False positive / false negative review
        review_rows = []

        for i, category in enumerate(label_cols):
            temp = pd.DataFrame({
                "model_text": X.values,
                "category": category,
                "actual": y.iloc[:, i].values,
                "predicted": y_pred[:, i],
                "score": y_prob[:, i].round(3)
            })

            temp["error_type"] = np.select(
                [
                    (temp["actual"] == 0) & (temp["predicted"] == 1),
                    (temp["actual"] == 1) & (temp["predicted"] == 0),
                    (temp["actual"] == 1) & (temp["predicted"] == 1),
                    (temp["actual"] == 0) & (temp["predicted"] == 0),
                ],
                [
                    "FALSE_POSITIVE",
                    "FALSE_NEGATIVE",
                    "TRUE_POSITIVE",
                    "TRUE_NEGATIVE"
                ],
                default="UNKNOWN"
            )

            review_rows.append(temp)

        review_df = pd.concat(review_rows, ignore_index=True)

        false_positives = review_df[
            review_df["error_type"] == "FALSE_POSITIVE"
        ].copy()

        false_negatives = review_df[
            review_df["error_type"] == "FALSE_NEGATIVE"
        ].copy()

        # 9. Cross-validated confusion matrix already done above
        # The confusion matrices above are built from cross_val_predict results.

        return {
            "classification_report": report_df,
            "confusion_matrices": confusion_results,
            "cross_validation_summary": cv_summary,
            "auc_scores": auc_df,
            "threshold_analysis": threshold_df,
            "feature_importance": feature_importance,
            "review_rows": review_df,
            "false_positives": false_positives,
            "false_negatives": false_negatives,
            "y_prob": y_prob,
            "y_pred": y_pred
        }

    def get_feature_importance(self, model, label_cols, top_n=25):
        try:
            tfidf = model.named_steps["tfidf"]
            clf = model.named_steps["clf"]

            feature_names = np.array(tfidf.get_feature_names_out())

            rows = []

            for i, category in enumerate(label_cols):
                estimator = clf.estimators_[i]
                coefs = estimator.coef_[0]

                top_positive_idx = np.argsort(coefs)[-top_n:][::-1]
                top_negative_idx = np.argsort(coefs)[:top_n]

                for idx in top_positive_idx:
                    rows.append({
                        "category": category,
                        "direction": "positive",
                        "feature": feature_names[idx],
                        "coefficient": coefs[idx]
                    })

                for idx in top_negative_idx:
                    rows.append({
                        "category": category,
                        "direction": "negative",
                        "feature": feature_names[idx],
                        "coefficient": coefs[idx]
                    })

            return pd.DataFrame(rows)

        except Exception as e:
            print("Feature importance could not be created.")
            print(e)
            return pd.DataFrame()








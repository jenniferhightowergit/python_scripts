# ----------------------------------------------------------------------------
# Stage 1: pull all sources in parallel
# ----------------------------------------------------------------------------
def pull_sources(con):
    oracledb.init_oracle_client()          # thick mode, once per run
    ods = make_engine(KEYRING_ODS)
    edw = make_engine(KEYRING_EDW)

    jobs = {
        "fw_hardware":      (edw, SQL_FW_HARDWARE),      # slowest: start first
        "stock_inventory":  (edw, SQL_STOCK_INVENTORY),
        "alltown":          (ods, SQL_ALLTOWN),
        "metering_device":  (ods, SQL_METERING_DEVICE),
        "ops_area_by_esiloc": (ods, SQL_OPS_AREA),
    }

    with ThreadPoolExecutor(max_workers=len(jobs), thread_name_prefix="pull") as ex:
        futures = {name: ex.submit(fetch, eng, sql, name) for name, (eng, sql) in jobs.items()}
        # DuckDB writes stay on the main thread; .result() re-raises any pull error
        for name, fut in futures.items():
            save(con, name, fut.result())

    ods.dispose()
    edw.dispose()


# ----------------------------------------------------------------------------
# Stage 2: derived tables (pure DuckDB, no Oracle)
# ----------------------------------------------------------------------------
def build_meter_effectivedate_change(con):
    """Was the DuckDB half of ALL_MC_HISTORY.py -> METER_EFFECTIVEDATE_CHANGE.parquet"""
    with step("meter_effectivedate_change"):
        con.execute("""
        CREATE OR REPLACE TABLE meter_effectivedate_change AS
        SELECT
            meterno,
            lag(meterno) OVER (PARTITION BY esi_loc ORDER BY meter_install_date) AS prev_meterno,
            esi_loc,
            meter_install_date AS installation_date,
            CASE WHEN status = 'INACTIVE' AND meter_removal_date = DATE '3001-01-01'
                 THEN lead(meter_install_date) OVER (PARTITION BY esi_loc ORDER BY meter_install_date)
                 ELSE meter_removal_date END AS meter_removal_date,
            status
        FROM (
            SELECT meterno, prem_h AS esi_loc,
                   CAST(meter_install_date AS DATE) AS meter_install_date,
                   DATE '3001-01-01' AS meter_removal_date,
                   'ACTIVE' AS status
            FROM alltown

            UNION

            SELECT a.meterno, a.esi_loc,
                   CAST(eff_dt AS DATE) AS meter_install_date,
                   CASE WHEN CAST(end_dt AS DATE) = DATE '4000-12-31' THEN DATE '3001-01-01'
                        WHEN end_dt IS NULL THEN DATE '3001-01-01'
                        ELSE CAST(end_dt AS DATE) END AS meter_removal_date,
                   'INACTIVE' AS status
            FROM metering_device a
            WHERE NOT EXISTS (SELECT 1 FROM alltown c WHERE c.meterno = a.meterno)
        ) t1
        """)



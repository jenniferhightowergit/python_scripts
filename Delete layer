])

display(df_models)


def calculate_metrics(df):
    df = df.copy()

    tp = df["tpc"]
    tn = df["tnc"]
    fp = df["fpc"]
    fn = df["fnc"]

    def safe_divide(numerator, denominator):
        return numerator.div(
            denominator.where(denominator != 0)
        )

    df["precision"] = safe_divide(tp, tp + fp)
    df["recall"] = safe_divide(tp, tp + fn)
    df["accuracy"] = safe_divide(
        tp + tn, tp + tn + fp + fn
    )
    df["f1"] = safe_divide(
        2 * tp, 2 * tp + fp + fn
    )

    df["actp"] = tp + fn
    df["actn"] = tn + fp

    return df


df_performance = calculate_metrics(df_models)

display(df_performance)


def build_report_json(df):
    records = df.astype(object).where(
        pd.notna(df), None
    ).to_dict(orient="records")

    report = {
        "summary": {
            "total_models": len(df),
            "active_models": int(df["active_flag"].sum()),
            "inactive_models": int(
                (~df["active_flag"]).sum()
            ),
            "average_accuracy": (
                float(df["accuracy"].mean())
                if df["accuracy"].notna().any()
                else None
            )
        },
        "model_performance": records
    }

    return report


report_data = build_report_json(df_performance)

output_path = Path("model_report.json")

with output_path.open("w", encoding="utf-8") as f:
    json.dump(report_data, f, indent=4, allow_nan=False)

print(f"JSON saved to: {output_path.resolve()}")






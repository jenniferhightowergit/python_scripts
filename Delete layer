
import geopandas as gpd
import shapely
from shapely.geometry import MultiPoint

# Create points from cleaned meters
meters = gpd.GeoDataFrame(
    df_valid.copy(),
    geometry=gpd.points_from_xy(
        df_valid["longitude_clean"],
        df_valid["latitude_clean"]
    ),
    crs="EPSG:4326"
).to_crs("EPSG:5070")

# Create a single geometry containing all meter points
meter_points = MultiPoint(
    list(meters.geometry)
)

# Build a concave hull
outer_boundary = shapely.concave_hull(
    meter_points,
    ratio=0.15,
    allow_holes=False
)

footprint = gpd.GeoDataFrame(
    geometry=[outer_boundary],
    crs=meters.crs
)


# Make sure both datasets use the same CRS
grid = grid.to_crs(footprint.crs)

# Clip the grid to the meter footprint
grid_clipped = gpd.clip(
    grid,
    footprint
)

# Merge cells belonging to the same op area
boundaries_new = (
    grid_clipped
    .dissolve(by="op_area")
    .reset_index()
)

# Convert back to geographic coordinates
boundaries_new = boundaries_new.to_crs("EPSG:4326")

# Export GeoJSON
boundaries_new.to_file(
    "op_area_boundaries_refined.geojson",
    driver="GeoJSON"
)


import matplotlib.pyplot as plt

fig, ax = plt.subplots(figsize=(16, 12))

boundaries_new.plot(
    ax=ax,
    column="op_area",
    cmap="tab20",
    edgecolor="black",
    linewidth=0.7,
    alpha=0.6,
    legend=True
)

meters.to_crs("EPSG:4326").plot(
    ax=ax,
    color="black",
    markersize=0.3,
    alpha=0.15
)

ax.set_title(
    "Estimated Operational Areas Based on Meter Locations",
    fontsize=16
)

ax.set_axis_off()
plt.tight_layout()
plt.show()



    inventory.columns
    .str.strip()
    .str.lower()
)

inventory = inventory[
    ["class", "form", "volt", "stock_amount"]
].copy()

inventory["stock_amount"] = pd.to_numeric(
    inventory["stock_amount"],
    errors="coerce"
).fillna(0)

inventory = (
    inventory
    .groupby(
        ["class", "form", "volt"],
        dropna=False,
        as_index=False
    )["stock_amount"]
    .sum()
)

inventory = inventory.sort_values(
    ["class", "form", "volt"],
    key=lambda col: col.astype(str)
)

total_stock = inventory["stock_amount"].sum()


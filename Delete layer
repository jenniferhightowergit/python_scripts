"""
example_train_comment_model.py

Minimal example showing how to feed a dataframe into CommentClassifier
and save the resulting model.
"""

import pandas as pd
from comment_classifier import CommentClassifier

# ------------------------------------------------------------------
# 1. Feed in the dataframe
# ------------------------------------------------------------------
# This is whatever dataframe you already have with cleaned comments + label
# columns -- e.g. loaded from Parquet, Oracle, or your existing to_train object.
df = pd.read_parquet(r"\\eucprdnas01\u_support\jen_hightower\data\to_train.parquet")

# ------------------------------------------------------------------
# 2a. SINGLE CATEGORY example
# ------------------------------------------------------------------
clf = CommentClassifier(
    comment_col="cleaned_comment",
    label_col="HARDWARE_FAILURE",     # the one column you're training on
    threshold=0.70,
)

report = clf.train(
    df,
    # this is where you define where the model gets saved
    model_path=r"\\eucprdnas01\u_support\jen_hightower\ML_Models\HARDWARE_FAILURE_classifier.pkl",
)

print(report)

# ------------------------------------------------------------------
# 2b. LOOP OVER ALL CATEGORIES (one model per category)
# ------------------------------------------------------------------
label_cols = [
    "NON_COMMUNICATING",
    "DAMAGED_METER",
    "HARDWARE_FAILURE",
    "VEGETATION",
    "NETWORK_ISSUE",
    "TOPOGRAPHY_ISSUE",
    "TAMPERING",
    "VANDALISM",
    "ELECTRICAL_DISTRIBUTION_ISSUE",
    "CONSTRUCTION",
    "ACCESS_ISSUES",
]

save_folder = r"\\eucprdnas01\u_support\jen_hightower\ML_Models"

for label in label_cols:
    clf = CommentClassifier(
        comment_col="cleaned_comment",
        label_col=label,
        threshold=0.70,
    )

    report = clf.train(
        df,
        model_path=rf"{save_folder}\{label}_classifier.pkl",
    )

    print(f"\n=== {label} ===")
    print(report)

# Each loop iteration writes two files per category, e.g.:
#   HARDWARE_FAILURE_classifier.pkl
#   HARDWARE_FAILURE_classifier.metadata.json

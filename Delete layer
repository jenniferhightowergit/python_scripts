
SELECT *
FROM meters m
JOIN comments c
    ON (
        6371000 * 2 * ASIN(
            SQRT(
                POWER(SIN(RADIANS(c.latitude - m.latitude) / 2), 2) +
                COS(RADIANS(m.latitude)) *
                COS(RADIANS(c.latitude)) *
                POWER(SIN(RADIANS(c.longitude - m.longitude) / 2), 2)
            )
        )
    ) <= 804.672

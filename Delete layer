import random
from datetime import datetime, timedelta

def build_daily_activity(days=90):
    rng = random.Random(42)

    categories = [
        "Battery Change",
        "Bad LCD",
        "Meter Change"
    ]

    start = datetime.now().date() - timedelta(days=days - 1)

    activity = []

    for i in range(days):
        day = start + timedelta(days=i)

        total_orders = max(
            0,
            200 + i // 3 + rng.randint(-25, 25)
        )

        predictions = {
            "Battery Change": rng.randint(35, 70),
            "Bad LCD": rng.randint(20, 50),
            "Meter Change": rng.randint(45, 85)
        }

        activity.append({
            "date": day.isoformat(),
            "total_orders": total_orders,
            "predictions": predictions
        })

    return activity

def build_report_json(df, activity):

    records = df.to_dict(orient="records")

    total_predictions = sum(
        sum(day["predictions"].values())
        for day in activity
    )

    active_models = int(df["active_flag"].sum())

    report = {
        "summary": {
            "total_models": len(df),
            "active_models": active_models,
            "inactive_models": len(df) - active_models,
            "average_accuracy": (
                float(df["accuracy"].mean())
                if df["accuracy"].notna().any()
                else None
            )
        },

        "model_performance": records,

        "category_overview": {
            "total_categories": int(df["category"].nunique()),
            "active_models": active_models,
            "predictions_90_days": total_predictions,
            "average_predictions_per_day": (
                total_predictions / len(activity)
                if activity else 0
            )
        },

        "daily_activity": activity
    }

    return report




pts = conn.execute("""
    select
        workedby,
        work_date,
        meterno,
        min(worked_datetime) as worked_datetime,
        any_value(latitude) as latitude,
        any_value(longitude) as longitude,
        max(pt_flag) as pt_flag
    from for_mapping
    where workedby is not null
      and meterno is not null
      and latitude is not null
      and longitude is not null
      and outcome <> 'ALREADY GONE'
    group by
        workedby,
        work_date,
        meterno
""").df()

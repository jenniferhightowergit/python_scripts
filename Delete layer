select
    workedby,
    work_date,
    cluster_id,

    cluster_start_time,
    cluster_end_time,

    previous_cluster_id,
    previous_cluster_end_time,

    datediff(
        'minute',
        previous_cluster_end_time,
        cluster_start_time
    ) as calculated_gap_minutes

from cluster_sequence

where workedby = 'RUNU'
  and work_date = date '2026-02-10'

order by cluster_start_time;

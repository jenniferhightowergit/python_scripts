SELECT
    m.meterno,
    i.datadefinitionid,
    def.name AS def_name,
    TRUNC(i.intervalstartdate) AS interval_date,

    COUNT(*) AS interval_count,

    COUNT(DISTINCT i.intervalstartdate)
        AS distinct_interval_count,

    COUNT(i.intervalvalue)
        AS nonnull_count,

    SUM(
        CASE
            WHEN i.intervalvalue = 0 THEN 1
            ELSE 0
        END
    ) AS zero_count,

    MIN(i.intervalvalue) AS min_voltage,
    MAX(i.intervalvalue) AS max_voltage,

    MIN(
        CASE
            WHEN i.intervalvalue > 0
            THEN i.intervalvalue
        END
    ) AS min_nonzero_voltage,

    MAX(
        CASE
            WHEN i.intervalvalue > 0
            THEN i.intervalvalue
        END
    ) AS max_nonzero_voltage

FROM centralservices.vw_meters m

JOIN centralservices.vw_endpoints ep
    ON m.meterid = ep.meterid

JOIN centralservices.vw_intervaldata i
    ON ep.endpointid = i.endpointid

JOIN centralservices.datadefinitions def
    ON def.datadefinitionid = i.datadefinitionid

WHERE m.meterno IN (
    '188895315LG',
    '198890563LG',
    '147872582LG'
)

AND i.intervalstartdate >= DATE '2026-06-01'
AND i.intervalstartdate < DATE '2026-07-01'

GROUP BY
    m.meterno,
    i.datadefinitionid,
    def.name,
    TRUNC(i.intervalstartdate)

ORDER BY
    m.meterno,
    interval_date,
    def.name;

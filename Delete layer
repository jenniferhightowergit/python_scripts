# Keep original data unchanged
stock_clean = stock.copy()

# Stock-specific display rules
rules = {
    "0404103": {"form": "03", "volt": "120/240"},
    "0404326": {"form": "45", "volt": "120/240"},
    "0405056": {"form": "36", "volt": "120"},
    "0405160": {"form": "09", "volt": "120/240"}
}

# Normalize stock numbers and form values
stock_clean["STOCKNO"] = stock_clean["STOCKNO"].astype(str).str.strip()
stock_clean["form"] = stock_clean["form"].astype(str).str.zfill(2)

# Apply rules
for stockno, rule in rules.items():
    mask = stock_clean["STOCKNO"].eq(stockno)

    stock_clean.loc[mask, "form"] = rule["form"]
    stock_clean.loc[mask, "volt"] = rule["volt"]

# Combine matching rows
stock_clean = (
    stock_clean
    .groupby(
        ["STOCKNO", "class", "form", "volt"],
        as_index=False,
        dropna=False
    )
    .agg({
        "NEEDED_AMOUNT": "sum",
        "STOCK_AMOUNT": "sum"
    })
)

# Filter AFTER combining
stock_clean = stock_clean[
    stock_clean["NEEDED_AMOUNT"] > 0
].copy()


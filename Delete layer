create or replace table missed_grid as
select
    dgroup,
    round(avg(latitude),  5)                          as latitude,
    round(avg(longitude), 5)                          as longitude,

    count(*)                                          as s4e_meters,
    count(*) filter (where not still_active)          as changed_meters,
    count(*) filter (where still_active)              as missed_meters,
    round(100.0 * count(*) filter (where not still_active)
          / nullif(count(*), 0), 1)                   as pct_changed,

    sum(passes) filter (where still_active)           as total_passes,
    round(avg(passes) filter (where still_active), 1) as avg_passes_per_meter,
    max(passes) filter (where still_active)           as max_passes,
    sum(same_premise_passes) filter (where still_active)
                                                      as same_premise_passes
from meter_passes
cross join opp_params p
group by dgroup,
         floor(latitude  / p.grid_deg)::bigint,
         floor(longitude / p.grid_deg)::bigint;

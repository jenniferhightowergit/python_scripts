meter_selection_query = text("""
    SELECT meterno
    FROM
    (
        SELECT DISTINCT
            ede.METERNO AS meterno

        FROM CENTRALSERVICES.MV_EDE_EXTRACT ede

        WHERE ede.HARDWARE_MODEL NOT IN ('NORESOURCEKEY')
          AND ede.METERNO > :last_meter

        ORDER BY ede.METERNO
    )

    WHERE ROWNUM <= :batch_size
""")


with edw_alchemy_engine.connect() as sql_connection:

    while True:

        batch_number += 1
        batch_start_time = time.perf_counter()

        print("\n" + "=" * 70)
        print(f"Finding meters for batch {batch_number:,}...")
        print(f"Starting after meter: {last_meter or '[beginning]'}")
        print("=" * 70)

        # ------------------------------------------------------------
        # STEP 1: Oracle selects the next 10,000 meters
        # ------------------------------------------------------------

        batch_meter_df = pd.read_sql_query(
            meter_selection_query,
            sql_connection,
            params={
                "last_meter": last_meter,
                "batch_size": BATCH_SIZE
            }
        )

        # Normalize the returned column name
        batch_meter_df.columns = (
            batch_meter_df.columns
            .str.strip()
            .str.lower()
        )

        # No meters means Oracle has reached the end
        if batch_meter_df.empty:
            print("\nNo more meters were found.")
            break

        batch_first_meter = str(
            batch_meter_df["meterno"].iloc[0]
        )

        batch_last_meter = str(
            batch_meter_df["meterno"].iloc[-1]
        )

        meters_in_batch = len(batch_meter_df)

        print(f"Batch: {batch_number:,}")
        print(f"Meters selected: {meters_in_batch:,}")
        print(f"First meter: {batch_first_meter}")
        print(f"Last meter:  {batch_last_meter}")

        # ------------------------------------------------------------
        # STEP 2: Run your complete query for that same meter batch
        # ------------------------------------------------------------

        query = text("""
            WITH batch_meters AS
            (
                SELECT meterno
                FROM
                (
                    SELECT DISTINCT
                        ede_batch.METERNO AS meterno

                    FROM CENTRALSERVICES.MV_EDE_EXTRACT ede_batch

                    WHERE ede_batch.HARDWARE_MODEL
                              NOT IN ('NORESOURCEKEY')

                      AND ede_batch.METERNO > :last_meter

                    ORDER BY ede_batch.METERNO
                )

                WHERE ROWNUM <= :batch_size
            ),

            hw AS
            (
                SELECT DISTINCT
                    a.assetnum,

                    reg.ALNVALUE       AS RegisterType,
                    rev.ALNVALUE       AS RevisionID,
                    FORMNO.ALNVALUE    AS FORMNO,
                    FRMWAREV.ALNVALUE  AS FRMWAREV,
                    SFTWAREV.ALNVALUE  AS SFTWAREV,
                    METRFWVR.ALNVALUE  AS METRFWVR,
                    METRFWDT.ALNVALUE  AS METRFWDT,
                    HANTYPE.ALNVALUE   AS HANTYPE,
                    HANCTYPE.ALNVALUE  AS HANCTYPE,
                    HANFW.ALNVALUE     AS HANFW

                FROM MXRADS.VW_ASSETSPEC a

                JOIN
                (
                    SELECT
                        b.ALNVALUE,
                        b.assetnum

                    FROM MXRADS.VW_ASSETSPEC b

                    WHERE b.assetattrid = 'REGTYPE'
                ) reg
                    ON a.assetnum = reg.assetnum

                JOIN
                (
                    SELECT
                        c.ALNVALUE,
                        c.assetnum

                    FROM MXRADS.VW_ASSETSPEC c

                    WHERE c.assetattrid = 'REV'
                ) rev
                    ON a.assetnum = rev.assetnum

                JOIN
                (
                    SELECT
                        d.ALNVALUE,
                        d.assetnum

                    FROM MXRADS.VW_ASSETSPEC d

                    WHERE d.assetattrid = 'FORMNO'
                ) FORMNO
                    ON a.assetnum = FORMNO.assetnum

                JOIN
                (
                    SELECT
                        e.ALNVALUE,
                        e.assetnum

                    FROM MXRADS.VW_ASSETSPEC e

                    WHERE e.assetattrid = 'FRMWAREV'
                ) FRMWAREV
                    ON a.assetnum = FRMWAREV.assetnum

                JOIN
                (
                    SELECT
                        f.ALNVALUE,
                        f.assetnum

                    FROM MXRADS.VW_ASSETSPEC f

                    WHERE f.assetattrid = 'SFTWAREV'
                ) SFTWAREV
                    ON a.assetnum = SFTWAREV.assetnum

                /*
                Keep your existing joins for these attributes here.

                The screenshots did not show the full middle section,
                so paste your original joins unchanged for:

                    METRFWVR
                    METRFWDT
                    HANTYPE
                    HANCTYPE
                    HANFW

                They should follow the same pattern as the joins above.
                */

                JOIN
                (
                    SELECT
                        g.ALNVALUE,
                        g.assetnum

                    FROM MXRADS.VW_ASSETSPEC g

                    WHERE g.assetattrid = 'METRFWVR'
                ) METRFWVR
                    ON a.assetnum = METRFWVR.assetnum

                JOIN
                (
                    SELECT
                        h.ALNVALUE,
                        h.assetnum

                    FROM MXRADS.VW_ASSETSPEC h

                    WHERE h.assetattrid = 'METRFWDT'
                ) METRFWDT
                    ON a.assetnum = METRFWDT.assetnum

                JOIN
                (
                    SELECT
                        i.ALNVALUE,
                        i.assetnum

                    FROM MXRADS.VW_ASSETSPEC i

                    WHERE i.assetattrid = 'HANTYPE'
                ) HANTYPE
                    ON a.assetnum = HANTYPE.assetnum

                JOIN
                (
                    SELECT
                        j.ALNVALUE,
                        j.assetnum

                    FROM MXRADS.VW_ASSETSPEC j

                    WHERE j.assetattrid = 'HANCTYPE'
                ) HANCTYPE
                    ON a.assetnum = HANCTYPE.assetnum

                JOIN
                (
                    SELECT
                        k.ALNVALUE,
                        k.assetnum

                    FROM MXRADS.VW_ASSETSPEC k

                    WHERE k.assetattrid = 'HANFW'
                ) HANFW
                    ON a.assetnum = HANFW.assetnum

                WHERE 1 = 1
            ),

            asset_data AS
            (
                SELECT DISTINCT
                    a.assetnum,
                    a.CG_PURCHASEDATE,
                    a.MANUFACTURER,
                    a.description,

                    TO_CHAR(a.SERIALNUM)
                        || TO_CHAR(a.MANUFACTURER) AS meterno

                FROM MXRADS.VW_ASSET a

                WHERE a.MANUFACTURER NOT IN (
                    'VT',
                    'VM',
                    'PR',
                    'TD',
                    'DUMMY'
                )
            )

            SELECT DISTINCT
                ede.METERNO AS meterno,
                ede.HARDWARE_MODEL,

                CAST(
                    TRIM(ede.COLLECTOR)
                    AS VARCHAR2(1000)
                ) AS COLLECTOR,

                ede.FIRMWARE_VERSION,
                ede.KH,
                ede.DATE_DEPLOYED,

                t1.description,

                TRIM(
                    REGEXP_SUBSTR(
                        t1.description,
                        '[^,]+',
                        1,
                        3
                    )
                )
                ||
                TRIM(
                    REGEXP_SUBSTR(
                        t1.description,
                        '[^,]+',
                        1,
                        4
                    )
                ) AS hw_form,

                TRIM(
                    REGEXP_SUBSTR(
                        t1.description,
                        '[^,]+',
                        1,
                        6
                    )
                ) AS hw_volt,

                TRIM(
                    REGEXP_SUBSTR(
                        t1.description,
                        '[^,]+',
                        1,
                        9
                    )
                ) AS hw_amp,

                hw.RegisterType,
                hw.RevisionID,
                hw.FORMNO,
                hw.FRMWAREV,
                hw.SFTWAREV,
                hw.METRFWVR,
                hw.METRFWDT,
                hw.HANTYPE,
                hw.HANCTYPE,
                hw.HANFW,

                t1.CG_PURCHASEDATE

            FROM batch_meters bm

            JOIN CENTRALSERVICES.MV_EDE_EXTRACT ede
                ON ede.METERNO = bm.meterno

            JOIN asset_data t1
                ON ede.METERNO = t1.meterno

            JOIN hw
                ON hw.assetnum = t1.assetnum

            WHERE ede.HARDWARE_MODEL NOT IN (
                'NORESOURCEKEY'
            )
        """)

        try:
            batch_result = pd.read_sql_query(
                query,
                sql_connection,
                params={
                    "last_meter": last_meter,
                    "batch_size": BATCH_SIZE
                }
            )

        except Exception as error:
            print("\n" + "!" * 70)
            print(f"Batch {batch_number:,} failed.")
            print(f"Starting marker: {last_meter}")
            print(f"Selected first meter: {batch_first_meter}")
            print(f"Selected last meter:  {batch_last_meter}")
            print("!" * 70)

            # Stop instead of skipping a failed batch
            raise error

        # Normalize result column names
        batch_result.columns = (
            batch_result.columns
            .str.strip()
            .str.lower()
        )

        batch_result["query_batch_number"] = batch_number

        all_results.append(batch_result)

        # ------------------------------------------------------------
        # STEP 3: Update progress
        # ------------------------------------------------------------

        total_selected_meters += meters_in_batch
        total_returned_rows += len(batch_result)

        batch_elapsed = (
            time.perf_counter() - batch_start_time
        )

        batch_times.append(batch_elapsed)

        average_batch_seconds = (
            sum(batch_times) / len(batch_times)
        )

        print("\nBatch finished successfully.")
        print(f"Batch number: {batch_number:,}")
        print(f"Meters selected this batch: {meters_in_batch:,}")
        print(f"Rows returned this batch: {len(batch_result):,}")
        print(
            f"Total meters selected so far: "
            f"{total_selected_meters:,}"
        )
        print(
            f"Total rows returned so far: "
            f"{total_returned_rows:,}"
        )
        print(
            f"Batch runtime: "
            f"{batch_elapsed / 60:,.2f} minutes"
        )
        print(
            f"Average batch runtime: "
            f"{average_batch_seconds / 60:,.2f} minutes"
        )

        # Critical:
        # Advance using Oracle's selected meter list,
        # not the query result, because joins can remove meters.
        last_meter = batch_last_meter

        print(f"Next batch starts after meter: {last_meter}")


if all_results:

    hw_assets = pd.concat(
        all_results,
        ignore_index=True
    )

else:

    hw_assets = pd.DataFrame()


overall_elapsed = (
    time.perf_counter() - overall_start
)

completed_batches = len(batch_times)

print("\n" + "=" * 70)
print("ORACLE HARDWARE QUERY COMPLETE")
print("=" * 70)

print(f"Completed batches: {completed_batches:,}")
print(f"Total meters selected: {total_selected_meters:,}")
print(f"Total rows returned: {len(hw_assets):,}")

print(
    f"Total runtime: "
    f"{overall_elapsed / 60:,.2f} minutes"
)

print(
    f"Total runtime: "
    f"{overall_elapsed / 3600:,.2f} hours"
)

print(f"Final dataframe: hw_assets")
print(f"Final shape: {hw_assets.shape}")



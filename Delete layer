import os
import tempfile
import webbrowser
import folium

def open_temp_map(m):
    temp_dir = tempfile.gettempdir()
    fp = os.path.join(temp_dir, "map.html")
    m.save(fp)
    webbrowser.open(fp)

# Create the map
m = folium.Map(
    location=[33.91, -98.49],
    zoom_start=12,
    tiles="OpenStreetMap"
)

# Open using Erik's function
open_temp_map(m)

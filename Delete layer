-- ======================================================================
-- 10. BEHAVIOR PROFILE DATASET -- the behavior tab's data (DAY GRAIN)
--
--    Everything is per tech per DAY, because that is the grain behavior
--    is actually assigned at. A week that was Focused three days and
--    Fragmented two no longer gets flattened into one label, so each
--    day's metrics sit with the behavior that day really had.
--
--    All rates are per-day. Compare them across behaviors directly:
--    a Focused day vs a Fragmented day, no week-length effects.
-- ======================================================================

-- 10a. day-level opportunity -- de-duplicated within the day, so a meter
--      passed on six stops counts once
create or replace table day_opportunity as
select
    s.workedby,
    s.work_date,
    count(distinct u.meterno) as s4e_opportunities
from work_sequence s
cross join opp_params p
join s4e_universe u
  on floor(u.latitude  / p.grid_deg)::bigint
     between floor(s.latitude  / p.grid_deg)::bigint - 1
         and floor(s.latitude  / p.grid_deg)::bigint + 1
 and floor(u.longitude / p.grid_deg)::bigint
     between floor(s.longitude / p.grid_deg)::bigint - 1
         and floor(s.longitude / p.grid_deg)::bigint + 1
 and miles_between(s.latitude, s.longitude, u.latitude, u.longitude) <= p.vicinity_mi
 and (u.removed_date is null or u.removed_date >= s.work_date)
group by s.workedby, s.work_date;


-- 10b. one row per tech per day -- the Tableau source
create or replace table tech_day_profile as
select
    b.workedby,
    b.work_date,
    b.work_week,
    b.behavior,
    b.density_band,

    -- volume that day
    m.work_orders,
    m.meters                                                        as meters_changed,
    m.s4e_changes,
    m.non_s4e_changes,
    m.periodic_tests,
    b.return_events                                                 as revisits,

    -- shape of the day
    m.miles_traveled                                                as miles_per_day,
    m.minutes_first_to_last                                         as minutes_per_day,
    m.avg_miles_between_orders                                      as miles_between_meters,
    m.avg_minutes_between_orders                                    as minutes_between_meters,
    m.median_minutes_between_orders                                 as median_minutes_between_meters,

    -- opportunity that day
    coalesce(o.s4e_opportunities, 0)                                as s4e_opportunities,
    greatest(coalesce(o.s4e_opportunities, 0) - m.s4e_changes, 0)   as missed_opportunities,
    round(m.s4e_changes / nullif(o.s4e_opportunities, 0), 3)        as capture_rate,
    round(100.0 * m.s4e_changes / nullif(m.meters, 0), 1)           as pct_changes_that_are_s4e,

    -- carried through so bad days can be filtered out
    b.clusters,
    b.median_meters_per_cluster,
    b.avg_miles_between_clusters,
    b.impossible_legs
from day_behavior b
join day_metrics m
  on m.workedby  = b.workedby
 and m.work_date = b.work_date
left join day_opportunity o
  on o.workedby  = b.workedby
 and o.work_date = b.work_date;


-- 10c. the summary grid: behavior x density band, all per-day averages
--      Each tech-day counts once, so a busy tech doesn't dominate.
create or replace table behavior_profile as
select
    behavior,
    density_band,
    count(*)                                    as tech_days,
    count(distinct workedby)                    as techs,

    -- volume per day
    round(avg(meters_changed), 1)               as avg_meters_per_day,
    round(avg(non_s4e_changes), 1)              as avg_non_s4e_per_day,
    round(avg(s4e_changes), 1)                  as avg_s4e_per_day,
    round(avg(periodic_tests), 1)               as avg_periodic_tests_per_day,
    round(avg(missed_opportunities), 1)         as avg_missed_per_day,
    round(avg(revisits), 2)                     as avg_revisits_per_day,

    -- shape per day
    round(avg(miles_per_day), 1)                as avg_miles_per_day,
    round(avg(minutes_per_day), 1)              as avg_minutes_per_day,
    round(avg(miles_between_meters), 2)         as avg_miles_between_meters,
    round(avg(minutes_between_meters), 1)       as avg_minutes_between_meters,

    -- capture
    round(avg(capture_rate), 3)                 as avg_capture_rate,
    round(avg(pct_changes_that_are_s4e), 1)     as avg_pct_s4e_of_changes
from tech_day_profile
group by behavior, density_band
order by behavior, density_band;



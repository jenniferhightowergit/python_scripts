training_category_df = labels_df.melt(
    id_vars=["training_order_id"],
    value_vars=list(category_map.keys()),
    var_name="category",
    value_name="manual_label"
)

training_category_df["category_id"] = (
    training_category_df["category"].map(category_map)
)

training_category_df = training_category_df[[
    "training_order_id",
    "category_id",
    "manual_label"
]]

training_category_df["manual_label"] = (
    training_category_df["manual_label"]
    .fillna(0)
    .astype(int)
)

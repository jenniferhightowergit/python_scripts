
import pandas as pd
from html import escape

# Clean up the dataframe column names
hardware.columns = hardware.columns.str.upper()

def make_pivot(group_col, include_ir=False):
    rows = ["HARDWARE_MODEL"]

    if include_ir:
        rows.append("INSTR_RATED")

    pivot = hardware.pivot_table(
        index=rows,
        columns=group_col,
        values="METER_COUNT",
        aggfunc="sum",
        fill_value=0
    )

    # Keep Grand Total as the first numeric column
    pivot.insert("Grand Total", 0, pivot.sum(axis=1))

    return pivot.reset_index()


fsr = make_pivot("FSRSSR_DGROUP")
meter_tech = make_pivot("METER_TECH_DGROUP")

fsr_ir = make_pivot("FSRSSR_DGROUP", True)
meter_tech_ir = make_pivot("METER_TECH_DGROUP", True)


def format_table(df, title, subtitle):
    display = df.copy()

    # Format counts with comma separators
    number_cols = display.select_dtypes(include="number").columns

    for col in number_cols:
        display[col] = display[col].map(lambda x: f"{x:,.0f}")

    # Format headers and cells
    headers = "".join(
        f'<th style="background-color:#173B56;color:white;'
        f'padding:10px 12px;border:1px solid #DCE4EA;'
        f'text-align:{"right" if col in number_cols else "left"};">'
        f'{escape(str(col).replace("_", " ").title())}</th>'
        for col in display.columns
    )

    body = ""

    for i, row in display.iterrows():
        bg = "#FFFFFF" if i % 2 == 0 else "#F0F5F8"

        body += f'<tr style="background-color:{bg};">'

        for col in display.columns:
            align = "right" if col in number_cols else "left"

            body += (
                f'<td style="padding:8px 12px;'
                f'border-bottom:1px solid #DFE6EC;'
                f'text-align:{align};font-size:12px;">'
                f'{escape(str(row[col]))}</td>'
            )

        body += "</tr>"

    # Grand total row
    totals = df[number_cols].sum()

    body += '<tr style="background-color:#DCEAF2;font-weight:bold;">'

    for col in df.columns:
        if col == df.columns[0]:
            value = "Grand Total"
        elif col in number_cols:
            value = f"{totals[col]:,.0f}"
        else:
            value = ""

        body += (
            '<td style="padding:10px 12px;'
            'border-top:2px solid #173B56;'
            'font-size:12px;">'
            f'{escape(str(value))}</td>'
        )

    body += "</tr>"

    return f"""
    <div style="margin-top:30px;margin-bottom:32px;">
        <h2 style="color:#173B56;font-size:18px;margin-bottom:5px;">
            {escape(title)}
        </h2>
        <p style="color:#667788;font-size:12px;margin-top:0;">
            {escape(subtitle)}
        </p>
        <table cellpadding="0" cellspacing="0"
               style="border-collapse:collapse;
                      font-family:Arial,sans-serif;
                      width:100%;">
            <thead><tr>{headers}</tr></thead>
            <tbody>{body}</tbody>
        </table>
    </div>
    """



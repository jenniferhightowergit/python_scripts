m = folium.Map(
    location=[31.0, -99.0],
    zoom_start=6,
    tiles=None
)

folium.TileLayer(
    tiles=(
        "https://server.arcgisonline.com/ArcGIS/rest/services/"
        "World_Street_Map/MapServer/tile/{z}/{y}/{x}"
    ),
    attr="Tiles © Esri",
    name="Esri Street Map",
    overlay=False,
    control=True
).add_to(m)

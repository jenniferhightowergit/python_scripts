# -------------------------------------------------------------------
# 1. Style tokens - change a color or size here and it changes
#    everywhere in the email
# -------------------------------------------------------------------
NAVY   = "#173B59"   # banner, table headers, titles, KPI values
ACCENT = "#287E9A"   # banner underline
LIGHT  = "#E8EFF5"   # label column, GRAND TOTAL row
BORDER = "#D9E2EA"   # every border and divider
TEXT   = "#243746"   # body text
MUTED  = "#526477"   # labels, subtitles, captions

WIDTH = 900          # every section, table and image is exactly this wide
FONT  = "font-family:Arial,Helvetica,sans-serif;"

# Type scale (px) - only these sizes are used
SIZE_BANNER   = 22
SIZE_KPI      = 22
SIZE_SECTION  = 14
SIZE_BODY     = 12
SIZE_LABEL    = 11


# -------------------------------------------------------------------
# 2. Formatting helpers
# -------------------------------------------------------------------
def fmt_num(value):
    if pd.isna(value):
        return "&mdash;"
    return f"{float(value):,.0f}"

def fmt_pct(value):
    if pd.isna(value):
        return "&mdash;"
    return f"{float(value):,.1f}%"

def fmt_text(value):
    if pd.isna(value):
        return "&mdash;"
    return escape(str(value))


# -------------------------------------------------------------------
# 3. Building blocks - every section is made from these, so every
#    section looks the same
# -------------------------------------------------------------------
def section_header(title, subtitle=None):
    """Same title style for every section: CAPS, navy, divider above."""
    sub = (
        f'<div style="{FONT}font-size:{SIZE_BODY}px;color:{MUTED};'
        f'padding-top:4px;">{subtitle}</div>'
        if subtitle else ""
    )
    return f"""
<tr><td style="padding:28px 0 12px 0;border-top:1px solid {BORDER};">
  <div style="{FONT}font-size:{SIZE_SECTION}px;font-weight:bold;
              letter-spacing:0.5px;color:{NAVY};">{escape(title.upper())}</div>
  {sub}
</td></tr>"""


def section_body(content, bottom=28):
    return f'<tr><td style="padding:0 0 {bottom}px 0;">{content}</td></tr>'


def kpi_row(items):
    """items = [("LABEL IN CAPS", value), ...]; cards split WIDTH evenly."""
    w = WIDTH // len(items)
    cells = "".join(
        f'<td width="{w}" align="center" valign="top" '
        f'style="padding:14px 10px;border:1px solid {BORDER};'
        f'background-color:#FFFFFF;">'
        f'<div style="{FONT}font-size:{SIZE_LABEL}px;font-weight:bold;'
        f'letter-spacing:0.5px;color:{MUTED};">{label}</div>'
        f'<div style="{FONT}font-size:{SIZE_KPI}px;font-weight:bold;'
        f'color:{NAVY};padding-top:6px;">{value}</div></td>'
        for label, value in items
    )
    return (
        f'<table role="presentation" width="{WIDTH}" cellpadding="0" '
        f'cellspacing="0" border="0" style="border-collapse:collapse;'
        f'width:{WIDTH}px;"><tr>{cells}</tr></table>'
    )


def data_table(headers, rows, widths, aligns,
               shade_first_col=False, total_rows=()):
    """
    headers  : column titles
    rows     : list of lists of already-formatted (HTML-safe) strings
    widths   : px per column - must add up to WIDTH
    aligns   : "left" / "center" / "right" per column
    shade_first_col : light-blue bold label column (tracker)
    total_rows      : row positions to style as GRAND TOTAL
    """
    assert sum(widths) == WIDTH, f"column widths add to {sum(widths)}, not {WIDTH}"

    head = "".join(
        f'<th width="{w}" align="{a}" style="{FONT}font-size:{SIZE_BODY}px;'
        f'font-weight:bold;color:#FFFFFF;background-color:{NAVY};'
        f'padding:9px 10px;border:1px solid {NAVY};text-align:{a};">'
        f'{escape(str(h))}</th>'
        for h, w, a in zip(headers, widths, aligns)
    )

    body = ""
    for r, row in enumerate(rows):
        is_total = r in total_rows
        cells = ""
        for c, (val, w, a) in enumerate(zip(row, widths, aligns)):
            label_cell = shade_first_col and c == 0
            bg = LIGHT if (is_total or label_cell) else "#FFFFFF"
            weight = "bold" if (is_total or label_cell) else "normal"
            color = NAVY if (is_total or label_cell) else TEXT
            cells += (
                f'<td width="{w}" align="{a}" style="{FONT}'
                f'font-size:{SIZE_BODY}px;color:{color};font-weight:{weight};'
                f'background-color:{bg};padding:8px 10px;'
                f'border:1px solid {BORDER};text-align:{a};">{val}</td>'
            )
        body += f"<tr>{cells}</tr>"

    return (
        f'<table role="presentation" width="{WIDTH}" cellpadding="0" '
        f'cellspacing="0" border="0" style="border-collapse:collapse;'
        f'width:{WIDTH}px;">'
        f"<thead><tr>{head}</tr></thead><tbody>{body}</tbody></table>"
    )



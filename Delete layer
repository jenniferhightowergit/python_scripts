BATCH_SIZE = 10_000
last_meter = None
batch_number = 0

while True:

    batch_number += 1
    print(f"\nSelecting batch {batch_number}...")

    # 1. Select the next batch from Oracle
    with ods_alchemy_engine.connect() as sql_connection:

        batch_meters = pd.read_sql(
            meter_selection_query,
            sql_connection,
            params={
                "last_meter": last_meter,
                "batch_size": BATCH_SIZE
            }
        )

    batch_meters.columns = batch_meters.columns.str.lower()

    if batch_meters.empty:
        print("All meters completed.")
        break

    print(f"Meters selected: {len(batch_meters):,}")

    # 2. Replace the registered DuckDB view with this batch
    try:
        con.unregister("batch_meters")
    except Exception:
        pass

    con.register("batch_meters", batch_meters)

    # 3. Run weather SQL for only those meters
    weather_batch = con.execute("""
        SELECT
            w.*
        FROM weather_events w
        INNER JOIN batch_meters b
            ON TRIM(w.meterno) = TRIM(b.meterno)
    """).df()

    print(f"Weather rows returned: {len(weather_batch):,}")

    # 4. Move the bookmark forward
    last_meter = batch_meters["meterno"].iloc[-1]

    # Temporary test: stop after 2 batches
    if batch_number == 2:
        break

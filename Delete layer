def get_orders(df, tables):

    orders_df = df[
        [
            "WR_ID",
            "FA_ID",
            "WR_STATUS_UPD_DTTM",
            "COMMENTS",
            "INSTRUCTIONS"
        ]
    ].copy()

    orders_df.columns = orders_df.columns.str.lower()

    # Get orders already in the database
    existing_orders = tables.orders.select_all()
    existing_orders.columns = existing_orders.columns.str.lower()

    # Find only NEW wr_id + fa_id combinations
    new_orders = orders_df.merge(
        existing_orders[["wr_id", "fa_id"]],
        on=["wr_id", "fa_id"],
        how="left",
        indicator=True
    )

    new_orders = new_orders[
        new_orders["_merge"] == "left_only"
    ].drop(columns="_merge")

    # Convert only new orders to records
    orders_data = new_orders.to_dict(orient="records")

    if orders_data:
        tables.orders.insert(
            tables.orders.prep_insert_data(orders_data)
        )

    print(f"{len(orders_data):,} new rows successfully saved to orders table")



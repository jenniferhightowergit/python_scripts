# 6. Shared table styling

table_css = """
    border-collapse:collapse;
    width:100%;
    font-family:Arial,sans-serif;
    font-size:12px;
    color:#243746;
"""

# Apply inline styles to pandas-generated tables
def style_table(html):
    html = html.replace(
        '<table border="0" class="dataframe">',
        f'<table role="presentation" style="{table_css}">'
    )

    html = html.replace(
        "<th>",
        '<th style="background-color:#E8EFF5;'
        'color:#173B59;padding:10px 7px;'
        'border:1px solid #D5DFE8;'
        'text-align:center;">'
    )

    html = html.replace(
        "<td>",
        '<td style="padding:9px 7px;'
        'border:1px solid #D5DFE8;'
        'background-color:#FFFFFF;'
        'color:#243746;text-align:center;">'
    )

    return html

tracker_html = style_table(tracker_html)
inventory_html = style_table(inventory_html)



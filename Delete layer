import time
import keyring
import pandas as pd

from sqlalchemy import create_engine, text


# =========================================================
# SETTINGS
# =========================================================

BATCH_SIZE = 10_000
TEST_METER_LIMIT = 50_000


# =========================================================
# TRACKING VARIABLES
# =========================================================

last_meter = None

batch_number = 0
total_selected_meters = 0
total_returned_rows = 0

batch_times = []
all_results = []

overall_start = time.perf_counter()


# =========================================================
# CONNECTIONS
# =========================================================

conn_string = keyring.get_password(
    "edw_sqlalchemy",
    "connection_string"
)

edw_alchemy_engine = create_engine(
    conn_string
)

conn_string = keyring.get_password(
    "ods_sqlalchemy",
    "connection_string"
)

ods_alchemy_engine = create_engine(
    conn_string
)


# =========================================================
# STEP 1 QUERY:
# SELECT THE NEXT 10,000 METER NUMBERS
# =========================================================

meter_selection_query = text("""
    SELECT meterno

    FROM
    (
        SELECT DISTINCT
            ede.METERNO AS meterno

        FROM CENTRALSERVICES.MV_EDE_EXTRACT ede

        WHERE ede.HARDWARE_MODEL NOT IN (
            'NORESOURCEKEY'
        )

          AND (
              :last_meter IS NULL
              OR ede.METERNO > :last_meter
          )

        ORDER BY ede.METERNO
    )

    WHERE ROWNUM <= :batch_size
""")


# =========================================================
# MAIN BATCH LOOP
# =========================================================

with edw_alchemy_engine.connect() as sql_connection:

    while True:

        batch_number += 1
        batch_start_time = time.perf_counter()

        print("\n" + "=" * 70)
        print(
            f"Finding meters for batch "
            f"{batch_number:,}..."
        )
        print(
            f"Starting after meter: "
            f"{last_meter or '[beginning]'}"
        )
        print("=" * 70)


        # -------------------------------------------------
        # STEP 1:
        # ORACLE SELECTS THE NEXT BATCH OF METERS
        # -------------------------------------------------

        batch_meter_df = pd.read_sql_query(
            meter_selection_query,
            sql_connection,
            params={
                "last_meter": last_meter,
                "batch_size": BATCH_SIZE
            }
        )

        batch_meter_df.columns = (
            batch_meter_df.columns
            .str.strip()
            .str.lower()
        )


        # Oracle has reached the end
        if batch_meter_df.empty:

            print(
                "\nNo more meters were found."
            )

            break


        batch_first_meter = str(
            batch_meter_df["meterno"].iloc[0]
        )

        batch_last_meter = str(
            batch_meter_df["meterno"].iloc[-1]
        )

        meters_in_batch = len(
            batch_meter_df
        )


        print(
            f"Batch: "
            f"{batch_number:,}"
        )

        print(
            f"Meters selected: "
            f"{meters_in_batch:,}"
        )

        print(
            f"First meter: "
            f"{batch_first_meter}"
        )

        print(
            f"Last meter: "
            f"{batch_last_meter}"
        )


        # -------------------------------------------------
        # STEP 2:
        # RUN THE HARDWARE QUERY FOR THIS METER RANGE
        # -------------------------------------------------

        query = text("""
            WITH

            hw AS
            (
                SELECT DISTINCT
                    a.assetnum,

                    reg.ALNVALUE
                        AS RegisterType,

                    rev.ALNVALUE
                        AS RevisionID,

                    FORMNO.ALNVALUE
                        AS FORMNO,

                    FRMWAREV.ALNVALUE
                        AS FRMWAREV,

                    SFTWAREV.ALNVALUE
                        AS SFTWAREV,

                    METRFWVR.ALNVALUE
                        AS METRFWVR,

                    METRFWDT.ALNVALUE
                        AS METRFWDT,

                    HANTYPE.ALNVALUE
                        AS HANTYPE,

                    HANCTYPE.ALNVALUE
                        AS HANCTYPE,

                    HANFW.ALNVALUE
                        AS HANFW

                FROM MXRADS.VW_ASSETSPEC a


                /* KEEP ALL OF YOUR EXISTING HW JOINS
                   EXACTLY AS THEY CURRENTLY ARE HERE.

                   Example:

                JOIN
                (
                    SELECT
                        b.ALNVALUE,
                        b.assetnum

                    FROM MXRADS.VW_ASSETSPEC b

                    WHERE b.assetattrid = 'REGTYPE'
                ) reg

                    ON a.assetnum = reg.assetnum

                Continue with REV, FORMNO, FRMWAREV,
                SFTWAREV, METRFWVR, METRFWDT,
                HANTYPE, HANCTYPE and HANFW.
                */


                WHERE 1 = 1
            ),


            asset_data AS
            (
                SELECT DISTINCT
                    a.assetnum,
                    a.CG_PURCHASEDATE,
                    a.MANUFACTURER,

                    TRIM(
                        TO_CHAR(a.SERIALNUM)
                    )
                    ||
                    TRIM(
                        TO_CHAR(a.MANUFACTURER)
                    ) AS meterno

                FROM MXRADS.VW_ASSET a

                WHERE a.MANUFACTURER NOT IN
                (
                    'VT',
                    'VM',
                    'PR',
                    'TD',
                    'DUMMY'
                )
            )


            SELECT
                hw.*,
                d.CG_PURCHASEDATE,
                d.MANUFACTURER,
                d.meterno

            FROM hw

            JOIN asset_data d
                ON hw.assetnum = d.assetnum

            WHERE d.meterno >= :batch_first_meter
              AND d.meterno <= :batch_last_meter
        """)


        try:

            batch_result = pd.read_sql_query(
                query,
                sql_connection,
                params={
                    "batch_first_meter":
                        batch_first_meter,

                    "batch_last_meter":
                        batch_last_meter
                }
            )

        except Exception as error:

            print("\n" + "!" * 70)
            print(
                f"Batch "
                f"{batch_number:,} failed."
            )
            print(
                f"Selected first meter: "
                f"{batch_first_meter}"
            )
            print(
                f"Selected last meter: "
                f"{batch_last_meter}"
            )
            print("!" * 70)

            raise error


        # -------------------------------------------------
        # NORMALIZE RESULT COLUMNS
        # -------------------------------------------------

        batch_result.columns = (
            batch_result.columns
            .str.strip()
            .str.lower()
        )

        batch_result[
            "query_batch_number"
        ] = batch_number


        # -------------------------------------------------
        # SAVE THIS BATCH IN MEMORY
        # -------------------------------------------------

        all_results.append(
            batch_result
        )


        # -------------------------------------------------
        # STEP 3:
        # UPDATE TOTALS AND TIMING
        # -------------------------------------------------

        total_selected_meters += (
            meters_in_batch
        )

        total_returned_rows += len(
            batch_result
        )

        batch_elapsed = (
            time.perf_counter()
            - batch_start_time
        )

        batch_times.append(
            batch_elapsed
        )

        average_batch_seconds = (
            sum(batch_times)
            / len(batch_times)
        )


        print(
            "\nBatch finished successfully."
        )

        print(
            f"Batch number: "
            f"{batch_number:,}"
        )

        print(
            f"Meters selected this batch: "
            f"{meters_in_batch:,}"
        )

        print(
            f"Rows returned this batch: "
            f"{len(batch_result):,}"
        )

        print(
            f"Total meters selected so far: "
            f"{total_selected_meters:,}"
        )

        print(
            f"Total rows returned so far: "
            f"{total_returned_rows:,}"
        )

        print(
            f"Batch runtime: "
            f"{batch_elapsed / 60:,.2f} minutes"
        )

        print(
            f"Average batch runtime: "
            f"{average_batch_seconds / 60:,.2f} minutes"
        )


        # -------------------------------------------------
        # MOVE TO THE NEXT BATCH
        # -------------------------------------------------

        last_meter = batch_last_meter

        print(
            f"Next batch starts after meter: "
            f"{last_meter}"
        )


        # -------------------------------------------------
        # STOP AFTER 50,000 SELECTED METERS
        # -------------------------------------------------

        if (
            total_selected_meters
            >= TEST_METER_LIMIT
        ):

            print(
                "\n"
                f"Test limit reached: "
                f"{total_selected_meters:,} "
                "meters selected."
            )

            break


# =========================================================
# COMBINE ALL FIVE TEST BATCHES
# THIS RUNS ONLY AFTER THE WHILE LOOP FINISHES
# =========================================================

non_empty_results = [
    result
    for result in all_results
    if result is not None
    and not result.empty
]


if non_empty_results:

    hw_assets = pd.concat(
        non_empty_results,
        ignore_index=True
    )

else:

    raise RuntimeError(
        "The test selected meters, but every "
        "hardware batch returned zero rows."
    )


# =========================================================
# FINAL TEST SUMMARY
# =========================================================

overall_elapsed = (
    time.perf_counter()
    - overall_start
)

completed_batches = len(
    batch_times
)


print("\n" + "=" * 70)
print("ORACLE HARDWARE TEST COMPLETE")
print("=" * 70)

print(
    f"Completed batches: "
    f"{completed_batches:,}"
)

print(
    f"Total meters selected: "
    f"{total_selected_meters:,}"
)

print(
    f"Total rows returned: "
    f"{len(hw_assets):,}"
)

print(
    f"Unique meters returned: "
    f"{hw_assets['meterno'].nunique():,}"
)

print(
    f"Total runtime: "
    f"{overall_elapsed / 60:,.2f} minutes"
)

print(
    f"Final shape: "
    f"{hw_assets.shape}"
)


hw_assets.head()

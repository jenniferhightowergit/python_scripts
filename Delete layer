

-- ======================================================================
-- 13. DISTRICT SCORECARD -- the four headline numbers, per district
--
--    Reads the last week of s4e_burndown, so it always reflects the
--    latest data with no extra date logic. Pace is the trailing 8-week
--    average, converted to months at 4.33 weeks per month.
-- ======================================================================
create or replace table district_scorecard as
select
    dgroup,
    work_week                                                     as as_of_week,
    total_s4e,
    changed_cumulative                                            as changed_ytd,
    remaining_active                                              as remaining,
    pct_complete,
    avg_per_week_8wk                                              as avg_changed_per_week,
    round(avg_per_week_8wk * 4.33, 1)                             as avg_changed_per_month,
    round(remaining_active / nullif(avg_per_week_8wk * 4.33, 0), 1)
                                                                  as months_to_zero_at_pace
from s4e_burndown
qualify row_number() over (partition by dgroup order by work_week desc) = 1
order by months_to_zero_at_pace desc;


-- 13b. one row for the whole program, for the top-of-dashboard numbers
create or replace table program_scorecard as
select
    sum(total_s4e)                                                as total_s4e,
    sum(changed_ytd)                                              as changed_ytd,
    sum(remaining)                                                as remaining,
    round(100.0 * sum(changed_ytd) / nullif(sum(total_s4e), 0), 1) as pct_complete,
    round(sum(avg_changed_per_month), 1)                          as avg_changed_per_month,
    round(sum(remaining) / nullif(sum(avg_changed_per_month), 0), 1)
                                                                  as months_to_zero_at_pace
from district_scorecard;

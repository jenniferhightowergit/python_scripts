from reportlab.pdfgen import canvas
from reportlab.lib.pagesizes import letter
from reportlab.lib.colors import HexColor
from pathlib import Path

PDF_OUTPUT = Path("project_ranger_report.pdf")

# Page dimensions - portrait letter
PAGE_WIDTH, PAGE_HEIGHT = letter

# Layout settings
MARGIN = 30
CONTENT_WIDTH = PAGE_WIDTH - (2 * MARGIN)

# Colors - matching existing HTML report
NAVY = HexColor("#173B59")
ACCENT = HexColor("#287E9A")
LIGHT = HexColor("#E8EFF5")
BORDER = HexColor("#D9E2EA")
TEXT = HexColor("#243746")
MUTED = HexColor("#526477")
WHITE = HexColor("#FFFFFF")


def create_project_ranger_pdf(
    output_path=PDF_OUTPUT,
):
    c = canvas.Canvas(
        str(output_path),
        pagesize=letter
    )

    c.setTitle("Project Ranger - S4E Removal Progress")

    # --------------------------------------------------------
    # HEADER
    # --------------------------------------------------------
    header_height = 62
    header_y = PAGE_HEIGHT - MARGIN - header_height

    c.setFillColor(NAVY)
    c.rect(
        MARGIN,
        header_y,
        CONTENT_WIDTH,
        header_height,
        fill=1,
        stroke=0
    )

    c.setFillColor(ACCENT)
    c.rect(
        MARGIN,
        header_y,
        CONTENT_WIDTH,
        4,
        fill=1,
        stroke=0
    )

    c.setFillColor(WHITE)
    c.setFont("Helvetica-Bold", 17)
    c.drawString(
        MARGIN + 14,
        header_y + 36,
        "PROJECT RANGER"
    )

    c.setFont("Helvetica", 9)
    c.drawString(
        MARGIN + 14,
        header_y + 22,
        "S4E Meter Removal Progress"
    )

    c.setFont("Helvetica", 8)
    c.drawString(
        MARGIN + 14,
        header_y + 9,
        f"Updated through {report_date}"
    )

    # --------------------------------------------------------
    # KPI CARDS
    # --------------------------------------------------------
    kpis = [
        ("TOTAL S4Es", f"{total_s4e:,.0f}"),
        ("TOTAL REMOVED", f"{total_removed:,.0f}"),
        ("TOTAL REMAINING", f"{total_remaining:,.0f}"),
        ("% COMPLETE", f"{total_pct_complete * 100:.1f}%"),
    ]

    gap = 7
    card_width = (CONTENT_WIDTH - 3 * gap) / 4
    card_height = 53
    card_y = header_y - 12 - card_height

    for i, (label, value) in enumerate(kpis):
        x = MARGIN + i * (card_width + gap)

        c.setFillColor(WHITE)
        c.setStrokeColor(BORDER)
        c.rect(
            x, card_y,
            card_width, card_height,
            fill=1, stroke=1
        )

        c.setFillColor(MUTED)
        c.setFont("Helvetica-Bold", 7)
        c.drawCentredString(
            x + card_width / 2,
            card_y + 35,
            label
        )

        c.setFillColor(NAVY)
        c.setFont("Helvetica-Bold", 15)
        c.drawCentredString(
            x + card_width / 2,
            card_y + 13,
            value
        )

    # Temporary ending - later sections go above this
    c.showPage()
    c.save()

    return output_path



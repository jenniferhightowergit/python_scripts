import pandas as pd
import numpy as np

df = sept_wr_sample.copy()

df["arrive_datetime"] = pd.to_datetime(
    df["arrive_datetime"], errors="coerce"
)

df["latitude"] = pd.to_numeric(
    df["latitude"], errors="coerce"
)

df["longitude"] = pd.to_numeric(
    df["longitude"], errors="coerce"
)

# Use arrival date to define the workday
df["work_date"] = df["arrive_datetime"].dt.date

# Remove records without usable locations or timestamps
df = df.dropna(
    subset=[
        "emp_num",
        "arrive_datetime",
        "latitude",
        "longitude"
    ]
).copy()

df = df[
    df["latitude"].between(-90, 90)
    & df["longitude"].between(-180, 180)
].copy()

# Sort each technician's stops chronologically
df = df.sort_values(
    ["emp_num", "work_date", "arrive_datetime", "cdb_wr_no"]
).reset_index(drop=True)





def haversine_miles(lat1, lon1, lat2, lon2):
    R = 3958.7613

    lat1, lon1, lat2, lon2 = map(
        np.radians, [lat1, lon1, lat2, lon2]
    )

    dlat = lat2 - lat1
    dlon = lon2 - lon1

    a = (
        np.sin(dlat / 2) ** 2
        + np.cos(lat1)
        * np.cos(lat2)
        * np.sin(dlon / 2) ** 2
    )

    return 2 * R * np.arcsin(
        np.sqrt(np.clip(a, 0, 1))
    )




def flag_backtracking(group, radius=1.0):

    group = group.sort_values(
        ["arrive_datetime", "cdb_wr_no"]
    ).copy()

    group["backtrack_flag"] = 0
    group["returned_to_wr"] = pd.NA
    group["return_distance_miles"] = np.nan
    group["return_gap_minutes"] = np.nan

    idx = group.index.to_list()

    for j in range(2, len(idx)):

        current = group.loc[idx[j]]

        # Check earlier stops, most recent first
        for i in range(j - 2, -1, -1):

            original = group.loc[idx[i]]

            distance = haversine_miles(
                original["latitude"],
                original["longitude"],
                current["latitude"],
                current["longitude"]
            )

            # Current stop must be near an earlier stop
            if distance > radius:
                continue

            # Must have left the original radius in between
            intermediate = group.loc[idx[i+1:j]]

            left_area = any(
                haversine_miles(
                    original["latitude"],
                    original["longitude"],
                    row["latitude"],
                    row["longitude"]
                ) > radius
                for _, row in intermediate.iterrows()
            )

            if left_area:

                group.at[idx[j], "backtrack_flag"] = 1

                group.at[idx[j], "returned_to_wr"] = (
                    original["cdb_wr_no"]
                )

                group.at[idx[j], "return_distance_miles"] = (
                    round(float(distance), 3)
                )

                group.at[idx[j], "return_gap_minutes"] = (
                    (
                        current["arrive_datetime"]
                        - original["arrive_datetime"]
                    ).total_seconds() / 60
                )

                break

    return group






results = []

for (tech, day), group in df.groupby(
    ["emp_num", "work_date"],
    sort=False
):
    results.append(
        flag_backtracking(group, radius=1.0)
    )

df_backtracking = pd.concat(
    results, ignore_index=True
) if results else df.copy()




ops_backtracking = (
    df_backtracking
    .groupby("serv_center_c")
    .agg(
        total_stops=("cdb_wr_no", "count"),
        backtrack_stops=("backtrack_flag", "sum"),
        technicians=("emp_num", "nunique")
    )
    .reset_index()
)

ops_backtracking["backtrack_rate"] = (
    ops_backtracking["backtrack_stops"]
    / ops_backtracking["total_stops"]
    * 100
)

ops_backtracking.sort_values(
    "backtrack_rate", ascending=False
)


"""fast_oracle.py — shared helpers for fast Oracle -> parquet loads.

Usage:
    from fast_oracle import make_engine, fetch_arrow, write_parquet_atomic
    engine = make_engine("edw_sqlalchemy")
    tbl = fetch_arrow(engine, "SELECT ...")
    write_parquet_atomic(tbl, r"C:\\...\\MyTable.parquet")
"""
import os
import time

import keyring
import pandas as pd
import pyarrow as pa
import pyarrow.parquet as pq
from sqlalchemy import create_engine, text
from sqlalchemy.engine import make_url

FETCH_SIZE = 50_000  # rows per network round trip (driver default is ~100)


def make_engine(keyring_service, keyring_user="connection_string", fetch_size=FETCH_SIZE):
    """Engine from a keyring connection string, switched to python-oracledb with big fetch batches."""
    conn_string = keyring.get_password(keyring_service, keyring_user)
    if not conn_string:
        raise RuntimeError(f"Connection string not found in keyring ({keyring_service}).")
    url = make_url(conn_string)
    if url.get_backend_name() == "oracle":
        url = url.set(drivername="oracle+oracledb")
        return create_engine(url, arraysize=fetch_size)
    return create_engine(url)


def fetch_arrow(engine, sql, params=None, lowercase=True, fetch_size=FETCH_SIZE) -> pa.Table:
    """Run a query and return a pyarrow Table.
    Uses python-oracledb 3.0+ fetch_df_all (no per-value Python objects); falls back to pandas.
    lowercase=True matches the lowercase column names pd.read_sql gave your existing files."""
    raw = engine.raw_connection()
    try:
        conn = getattr(raw, "driver_connection", None)
        if conn is not None and hasattr(conn, "fetch_df_all"):
            odf = conn.fetch_df_all(statement=sql, parameters=params, arraysize=fetch_size)
            tbl = pa.Table.from_arrays(odf.column_arrays(), names=odf.column_names())
            return tbl.rename_columns([n.lower() for n in tbl.column_names]) if lowercase else tbl
    finally:
        raw.close()
    with engine.connect() as c:
        df = pd.read_sql(text(sql), c, params=params)
    if lowercase:
        df.columns = [c.lower() for c in df.columns]
    return pa.Table.from_pandas(df, preserve_index=False)


def write_parquet_atomic(table: pa.Table, path, compression="snappy"):
    """Write to a temp file, then swap it in, so readers never see a half-written file."""
    tmp = str(path) + ".tmp"
    pq.write_table(table, tmp, compression=compression)
    os.replace(tmp, path)


def upsert_keep_history(new_tbl: pa.Table, path, key="assetnum") -> pa.Table:
    """Merge a fresh pull with the existing parquet, never deleting:
       - keys in new_tbl  -> new_tbl's version wins (updates + new rows)
       - keys only in the old file -> carried forward as last seen
    Old columns the query no longer returns are dropped; new columns are null for carried rows."""
    import pyarrow.compute as pc
    from pathlib import Path

    path = Path(path)
    if not path.exists():
        return new_tbl
    old_cols = set(pq.read_schema(path).names)
    if key not in old_cols:
        raise ValueError(f"Key column '{key}' not found in existing file {path.name}")
    old = pq.read_table(path, columns=[c for c in new_tbl.column_names if c in old_cols])

    gone = old.filter(pc.invert(pc.is_in(old[key], value_set=new_tbl[key])))
    print(f"Carrying forward {gone.num_rows:,} rows whose {key} is no longer in the source")
    if gone.num_rows == 0:
        return new_tbl

    arrays = [gone[f.name].cast(f.type) if f.name in gone.column_names
              else pa.nulls(gone.num_rows, f.type) for f in new_tbl.schema]
    return pa.concat_tables([new_tbl, pa.Table.from_arrays(arrays, schema=new_tbl.schema)])


class Timer:
    """t = Timer(); ...; t.log("Fetched")  ->  'Fetched: 12.3s'"""
    def __init__(self):
        self.t0 = time.perf_counter()

    def log(self, msg):
        print(f"{msg}: {time.perf_counter() - self.t0:,.1f}s")

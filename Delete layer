"""
Send a pandas DataFrame as a styled HTML table via Outlook — no SMTP/ports/passwords needed.
Requires Outlook desktop app to be installed and logged in (Windows only).

Install once:
    pip install pywin32

Usage:
    python send_df_outlook.py
"""

import pandas as pd
import win32com.client as win32


def df_to_html(df: pd.DataFrame, title: str = "Report") -> str:
    header_cells = "".join(
        f'<th style="padding:10px 14px; background-color:#2c3e50; color:#ffffff; '
        f'text-align:left; font-family:Arial, sans-serif; font-size:13px;">{col}</th>'
        for col in df.columns
    )

    rows_html = ""
    for i, row in df.iterrows():
        bg = "#f9f9f9" if i % 2 == 0 else "#ffffff"
        cells = "".join(
            f'<td style="padding:8px 14px; border-bottom:1px solid #e0e0e0; '
            f'font-family:Arial, sans-serif; font-size:13px; color:#333;">{val}</td>'
            for val in row
        )
        rows_html += f'<tr style="background-color:{bg};">{cells}</tr>'

    html = f"""
    <div style="max-width:700px; font-family:Arial, sans-serif;">
        <h2 style="color:#2c3e50;">{title}</h2>
        <table style="border-collapse:collapse; width:100%;">
            <thead><tr>{header_cells}</tr></thead>
            <tbody>{rows_html}</tbody>
        </table>
    </div>
    """
    return html


def send_via_outlook(df: pd.DataFrame, to: str, subject: str, title: str = "Report", send_now: bool = False):
    outlook = win32.Dispatch("Outlook.Application")
    mail = outlook.CreateItem(0)  # 0 = MailItem
    mail.To = to
    mail.Subject = subject
    mail.HTMLBody = df_to_html(df, title=title)

    if send_now:
        mail.Send()
        print("Email sent.")
    else:
        mail.Display()  # opens the email as a draft so you can review before sending
        print("Draft opened in Outlook — review and hit send.")


if __name__ == "__main__":
    # Example DataFrame — replace with your real one
    df = pd.DataFrame({
        "Meter ID": ["12345", "67890", "54321"],
        "Status": ["Communicating", "Non-Communicating", "Communicating"],
        "Last Read": ["2026-08-05", "2026-08-01", "2026-08-06"],
    })

    send_via_outlook(
        df,
        to="recipient@example.com",
        subject="Meter Status Report",
        title="Meter Status Report",
        send_now=False,  # set True to send immediately instead of opening a draft
    )

"""
S4e event counts: how often each event type fired over the last N days
for RF Enhanced S4e meters (optionally limited to ALL TOWN meters).

Run it from a terminal, not the notebook, so it can't tie up your kernel:
    start "" /low python s4e_event_counts.py

You can safely run it again. Days that already finished are skipped, so if it
dies at day 37 you just rerun it. Tomorrow's run only pulls one new day.
"""
import time

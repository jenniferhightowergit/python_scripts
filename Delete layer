# Extract unique categories
category_df = (
    df[["CATEGORY"]]
    .dropna()
    .drop_duplicates()
    .rename(columns={"CATEGORY": "code"})
    .reset_index(drop=True)
)

# Use category code as display name for now
category_df["name"] = category_df["code"]

# Match database columns
category_df = category_df[["code", "name"]]

display(category_df)

existing = tables.select("""
    SELECT code FROM category
""")

category_df = category_df[
    ~category_df["code"].isin(existing["code"])
]

if not category_df.empty:
    tables.category.insert(category_df)


training_orders_df = df.rename(columns={
    "WR_ID": "wr_id",
    "FA_ID": "fa_id",
    "WR_STATUS_UPD_DTTM": "wr_status_upd_dttm",
    "COMMENTS": "comments",
    "INSTRUCTIONS": "instructions"
}).copy()

# Select database columns
training_orders_df = training_orders_df[
    [
        "wr_id",
        "fa_id",
        "wr_status_upd_dttm",
        "comments",
        "instructions"
    ]
]

# Clean required fields
training_orders_df["wr_id"] = training_orders_df["wr_id"].astype("string")
training_orders_df["fa_id"] = training_orders_df["fa_id"].astype("string")

training_orders_df["wr_status_upd_dttm"] = pd.to_datetime(
    training_orders_df["wr_status_upd_dttm"],
    errors="coerce"
)

training_orders_df["comments"] = (
    training_orders_df["comments"].fillna("")
)

training_orders_df["instructions"] = (
    training_orders_df["instructions"].fillna("")
)

# Business key must be unique
training_orders_df = training_orders_df.drop_duplicates(
    subset=["wr_id", "fa_id"]
)

display(training_orders_df.head())


existing_orders = tables.select("""
    SELECT wr_id, fa_id
    FROM training_orders
""")

new_orders = training_orders_df.merge(
    existing_orders,
    on=["wr_id", "fa_id"],
    how="left",
    indicator=True
)

new_orders = new_orders[
    new_orders["_merge"] == "left_only"
].drop(columns="_merge")

if not new_orders.empty:
    tables.training_orders.insert(new_orders)

print(f"Inserted {len(new_orders):,} training orders")

# Retrieve generated IDs
category_lookup = tables.select("""
    SELECT category_id, code
    FROM category
""")

order_lookup = tables.select("""
    SELECT training_order_id, wr_id, fa_id
    FROM training_orders
""")

# Start with original Excel data
labels_df = df.rename(columns={
    "WR_ID": "wr_id",
    "FA_ID": "fa_id",
    "CATEGORY": "code"
}).copy()

labels_df["wr_id"] = labels_df["wr_id"].astype("string")
labels_df["fa_id"] = labels_df["fa_id"].astype("string")

# Match generated training_order_id
labels_df = labels_df.merge(
    order_lookup,
    on=["wr_id", "fa_id"],
    how="left",
    validate="many_to_one"
)

# Match generated category_id
labels_df = labels_df.merge(
    category_lookup,
    on="code",
    how="left",
    validate="many_to_one"
)

# Assigned category = positive label
labels_df["manual_label"] = 1

# Keep database columns
training_order_category_df = labels_df[
    [
        "training_order_id",
        "category_id",
        "manual_label"
    ]
].drop_duplicates()

# Check IDs before inserting
assert training_order_category_df[
    ["training_order_id", "category_id"]
].notna().all().all(), "Some records could not be matched to an ID."

# Check for conflicting labels on the same order/category
assert not training_order_category_df.duplicated(
    ["training_order_id", "category_id"]
).any(), "Duplicate order/category combinations found."

display(training_order_category_df.head())

existing_labels = tables.select("""
    SELECT training_order_id, category_id
    FROM training_order_category
""")

new_labels = training_order_category_df.merge(
    existing_labels,
    on=["training_order_id", "category_id"],
    how="left",
    indicator=True
)

new_labels = new_labels[
    new_labels["_merge"] == "left_only"
].drop(columns="_merge")

if not new_labels.empty:
    tables.training_order_category.insert(new_labels)

print(f"Inserted {len(new_labels):,} labels")



def merge_into_parquet(delta_df, parquet_path):
    con = duckdb.connect()
    con.register("delta_raw", delta_df)

    tmp_path  = parquet_path + ".tmp"
    safe_path = parquet_path.replace("\\", "/")
    safe_tmp  = tmp_path.replace("\\", "/")

    con.execute(
        f"CREATE OR REPLACE VIEW existing AS SELECT * FROM read_parquet('{safe_path}')"
    )



    con.execute(
        f"COPY final TO '{safe_tmp}' (FORMAT PARQUET, COMPRESSION SNAPPY)"
    )
    con.close()






# Highlight the entire GRAND TOTAL row
import re

inventory_html = re.sub(
    r"<tr>\s*(<td[^>]*>\s*GRAND TOTAL\s*</td>.*?)</tr>",
    lambda m: (
        '<tr style="background-color:#E8EFF5; font-weight:bold;">'
        + m.group(1)
        + "</tr>"
    ),
    inventory_html,
    count=1,
    flags=re.DOTALL | re.IGNORECASE
)

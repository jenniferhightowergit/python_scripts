df = for_allHardware.copy()

df["Hardware_Model"] = df["Hardware_Model"].fillna("Unknown")
df["DGROUP"] = df["DGROUP"].fillna("Unassigned")
df["INSTR_RATED"] = df["INSTR_RATED"].fillna("Unknown")

df["Meter_Count"] = pd.to_numeric(
    df["Meter_Count"],
    errors="coerce"
).fillna(0)

# Build Tableau-style pivot
hardware_pivot = pd.pivot_table(
    df,
    index=["Hardware_Model", "INSTR_RATED"],
    columns="DGROUP",
    values="Meter_Count",
    aggfunc="sum",
    fill_value=0
)

# Sort DGROUP columns
hardware_pivot = hardware_pivot.reindex(
    sorted(hardware_pivot.columns),
    axis=1
)

# Add total column
hardware_pivot["Grand Total"] = hardware_pivot.sum(axis=1)

# Add total row
total_row = hardware_pivot.sum(axis=0)

hardware_pivot.loc[
    ("Grand Total", ""),
    :
] = total_row

# Report metrics
total_meters = int(df["Meter_Count"].sum())
total_dgroups = df["DGROUP"].nunique()
total_models = df["Hardware_Model"].nunique()

# Note: total_meters sums grouped distinct counts.
# It assumes a meter is not counted in multiple groups.




-- ======================================================================
-- 12. BURN-DOWN -- cumulative changed vs S4e remaining, by week
--
--    Changed is a flow: each meter counts once, in the week it left.
--    Remaining is a stock: the population minus everything changed so
--    far. These two are safe to put on one chart; changed vs missed
--    was not, because missed re-counts the same meter every day.
--
--    The population is every S4e meter in s4e_universe: those changed
--    inside your window plus those still installed. Meters changed
--    before the window aren't in it, so this is "remaining as of the
--    window start," not all-time.
-- ======================================================================
create or replace table s4e_burndown as
with pop as (
    select
        dgroup,
        count(*)                                                  as total_s4e
    from s4e_universe
    group by dgroup
),
week_spine as (
    select distinct date_trunc('week', work_date)::date           as work_week
    from work_sequence
),
grid as (
    select p.dgroup, p.total_s4e, w.work_week
    from pop p
    cross join week_spine w
),
changed as (
    select
        dgroup,
        date_trunc('week', removed_date)::date                    as work_week,
        count(*)                                                  as changed_this_week
    from s4e_universe
    where removed_date is not null
      and removed_date < date '2900-01-01'
    group by 1, 2
)
select
    g.dgroup,
    g.work_week,
    g.total_s4e,
    coalesce(c.changed_this_week, 0)                              as changed_this_week,
    sum(coalesce(c.changed_this_week, 0))
        over (partition by g.dgroup order by g.work_week)         as changed_cumulative,
    g.total_s4e - sum(coalesce(c.changed_this_week, 0))
        over (partition by g.dgroup order by g.work_week)         as remaining_active,
    round(100.0 * sum(coalesce(c.changed_this_week, 0))
          over (partition by g.dgroup order by g.work_week)
          / nullif(g.total_s4e, 0), 2)                            as pct_complete,
    round(avg(coalesce(c.changed_this_week, 0))
          over (partition by g.dgroup order by g.work_week
                rows between 7 preceding and current row), 1)     as avg_per_week_8wk,
    round((g.total_s4e - sum(coalesce(c.changed_this_week, 0))
            over (partition by g.dgroup order by g.work_week))
          / nullif(avg(coalesce(c.changed_this_week, 0))
            over (partition by g.dgroup order by g.work_week
                  rows between 7 preceding and current row), 0), 0)
                                                                  as weeks_to_zero_at_pace
from grid g
left join changed c
       on c.dgroup = g.dgroup and c.work_week = g.work_week
order by g.dgroup, g.work_week;

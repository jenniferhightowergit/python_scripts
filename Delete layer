with actual_work as (

    select distinct
        cluster_id,
        workedby,
        work_date,
        target_meter as meterno,
        target_worked_datetime as worked_datetime

    from prep_for_mapping

    where cluster_id is not null
      and workedby is not null
      and target_worked_datetime is not null

),

work_gaps as (

    select
        *,

        lag(worked_datetime) over (
            partition by cluster_id
            order by worked_datetime
        ) as previous_worked_datetime

    from actual_work

),

cluster_time_summary as (

    select
        cluster_id,
        workedby,
        work_date,

        min(worked_datetime) as cluster_start_time,
        max(worked_datetime) as cluster_end_time,

        count(distinct meterno) as meters_worked,

        datediff(
            'second',
            min(worked_datetime),
            max(worked_datetime)
        ) / 60.0 as cluster_duration_minutes,

        avg(
            datediff(
                'second',
                previous_worked_datetime,
                worked_datetime
            ) / 60.0
        ) as avg_minutes_between_changes,

        median(
            datediff(
                'second',
                previous_worked_datetime,
                worked_datetime
            ) / 60.0
        ) as median_minutes_between_changes,

        max(
            datediff(
                'second',
                previous_worked_datetime,
                worked_datetime
            ) / 60.0
        ) as max_gap_minutes

    from work_gaps

    group by
        cluster_id,
        workedby,
        work_date
)

select *
from cluster_time_summary

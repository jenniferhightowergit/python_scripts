WHEN y.report_year = YEAR(CURRENT_DATE) + 1
THEN GREATEST(
    0,
    p.annual_goal

    -- Carry forward only COMPLETED years' variance
    + COALESCE((
        SELECT SUM(
            p.annual_goal - prev.Removed_YTD
        )
        FROM year_totals prev
        WHERE prev.REMOVAL_YEAR >= p.project_start_year
          AND prev.REMOVAL_YEAR < YEAR(CURRENT_DATE)
    ), 0)

    -- During the current year, only carry forward
    -- removals exceeding the approved annual target
    - GREATEST(
        COALESCE(curr.Removed_YTD, 0) - p.annual_goal,
        0
    )
)

dynamic_goals AS (
    SELECT
        y.report_year,

        CASE
            -- Completed years retain the original benchmark
            WHEN y.report_year < YEAR(CURRENT_DATE)
                THEN p.annual_goal

            -- Current and future years use cumulative performance
            ELSE
                GREATEST(
                    0,
                    p.annual_goal
                    +
                    (
                        p.annual_goal *
                        (y.report_year - p.project_start_year)
                        -
                        COALESCE(
                            (
                                SELECT SUM(yt.Removed_YTD)
                                FROM year_totals yt
                                WHERE yt.REMOVAL_YEAR >= p.project_start_year
                                  AND yt.REMOVAL_YEAR < y.report_year
                            ),
                            0
                        )
                    )
                )
        END AS Adjusted_Annual_Goal

    FROM years y
    CROSS JOIN params p
),

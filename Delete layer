import math
import time

BATCH_SIZE = 10_000
MAX_ATTEMPTS = 3

total_batches = math.ceil(total_meters / BATCH_SIZE)

for batch_number, start_row in enumerate(
    range(1, total_meters + 1, BATCH_SIZE),
    start=1
):
    end_row = min(
        start_row + BATCH_SIZE - 1,
        total_meters
    )

    print(
        f"\nBatch {batch_number:,} of {total_batches:,} "
        f"| rows {start_row:,}–{end_row:,}"
    )

    batch_start_time = time.time()

    for attempt in range(1, MAX_ATTEMPTS + 1):
        try:
            build_weather_batch(
                start_row=start_row,
                end_row=end_row,
                create_table=(batch_number == 1)
            )

            elapsed = time.time() - batch_start_time

            print(
                f"Completed batch {batch_number:,} "
                f"in {elapsed / 60:.2f} minutes"
            )

            break

        except Exception as error:
            print(
                f"Attempt {attempt} failed for "
                f"batch {batch_number}: {error}"
            )

            if attempt == MAX_ATTEMPTS:
                raise

            time.sleep(5)

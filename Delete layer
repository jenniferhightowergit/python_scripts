create or replace table district_scorecard as
select
    dgroup,
    work_week as as_of_week,
    total_s4e,
    changed_cumulative as changed_ytd,
    remaining_active as remaining,
    pct_complete,

    -- YTD average per week
    round(
        changed_cumulative /
        nullif(
            date_diff(
                'day',
                date_trunc('year', current_date),
                current_date
            ) / 7.0,
            0
        ),
        1
    ) as avg_changed_per_week,

    -- YTD average per month
    round(
        changed_cumulative /
        nullif(month(current_date), 0),
        1
    ) as avg_changed_per_month,

    -- months remaining at the YTD monthly pace
    round(
        remaining_active /
        nullif(
            changed_cumulative /
            nullif(month(current_date), 0),
            0
        ),
        1
    ) as months_to_zero_at_pace

from s4e_burndown

qualify row_number() over (
    partition by dgroup
    order by work_week desc
) = 1

order by months_to_zero_at_pace desc;


create or replace table program_scorecard as
select
    sum(total_s4e) as total_s4e,
    sum(changed_ytd) as changed_ytd,
    sum(remaining) as remaining,

    round(
        100.0 * sum(changed_ytd) /
        nullif(sum(total_s4e), 0),
        1
    ) as pct_complete,

    round(
        sum(changed_ytd) /
        nullif(
            date_diff(
                'day',
                date_trunc('year', current_date),
                current_date
            ) / 7.0,
            0
        ),
        1
    ) as avg_changed_per_week,

    round(
        sum(changed_ytd) /
        nullif(month(current_date), 0),
        1
    ) as avg_changed_per_month,

    round(
        sum(remaining) /
        nullif(
            sum(changed_ytd) /
            nullif(month(current_date), 0),
            0
        ),
        1
    ) as months_to_zero_at_pace

from district_scorecard;

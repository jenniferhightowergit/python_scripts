import numpy as np

ANNUAL_GOAL = 13600

df_goals = by_meter_tech_group.copy()

df_goals["Weight"] = (
    df_goals["Total_S4Es"]
    / df_goals["Total_S4Es"].sum()
)

raw_goals = df_goals["Weight"] * ANNUAL_GOAL
base_goals = np.floor(raw_goals).astype(int)

remainder = ANNUAL_GOAL - base_goals.sum()

df_goals["Annual_Goal"] = base_goals

# Allocate remaining meters by largest fraction
priority = (
    (raw_goals - base_goals)
    .sort_values(ascending=False)
    .index[:remainder]
)

df_goals.loc[priority, "Annual_Goal"] += 1

assert df_goals["Annual_Goal"].sum() == ANNUAL_GOAL
assert df_goals["Total_S4Es"].sum() == 76459

display(df_goals)




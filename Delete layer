dynamic_goals AS (
    SELECT
        y.report_year,

        CASE
            -- Completed years show actual removals
            WHEN y.report_year < YEAR(CURRENT_DATE)
                THEN COALESCE(yt.Removed_YTD, 0)

            -- Current year: prior-year rollover,
            -- or actual removals if they exceed the target
            WHEN y.report_year = YEAR(CURRENT_DATE)
                THEN GREATEST(
                    0,
                    p.annual_goal
                    +
                    (
                        p.annual_goal *
                        (y.report_year - p.project_start_year)
                        -
                        COALESCE(
                            (
                                SELECT SUM(prev.Removed_YTD)
                                FROM year_totals prev
                                WHERE prev.REMOVAL_YEAR >= p.project_start_year
                                  AND prev.REMOVAL_YEAR < y.report_year
                            ), 0
                        )
                    ),
                    COALESCE(yt.Removed_YTD, 0)
                )

            -- Next year: forecast cumulative rollover
            WHEN y.report_year = YEAR(CURRENT_DATE) + 1
                THEN GREATEST(
                    0,
                    p.annual_goal
                    +
                    (
                        p.annual_goal *
                        (YEAR(CURRENT_DATE) - p.project_start_year + 1)
                        -
                        COALESCE(
                            (
                                SELECT SUM(prev.Removed_YTD)
                                FROM year_totals prev
                                WHERE prev.REMOVAL_YEAR >= p.project_start_year
                                  AND prev.REMOVAL_YEAR <= YEAR(CURRENT_DATE)
                            ), 0
                        )
                    )
                )

            -- Later years retain approved goal
            ELSE p.annual_goal

        END AS Adjusted_Annual_Goal

    FROM years y
    CROSS JOIN params p
    LEFT JOIN year_totals yt
        ON yt.REMOVAL_YEAR = y.report_year
),

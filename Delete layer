# 1. Formatting helpers

def fmt_num(value):
    if pd.isna(value):
        return "—"
    return f"{float(value):,.0f}"

def fmt_pct(value):
    if pd.isna(value):
        return "—"
    return f"{float(value):,.1f}%"

def fmt_text(value):
    if pd.isna(value):
        return "—"
    return escape(str(value))



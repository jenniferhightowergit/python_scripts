############## ALL METERS — LG hardware assets (hw_asset.parquet) — fast full refresh
# Refresh + keep history:
#   every asset Oracle still has is re-pulled, so firmware/software revisions, STATUS and
#   DESCRIPTION stay current. Assets that disappear from Oracle are kept from the old
#   parquet as last seen (this dataset tracks historical meters too).
# Why it's fast now:
#   - VW_ASSETSPEC is read ONCE and pivoted with MAX(CASE ...), instead of 10 self-joins
#     (each one a separate pass over the spec table)
#   - fast_oracle: 50k-row fetch batches + Arrow, no pandas round trip
from pathlib import Path

import pyarrow as pa
import pyarrow.compute as pc
import pyarrow.parquet as pq

from fast_oracle import Timer, fetch_arrow, make_engine, write_parquet_atomic

OUT_PATH = Path.home() / "Documents" / "JensFakeDW" / "Staging" / "parquet" / "hw_asset.parquet"

# (output column, ASSETATTRID) — same attributes and aliases as before
SPEC_ATTRS = [
    ("registertype", "REGTYPE"),
    ("revisionid",   "REV"),
    ("formno",       "FORMNO"),
    ("frmwarev",     "FRMWAREV"),
    ("sftwarev",     "SFTWAREV"),
    ("metrfwvr",     "METRFWVR"),
    ("metrfwdt",     "METRFWDT"),
    ("hantype",      "HANTYPE"),
    ("hanctype",     "HANCTYPE"),
    ("hanfw",        "HANFWV"),   # attr id is HANFWV, column was aliased HANFW — kept as before
]

pivot_cols = ",\n        ".join(
    f"MAX(CASE WHEN s.assetattrid = '{attr}' THEN s.alnvalue END) AS {col}"
    for col, attr in SPEC_ATTRS
)
spec_select = ", ".join(f"spec.{col}" for col, _ in SPEC_ATTRS)

QUERY = f"""
WITH lg AS (
    SELECT DISTINCT
        a.assetnum,
        a.cg_purchasedate,
        a.manufacturer,
        TRIM(TO_CHAR(a.serialnum)) || TRIM(TO_CHAR(a.manufacturer)) AS meterno,
        a.initial_install_dt
    FROM mxrads.vw_asset a
    WHERE a.manufacturer IN ('LG')
),
spec AS (
    SELECT
        s.assetnum,
        {pivot_cols}
    FROM mxrads.vw_assetspec s
    WHERE s.assetnum IN (SELECT assetnum FROM lg)
    GROUP BY s.assetnum
)
SELECT DISTINCT
    spec.revisionid AS hardware_model,
    spec.assetnum,
    {spec_select},
    asset.status,
    asset.description,
    asset.cg_purchasedate,
    lg.manufacturer,
    lg.meterno,
    lg.initial_install_dt
FROM spec
JOIN mxrads.vw_asset asset ON asset.assetnum = spec.assetnum
JOIN lg                    ON lg.assetnum    = spec.assetnum
"""

def keep_history(new_tbl: pa.Table, out_path: Path) -> pa.Table:
    """Oracle wins for every asset it still has (fresh firmware/status).
    Assets that have vanished from Oracle are carried forward from the old parquet, as last seen."""
    if not out_path.exists():
        return new_tbl
    old_cols = set(pq.read_schema(out_path).names)
    old = pq.read_table(out_path, columns=[c for c in new_tbl.column_names if c in old_cols])

    gone = old.filter(pc.invert(pc.is_in(old["assetnum"], value_set=new_tbl["assetnum"])))
    print(f"Carrying forward {gone.num_rows:,} rows for assets no longer in Oracle")
    if gone.num_rows == 0:
        return new_tbl

    # line the old rows up with the new schema (adds null columns if the query gained any)
    arrays = [gone[f.name].cast(f.type) if f.name in gone.column_names
              else pa.nulls(gone.num_rows, f.type) for f in new_tbl.schema]
    gone = pa.Table.from_arrays(arrays, schema=new_tbl.schema)
    return pa.concat_tables([new_tbl, gone])


if __name__ == "__main__":
    t = Timer()
    engine = make_engine("edw_sqlalchemy")
    tbl = fetch_arrow(engine, QUERY)
    t.log(f"Fetched {tbl.num_rows:,} rows from Oracle")
    tbl = keep_history(tbl, OUT_PATH)
    write_parquet_atomic(tbl, OUT_PATH)
    t.log(f"Wrote parquet ({tbl.num_rows:,} rows)")

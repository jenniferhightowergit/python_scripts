all_results.append(batch_result)

total_selected_meters += meters_in_batch
total_returned_rows += len(batch_result)

# Move the bookmark forward only after this batch succeeds
last_meter = batch_last_meter

print("\nBatch finished successfully.")
print(f"Batch number: {batch_number:,}")
print(f"Meters selected this batch: {meters_in_batch:,}")
print(f"Rows returned this batch: {len(batch_result):,}")
print(
    f"Total meters selected so far: "
    f"{total_selected_meters:,}"
)
print(
    f"Total rows returned so far: "
    f"{total_returned_rows:,}"
)

# Stop after the first 50,000 selected meters
if total_selected_meters >= TEST_METER_LIMIT:
    print(
        f"\nTest limit reached: "
        f"{total_selected_meters:,} meters selected."
    )
    break

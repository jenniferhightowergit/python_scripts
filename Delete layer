import numpy as np, pandas as pd, folium
from folium.plugins import AntPath

df = full_s4e_pop_mapping.copy()
df["wr_workeddatetime"] = pd.to_datetime(df["wr_workeddatetime"])
df["work_date"] = df["wr_workeddatetime"].dt.date
df = df.dropna(subset=["workedby", "wr_workeddatetime", "hist_latitude", "hist_longitude"])
df["is_s4e"] = df["Harware_Model"].str.lower().str.contains("s4e", na=False)
df.groupby(["workedby", "work_date"]).size().sort_values(ascending=False).head(10)

# %% functions
OVERPASS = "https://overpass-api.de/api/interpreter"
DRIVABLE = ("motorway|trunk|primary|secondary|tertiary|unclassified|residential|living_street|"
            "motorway_link|trunk_link|primary_link|secondary_link|tertiary_link")

def _meters(a, b):
    la1, lo1, la2, lo2 = map(np.radians, (*a, *b))
    h = np.sin((la2-la1)/2)**2 + np.cos(la1)*np.cos(la2)*np.sin((lo2-lo1)/2)**2
    return 2 * 6_371_000 * np.arcsin(np.sqrt(h))

def tech_day(tech, day):
    d = df[(df["workedby"] == tech) & (df["work_date"] == pd.to_datetime(day).date())]
    d = d.sort_values("wr_workeddatetime").reset_index(drop=True)
    d["stop"] = d.index + 1
    return d

def get_road_graph(pts, pad=0.03):
    import osmnx as ox
    lats, lons = [p[0] for p in pts], [p[1] for p in pts]
    s, w, n, e = min(lats)-pad, min(lons)-pad, max(lats)+pad, max(lons)+pad
    center = ((s+n)/2, (w+e)/2)
    try:
        return ox.graph_from_point(center, dist=_meters(center, (n, e)), network_type="drive")
    except Exception as err:
        print(f"osmnx download failed ({type(err).__name__}); trying curl...")
        import subprocess, tempfile, os
        q = f'[out:xml][timeout:25];(way["highway"~"{DRIVABLE}"]({s},{w},{n},{e});>;);out body;'
        f = os.path.join(tempfile.gettempdir(), "roads.osm")
        subprocess.run(["curl", "-s", "-m", "180", "-o", f, OVERPASS,
                        "--data-urlencode", f"data={q}"], check=True)
        if "runtime error" in open(f, encoding="utf-8", errors="ignore").read(2000):
            raise RuntimeError("Overpass busy -- wait a minute and rerun")
        return ox.graph_from_xml(f)

def road_path(pts, G=None):
    import osmnx as ox, networkx as nx
    G = G if G is not None else get_road_graph(pts)
    G = ox.add_edge_travel_times(ox.add_edge_speeds(G))
    nodes = ox.distance.nearest_nodes(G, X=[p[1] for p in pts], Y=[p[0] for p in pts])
    path, meters = [pts[0]], 0.0
    for u, v, dest in zip(nodes[:-1], nodes[1:], pts[1:]):
        try:
            leg = nx.shortest_path(G, u, v, weight="travel_time")
            path += [(G.nodes[x]["y"], G.nodes[x]["x"]) for x in leg]
            meters += sum(min(d["length"] for d in G.get_edge_data(a, b).values())
                          for a, b in zip(leg[:-1], leg[1:]))
        except nx.NetworkXNoPath:
            meters += _meters(path[-1], dest)
        path.append(dest)
    return path, meters / 1609.34

def plot_day(tech, day, roads=False, G=None):
    d = tech_day(tech, day)
    if d.empty:
        print(f"No orders for {tech} on {day}"); return None
    pts = list(zip(d["hist_latitude"], d["hist_longitude"]))
    m = folium.Map(location=pts[0], zoom_start=12)
    straight_mi = sum(_meters(a, b) for a, b in zip(pts[:-1], pts[1:])) / 1609.34
    if roads and len(pts) > 1:
        path, road_mi = road_path(pts, G)
        print(f"{tech} {day}: {len(d)} orders | road ~{road_mi:.1f} mi vs straight {straight_mi:.1f} mi")
    else:
        path = pts
        print(f"{tech} {day}: {len(d)} orders | straight-line {straight_mi:.1f} mi")
    AntPath(path, color="#1f6feb", weight=4, delay=900).add_to(m)

    d["spot"] = d["hist_latitude"].round(5).astype(str) + "," + d["hist_longitude"].round(5).astype(str)
    for _, g in d.groupby("spot", sort=False):
        label = ",".join(g["stop"].astype(str))
        color = "#d7263d" if g["is_s4e"].any() else "#444"
        popup = "<br>".join(f"<b>#{r.stop}</b> {r.wr_workeddatetime:%H:%M} &middot; {r.hist_meter} "
                            f"&middot; {r.fatype} &middot; {r.Harware_Model}" for r in g.itertuples())
        folium.Marker(
            [g["hist_latitude"].iloc[0], g["hist_longitude"].iloc[0]],
            icon=folium.DivIcon(icon_size=(0, 0), icon_anchor=(0, 0),
                html=f'<div style="background:{color};color:#fff;border-radius:10px;padding:2px 6px;'
                     f'font:bold 11px sans-serif;white-space:nowrap;display:inline-block;'
                     f'transform:translate(-50%,-50%)">{label}</div>'),
            popup=folium.Popup(popup, max_width=450)).add_to(m)
    m.fit_bounds(pts)
    return m



import pandas as pd
import numpy as np

def convert_coordinate(value):
    if pd.isna(value):
        return np.nan

    # Convert to string and clean
    value = str(value).strip()

    if not value:
        return np.nan

    # Replace decimal commas
    value = value.replace(",", ".")

    # Split degrees and minutes
    parts = value.split()

    try:
        # Decimal degrees
        if len(parts) == 1:
            return float(parts[0])

        # Degrees and decimal minutes
        elif len(parts) == 2:
            degrees = float(parts[0])
            minutes = float(parts[1])

            if not 0 <= minutes < 60:
                return np.nan

            sign = -1 if degrees < 0 else 1

            return sign * (
                abs(degrees) + minutes / 60
            )

        else:
            return np.nan

    except (ValueError, TypeError):
        return np.nan



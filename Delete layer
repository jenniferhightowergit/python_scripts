cluster_time_summary as (

    select
        cluster_id,
        workedby,
        work_date,

        min(worked_datetime) as cluster_start_time,
        max(worked_datetime) as cluster_end_time,

        arg_min(latitude, worked_datetime) as cluster_start_lat,
        arg_min(longitude, worked_datetime) as cluster_start_lon,

        arg_max(latitude, worked_datetime) as cluster_end_lat,
        arg_max(longitude, worked_datetime) as cluster_end_lon,

        count(distinct meterno) as meters_worked,

        datediff(
            'second',
            min(worked_datetime),
            max(worked_datetime)
        ) / 60.0 as cluster_duration_minutes,

        avg(
            datediff(
                'second',
                previous_worked_datetime,
                worked_datetime
            ) / 60.0
        ) as avg_minutes_between_changes,

        median(
            datediff(
                'second',
                previous_worked_datetime,
                worked_datetime
            ) / 60.0
        ) as median_minutes_between_changes,

        max(
            datediff(
                'second',
                previous_worked_datetime,
                worked_datetime
            ) / 60.0
        ) as max_gap_minutes

    from work_gaps

    group by
        cluster_id,
        workedby,
        work_date
)
, cluster_sequence as (

    select
        *,

        lag(cluster_id) over (
            partition by workedby, work_date
            order by cluster_start_time
        ) as previous_cluster_id,

        lag(cluster_end_time) over (
            partition by workedby, work_date
            order by cluster_start_time
        ) as previous_cluster_end_time,

        lag(cluster_end_lat) over (
            partition by workedby, work_date
            order by cluster_start_time
        ) as previous_cluster_end_lat,

        lag(cluster_end_lon) over (
            partition by workedby, work_date
            order by cluster_start_time
        ) as previous_cluster_end_lon

    from cluster_time_summary
)

, cluster_metrics as (

    select
        *,

        case
            when previous_cluster_id is null then null

            else round(
                3959 * 2 * asin(
                    sqrt(
                        power(
                            sin(
                                radians(
                                    cluster_start_lat
                                    - previous_cluster_end_lat
                                ) / 2
                            ), 2
                        )
                        +
                        cos(radians(previous_cluster_end_lat))
                        * cos(radians(cluster_start_lat))
                        * power(
                            sin(
                                radians(
                                    cluster_start_lon
                                    - previous_cluster_end_lon
                                ) / 2
                            ), 2
                        )
                    )
                ),
                2
            )
        end as travel_miles_from_previous_cluster,

        case
            when previous_cluster_id is null then null

            else datediff(
                'minute',
                previous_cluster_end_time,
                cluster_start_time
            )
        end as minutes_since_previous_cluster

    from cluster_sequence
)

select *
from cluster_metrics

diagnostic = conn.execute("""
    SELECT
        CURRENT_DATE AS Today,
        YEAR(CURRENT_DATE) AS Current_Year,
        REMOVAL_YEAR,
        REMOVAL_MONTH,
        isRemoved,
        COUNT(DISTINCT meterno) AS Meter_Count
    FROM base
    WHERE REMOVAL_YEAR IS NOT NULL
    GROUP BY
        REMOVAL_YEAR,
        REMOVAL_MONTH,
        isRemoved
    ORDER BY
        REMOVAL_YEAR DESC,
        REMOVAL_MONTH DESC,
        isRemoved
""").df()

display(diagnostic.head(30))


check_removals = conn.execute("""
    SELECT
        REMOVAL_YEAR,
        COUNT(DISTINCT meterno) AS Removed
    FROM base
    WHERE isRemoved = 1
    GROUP BY REMOVAL_YEAR
    ORDER BY REMOVAL_YEAR
""").df()

display(check_removals)
